# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# UAT (Playwright) artifacts -- screenshots, traces, reports, saved sessions
/uat-results
/uat-report
/test-results
/playwright-report
/blob-report

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env.local
.env.*.local

# vercel
.vercel

# prisma generated
/generated

# style-dictionary generated tokens (A5 / cat 21) -- run `npm run tokens:build`.
# The source (tokens/design-tokens.json) + config are committed; the compiled
# CSS is a reproducible build artifact, not work product.
/tokens/build

# typescript
*.tsbuildinfo
next-env.d.ts

# deploy state -- local/secret artifacts (provisioning output, tokens, URLs)
.deploy-state.*.json

# migration scratch
.migrate-state.json

# Sentry CLI artifacts (auth token cache + bundler debug files)
.sentryclirc
.sentry-build-plugin/

# Working plan artifacts (not shipped in forks)
plans/

# session scratch (token thrift) -- usage log local-only.
# Handoff is docs/SESSION-HANDOFF.md: TRACKED on working branches (must survive a
# fresh remote container), never merged to main. ADR-019.
# docs/session-state.json (the DATA SOURCE render-handoff.mjs builds SESSION-HANDOFF.md
# from) follows the SAME rule: TRACKED on working branches, never merged to main, pruned
# from forks (harness-v2 V2-006; fork-prune wired in V2-506). It is NOT gitignored (it must
# survive a fresh container mid-program); a fork/checkout that lacks it gets a fresh skeleton
# regenerated by the SessionStart hook, so the status tooling keeps working.
.claude/usage-log.jsonl

# /sync-from-template scratch: the review diff for mixed files is local-only,
# and the session-start drift-check throttle stamp is machine-local.
# The version marker (.template-sync.json) is TRACKED -- it is the fork's baseline.
.template-sync-review.diff
.claude/.template-check-stamp

# Generated SBOM (run `npm run sbom` on demand / in CI)
sbom.json

# Transient agent worktrees (parallel-session isolation; never work product)
.claude/worktrees/

# session-automation Part 3: the auto-spawn request is a per-session signal the
# SessionEnd hook writes when the guard permits scheduling a successor; the agent
# consumes it to fire create_trigger. Transient, machine-local, never work product.
.claude/state/

# fumadocs generated collections (enable-docs-site, ADR-053)
/.source
