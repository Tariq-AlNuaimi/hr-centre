{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "scripts/**/*.{mjs,ts}",
    "tools/**/*.{mjs,ts}",
    "docker/**/*.mjs",
    ".claude/hooks/**/*.mjs",
    ".claude/statusline.mjs",
    "eslint-rules/**/*.mjs",
    "tests/**/*.{ts,tsx,mjs}",
    "i18n/**/*.{ts,tsx}",
    "lighthouserc.cjs",
    "types/**/*.{ts,tsx}",
    "brand.config.ts"
  ],
  "ignore": ["components/ui/**"],
  "tags": ["-public"],
  "ignoreDependencies": [
    "playwright",
    "@typescript-eslint/parser",
    "jscpd",
    "@stryker-mutator/command-runner"
  ],
  "ignoreBinaries": ["pg_dump", "psql"]
}
