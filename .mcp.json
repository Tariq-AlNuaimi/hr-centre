{
  "mcpServers": {
    "playwright": {
      "command": "sh",
      "args": [
        "-c",
        "exec npx -y @playwright/mcp@0.0.76 --isolated --browser chromium --executable-path \"$(ls -d /opt/pw-browsers/chromium-*/chrome-linux/chrome 2>/dev/null | sort -V | tail -1)\""
      ]
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"]
    },
    "shadcn": {
      "command": "npx",
      "args": ["shadcn@latest", "mcp"]
    },
    "chrome-devtools": {
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@latest", "--executablePath", "/opt/pw-browsers/chromium"]
    }
  }
}
