generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// Rihal Aptitude Assessment Platform — data model (ARCHITECTURE.md §8)
//
// Multi-tenant from day one: every domain row is scoped by `orgId` even though
// Rihal is the only tenant today — cheap now, painful to retrofit later
// (ARCHITECTURE §8). Phase 1 lays down tenancy + auth + role families; later
// phases add RoleProfile/Competency/Assessment/Result/OutcomeRecord on this base.
// ============================================================================

// -- Enums --

// The two authenticated audiences (ARCHITECTURE §8, UI-SPEC Part B):
//   HR_ADMIN       — superset: role profiles, invites, calibration, settings, audit.
//   HIRING_MANAGER — review results, compare, decide (no admin surfaces).
// Default is least-privilege (HIRING_MANAGER): a misconfigured invite/SSO can't
// silently mint an admin; an HR_ADMIN promotes in-app.
enum Role {
  HR_ADMIN
  HIRING_MANAGER
}

// The five OCEAN domains of the Five-Factor model (ARCHITECTURE §6/§12.2). The
// item bank, scoring service, and (later) role profiles all key off these.
enum Big5Domain {
  OPENNESS
  CONSCIENTIOUSNESS
  EXTRAVERSION
  AGREEABLENESS
  NEUROTICISM
}

// How an item loads onto its facet. PLUS = agreement raises the facet score;
// MINUS = reverse-keyed (the scoring service recodes 1↔5, 2↔4 before summing).
// 55 of the 120 IPIP-NEO-120 items are MINUS. Source of truth for which is the
// five-factor-e library, not this codebase (ARCHITECTURE §12.2; "adopt, don't
// transcribe").
enum ItemKey {
  PLUS
  MINUS
}

// Role-profile lifecycle (ARCHITECTURE §5, UI-SPEC D.2/D.3):
//   DRAFT → IN_REVIEW → APPROVED → ACTIVE → ARCHIVED.
// APPROVED/ACTIVE versions are IMMUTABLE — revising means cloning to a new DRAFT
// version (so historical candidate results stay interpretable). Exactly one ACTIVE
// version per lineage; activating a new version ARCHIVEs the prior ACTIVE.
enum RoleProfileStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  ACTIVE
  ARCHIVED
}

// Direction of a competency's target band vs community percentiles (ARCHITECTURE
// §5/§6). HIGH = at/above targetPercentile (e.g. Achievement-Striving for Sales);
// LOW = at/below (e.g. low Neuroticism facets for Support); MODERATE = mid/balanced.
enum BandDirection {
  HIGH
  MODERATE
  LOW
}

// Invitation lifecycle (ARCHITECTURE §8, UI-SPEC D.5). Phase 4 drives the runner
// subset (PENDING→OPENED→STARTED→COMPLETED); EXPIRED/REVOKED are set by the Phase-5
// invite UI / expiry sweep. The candidate's first valid open flips PENDING→OPENED;
// giving consent flips →STARTED; submitting flips →COMPLETED.
enum InvitationStatus {
  PENDING
  OPENED
  STARTED
  COMPLETED
  EXPIRED
  REVOKED
}

// Assessment lifecycle (ARCHITECTURE §8, UI-SPEC C.1–C.4). Created at consent
// (CONSENTED), flips to IN_PROGRESS on the first saved answer, SUBMITTED on submit.
// Responses are rejected once SUBMITTED (no post-submit edits).
enum AssessmentStatus {
  CONSENTED
  IN_PROGRESS
  SUBMITTED
}

// The human hiring decision recorded against a computed Result (ARCHITECTURE §9
// step 4, UI-SPEC D.7 §7). The tool NEVER decides — it surfaces the decomposed
// evidence and the manager records Advance/Hold/Decline. A single CURRENT decision
// lives on the Result; the full change history is the audit log (Phase-6 blueprint).
enum DecisionOutcome {
  ADVANCE
  HOLD
  DECLINE
}

// -- Tenancy --

model Organization {
  id            String  @id @default(cuid())
  name          String
  // URL-safe identifier; one tenant per slug.
  slug          String  @unique
  // Default candidate-facing language; candidates can still switch (UI-SPEC C.5).
  defaultLocale String  @default("en")

  // Soft deletion (org-level off-boarding; recycling-bin registered).
  deletedAt DateTime?
  deletedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users        User[]
  roleFamilies RoleFamily[]
  roleProfiles RoleProfile[]
  invitations  Invitation[]
  assessments  Assessment[]
  results      Result[]
  auditLogs    AuditLog[]
  outcomeRecords      OutcomeRecord[]
  profileCalibrations ProfileCalibration[]
  appSettings         AppSetting[]

  @@index([deletedAt, createdAt])
  @@map("organizations")
}

// -- Auth.js Models --

model User {
  id            String    @id @default(cuid())
  // Tenant scoping. Optional only so the very first bootstrap admin can be
  // created before its org row exists in edge cases; every app path sets it.
  orgId         String?
  org           Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)

  email         String    @unique
  emailVerified DateTime?
  name          String?
  passwordHash  String?
  image         String?
  role          Role      @default(HIRING_MANAGER)
  lastLoginAt   DateTime?

  // Stamped whenever the password changes (reset / admin change). The Auth.js
  // `jwt` callback rejects any token issued before this instant, so completing a
  // password reset revokes every pre-existing session on its next request.
  passwordChangedAt DateTime?

  // Soft deletion
  deletedAt DateTime?
  deletedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts  Account[]
  sessions  Session[]
  auditLogs AuditLog[]

  // The soft-delete extension filters `deletedAt: null` on every list/count and
  // the default list sorts by createdAt desc -- a composite (deletedAt, createdAt)
  // index serves both the filter prefix and the sort.
  @@index([deletedAt, createdAt])
  @@index([orgId])
  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// -- Role families (ARCHITECTURE §5) --
//
// The top-level taxonomy (Sales/BD, PMO, Support, Legal/GRC, Leadership, …)
// under which versioned RoleProfiles are authored (added in Phase 3). Tenant-
// scoped so each org curates its own families.
model RoleFamily {
  id    String @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  // Stable machine key (e.g. "sales") + human label (e.g. "Sales / BD").
  key         String
  name        String
  description String?

  deletedAt DateTime?
  deletedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roleProfiles RoleProfile[]

  @@unique([orgId, key])
  @@index([deletedAt, createdAt])
  @@map("role_families")
}

// -- Role profiles (ARCHITECTURE §5/§12.3, UI-SPEC D.2–D.4) --
//
// A versioned, standards-anchored target competency profile for a role family.
// Authored by HR_ADMIN: create → (bounded) AI draft → human edit → approve →
// activate. Tenant-scoped (orgId). The first bounded-LLM use lands on the draft
// path (AI Role 1), but everything here works with the LLM seam unset — drafting
// is strictly additive. Soft-deletable + audited + recycling-bin registered.
model RoleProfile {
  id           String       @id @default(cuid())
  orgId        String
  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  roleFamilyId String
  // Restrict: a family in use by a profile can't be hard-deleted out from under it.
  roleFamily   RoleFamily   @relation(fields: [roleFamilyId], references: [id], onDelete: Restrict)

  // Versioning (ARCHITECTURE §5): lineageId groups versions of "the same" profile;
  // version increments per lineage. The first version of a new lineage sets
  // lineageId to its own id (done in the service on create). APPROVED/ACTIVE
  // versions never mutate — revising clones to a new DRAFT with version+1.
  lineageId String
  version   Int               @default(1)
  status    RoleProfileStatus @default(DRAFT)

  title String
  // The pasted JD the AI Role 1 draft was structured from (ARCHITECTURE §4). Org-
  // internal business text, NOT Restricted/PII. Null for hand-authored/starter rows.
  jdSourceText String?
  // True when the competency draft originated from the bounded LLM (audit + UX badge).
  isAiDrafted  Boolean @default(false)

  // Who created / approved this version (user id; plain string like deletedBy, no
  // back-relation needed). approvedAt set on the approve action (UI-SPEC D.3 step 5).
  createdById  String?
  approvedById String?
  approvedAt   DateTime?

  deletedAt DateTime?
  deletedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  competencies Competency[]
  sjtItems     SjtItem[]
  invitations  Invitation[]
  results      Result[]
  calibrations ProfileCalibration[]

  @@unique([orgId, lineageId, version])
  @@index([orgId, roleFamilyId])
  @@index([orgId, status])
  @@index([deletedAt, createdAt])
  @@map("role_profiles")
}

// A single competency within a profile version (ARCHITECTURE §5/§6). Child of an
// immutable version — edited only while the parent is a DRAFT. Audited.
model Competency {
  id            String      @id @default(cuid())
  roleProfileId String
  roleProfile   RoleProfile @relation(fields: [roleProfileId], references: [id], onDelete: Cascade)

  // SHL "Great Eight" / Universal Competency Framework vocabulary (ARCHITECTURE §2).
  name String
  // O*NET work-style reference + its importance rating — the JD→competency anchor.
  onetRef    String?
  importance Float?
  // Weight in the fit-score roll-up (ARCHITECTURE §6); validated > 0 at the boundary.
  weight     Float @default(1)
  // Target band: direction + the community-percentile threshold (1..99).
  direction        BandDirection @default(HIGH)
  targetPercentile Int           @default(50)
  // The auditable citation (O*NET ref / published study) — the evidence trail.
  sourceCitation String?
  // Display order within the profile.
  order Int @default(0)

  facets CompetencyFacet[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roleProfileId])
  @@map("competencies")
}

// Maps a competency to the IPIP-NEO facet(s) that operationalize it (ARCHITECTURE
// §5 CompetencyFacetMap). `facet` is the machine-name and MUST match an
// AssessmentItemBank.facet — enforced at the API boundary against the 30 facets.
model CompetencyFacet {
  id           String     @id @default(cuid())
  competencyId String
  competency   Competency @relation(fields: [competencyId], references: [id], onDelete: Cascade)
  facet        String

  @@unique([competencyId, facet])
  @@index([competencyId])
  @@map("competency_facets")
}

// Situational Judgement Test item for a role family (ARCHITECTURE §5, UI-SPEC C.3).
// Child of a profile version. `scoringKey` is the keyed best/worst response and is
// MASKED from non-admins at the API boundary (UI-SPEC D.4) — never sent to a
// HIRING_MANAGER or a candidate. Audited.
model SjtItem {
  id            String      @id @default(cuid())
  roleProfileId String
  roleProfile   RoleProfile @relation(fields: [roleProfileId], references: [id], onDelete: Cascade)

  scenario_en String
  scenario_ar String?
  // Response options: [{ id, text_en, text_ar }] — shape validated by zod at the
  // boundary; rendered by the candidate runner (Phase 4).
  options    Json
  // Keyed best/worst response(s). Masked from non-admins server-side (UI-SPEC D.4).
  scoringKey Json
  order      Int  @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sjtResponses SjtResponse[]

  @@index([roleProfileId])
  @@map("sjt_items")
}

// -- Assessment item bank (ARCHITECTURE §12.2, UI-SPEC C.2) --
//
// The IPIP-NEO-120 instrument: 120 public-domain items = 5 OCEAN domains × 6
// facets × 4 items. Loaded from the five-factor-e library + its questions.json
// (see prisma/data/ipip-neo-120.ts, regenerated by services/scoring/scripts/
// gen_items.py). UI-SPEC C.2 mandates the candidate questionnaire render from
// the DB, never from hardcoded strings -- this table is that source.
//
// DELIBERATELY GLOBAL (no orgId), unlike the org-scoped domain rows above. The
// instrument is a fixed, canonical, public-domain artifact shared by every
// tenant; per-org copies would mean re-translating 120 items per org and risk
// the same candidate seeing a different instrument depending on tenant. The
// AR translation (`text_ar`) is editable in place; if a future tenant needs a
// divergent wording, that becomes a per-org override table (a /scale-up), not a
// reason to fan the canonical bank out by org now.
//
// `itemNumber` is the library's question id (1..120) -- the scoring service maps
// a candidate's answers back to facets/domains by this number, so it is the join
// key between a stored response and the deterministic scorer. Audited (outside
// the EXCLUDE set) so translation edits are attributable; not soft-deletable
// (the instrument is fixed, not recycled).
model AssessmentItemBank {
  id String @id @default(cuid())

  // Canonical IPIP-NEO-120 item id (1..120). The scoring engine's `id_question`.
  itemNumber Int    @unique
  // Stable human/reference code, e.g. "IPIP120-001".
  itemCode   String @unique

  domain      Big5Domain
  // Facet machine-name from the five-factor-e model (e.g. "anxiety",
  // "friendliness") -- the library's own label, adopted not invented.
  facet       String
  // 1..6 within the domain (the facet's ordinal).
  facetNumber Int
  // PLUS or reverse-keyed MINUS (see ItemKey).
  keyed       ItemKey

  // English is seeded (public domain). Arabic is editable by HR_ADMIN; null
  // until translated, so the candidate UI can fall back to EN (UI-SPEC C.5).
  text_en String
  text_ar String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Candidate-facing render order + admin grouping both key off domain/facet.
  @@index([domain, facetNumber])
  @@map("assessment_item_bank")
}

// -- Audit (PDPL / ISO audit trail, ARCHITECTURE §8/§11) --

// The computed, decomposed result of a SUBMITTED assessment (ARCHITECTURE §6/§8,
// UI-SPEC D.7 — the product's signature "evidence trail"). Confidential: it holds
// the candidate's behavioral profile (SECURITY.md §1). Computed lazily on first
// manager view and PERSISTED (one row per assessment), so it isn't recomputed per
// page load (Phase-6 blueprint, Speed pillar). No new Restricted *field* (the raw
// SJT scoringKey never lands here — only derived sub-scores), so SCRUB_FIELDS is
// unchanged. Audited (create/decision) + soft-deletable (PDPL erasure of a sitting
// cascades here via the Assessment).
model Result {
  id           String     @id @default(cuid())
  orgId        String
  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  // One result per sitting. Cascade: permanently deleting the assessment (PDPL
  // erasure) removes its result too.
  assessmentId String     @unique
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  // The profile + the EXACT version assessed against, snapshotted so the result
  // stays interpretable after the profile versions on (ARCHITECTURE §5). Restrict:
  // a profile with computed results can't be hard-deleted out from under them.
  roleProfileId      String
  roleProfile        RoleProfile @relation(fields: [roleProfileId], references: [id], onDelete: Restrict)
  roleProfileVersion Int

  // Deterministic scoring output (ARCHITECTURE §6), stored as JSON blobs validated
  // by zod at the service boundary (lib/validations/result.ts):
  //   facetScores      30 facets: { facet, facetNumber, domain, raw, percentile, band }
  //   domainScores      5 domains: { domain, raw, percentile, band }
  //   sjtScores         per-competency SJT sub-scores (key never stored — derived only)
  //   competencyScores  per competency: { name, score 0–100, band, drivers[], citation }
  facetScores      Json
  domainScores     Json
  sjtScores        Json
  competencyScores Json

  // Two surfaced scores (ARCHITECTURE §6). Fit-to-role is primary (needs no norms);
  // community percentile is the secondary norm-referenced figure (nullable — only
  // present when the scorer returns it).
  fitScore            Int
  communityPercentile Int?

  // Provenance of the deterministic computation.
  scoringModel String   @default("IPIP-NEO-120")
  computedAt   DateTime @default(now())

  // AI Role 2 narrative (ARCHITECTURE §4) — a plain-language restatement of the
  // numbers above, cached here. Null until generated / when the LLM is unconfigured.
  // narrativeModel records WHICH model wrote it (audit/provenance).
  narrative      String?
  narrativeModel String?
  narrativeAt    DateTime?

  // The human decision (UI-SPEC D.7 §7). Single current value; history in audit_logs.
  decision     DecisionOutcome?
  decisionNote String?
  decidedById  String?
  decidedAt    DateTime?

  // Soft deletion (cascades from candidate erasure via the Assessment).
  deletedAt DateTime?
  deletedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  outcome OutcomeRecord?

  @@index([orgId])
  @@index([roleProfileId])
  @@index([deletedAt, createdAt])
  @@map("results")
}

// -- Calibration loop (ARCHITECTURE §7/§11/§12.7, UI-SPEC D.9) --
//
// The maturity loop "built from day one" (ARCHITECTURE §7). It is ADVISORY: it
// surfaces predicted-fit-vs-observed-outcome signal and SUGGESTS band changes; a
// human approves a NEW RoleProfile version — the system NEVER auto-adjusts a band.

// One post-hire outcome per computed Result (the later-attachable outcome of
// ARCHITECTURE §7). Captured manually now; later pulled from Jadawel / the Interview
// Intelligence Hub. Confidential (performance signals) but holds no Restricted secret
// → no SCRUB_FIELDS change. Soft-deletable (a mis-keyed outcome is correctable) +
// audited + recycling-bin registered.
model OutcomeRecord {
  id    String       @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  // One outcome per sitting's result. Cascade: erasing the result removes its outcome.
  resultId String @unique
  result   Result @relation(fields: [resultId], references: [id], onDelete: Cascade)

  // The observed post-hire signals (ARCHITECTURE §7). hired is the gate; the rest are
  // only meaningful once hired and accrue over time (nullable until known). Ratings
  // are validated to 1..5 at the zod boundary.
  hired           Boolean
  probationPassed Boolean?
  rating6m        Int?
  rating12m       Int?
  retained        Boolean?

  // Who recorded it (user id; plain string like Result.decidedById, no back-relation).
  recordedById String?
  recordedAt   DateTime @default(now())

  deletedAt DateTime?
  deletedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
  @@index([deletedAt, createdAt])
  @@map("outcome_records")
}

// An append-only calibration report for one RoleProfile version (ARCHITECTURE §7).
// Each manual generation writes a new row (history), so a role's calibration trail
// stays interpretable as bands evolve. `metrics` holds the full computed report
// (per-competency signal, fit summary, advisory suggestions, selection rates),
// validated by zod at the service boundary. Audited; NOT soft-deletable — regenerate
// to refresh, old reports are kept as the evidence trail. There is intentionally NO
// hard-delete route or recycling registration: rows are PERMANENT (an immutable audit
// trail); the only cleanup path is direct DB access (no admin UI). roleProfileId is
// onDelete: Restrict, so a profile with calibration history can't be hard-deleted
// until its reports are removed at the DB layer (senior-review L-1, documented).
model ProfileCalibration {
  id    String       @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  // The profile lineage member this report is about. Restrict: a profile with a
  // calibration history can't be hard-deleted out from under it.
  roleProfileId String
  roleProfile   RoleProfile @relation(fields: [roleProfileId], references: [id], onDelete: Restrict)
  version       Int

  // The full advisory report (lib/calibration.ts CalibrationReport), as JSON.
  metrics Json
  // How many outcomes the report was computed from (the honest sample size).
  sampleSize Int

  generatedById String?
  generatedAt   DateTime @default(now())

  @@index([orgId])
  @@index([roleProfileId, version])
  @@map("profile_calibrations")
}

// -- App settings (ARCHITECTURE §10/§11, ADR-031) --
//
// Per-org key/value config editable from /app/settings (HR_ADMIN). Non-secret values
// (endpoint URLs, model id, retention days, language, branding) live in `value`;
// Restricted secrets (the LLM/scoring tokens) live in `valueEncrypted` as AES-256-GCM
// ciphertext (lib/crypto.ts). The plaintext token is materialized ONLY at the outbound
// LLM/scoring call; reads return a masked "is set" flag, never the value. Audited;
// `valueEncrypted` is in SCRUB_FIELDS so the ciphertext never lands in the audit log.
// Config precedence is DB-setting-THEN-env (lib/settings.ts) — the env var stays the
// platform fallback/override.
model AppSetting {
  id    String       @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  key            String
  // Plaintext for non-secret settings; null for secret keys (which use valueEncrypted).
  value          String?
  // AES-256-GCM ciphertext for Restricted settings (the tokens); null otherwise.
  valueEncrypted String?

  updatedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, key])
  @@index([orgId])
  @@map("app_settings")
}

model AuditLog {
  id         String   @id @default(cuid())
  // Tenant scoping for the audit surface (UI-SPEC D.10). Nullable: bootstrap /
  // scheduler writes have no org context.
  orgId      String?
  org        Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)

  entityType String
  entityId   String
  action     String   // CREATE, UPDATE, DELETE, RESTORE
  before     Json?
  after      Json?
  changes    Json?
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  ipAddress  String?
  userAgent  String?
  timestamp  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId])
  @@index([orgId])
  @@index([timestamp])
  @@map("audit_logs")
}

// -- Candidate runner (ARCHITECTURE §8/§9/§12.4, UI-SPEC C.1–C.5) --
//
// The first surface that stores candidate PII. An Invitation is the token entry
// point + candidate identity; Phase 4 keeps it MINIMAL (the full invite UI /
// bulk-CSV / email send is Phase 5). `candidateEmail`/`candidateName` are
// Confidential PII (SECURITY.md §1, PDPL). Soft-deletable + recycling-bin
// registered so candidate erasure (PDPL right-to-erasure) goes through the bin;
// permanent delete cascades to the Assessment and its responses.
model Invitation {
  id    String       @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  roleProfileId String
  // Restrict: a profile with outstanding invitations can't be hard-deleted out
  // from under them (results stay interpretable against the version assessed).
  roleProfile   RoleProfile @relation(fields: [roleProfileId], references: [id], onDelete: Restrict)

  // Confidential PII (SECURITY.md §1). candidateName optional (email is the key).
  candidateEmail String
  candidateName  String?

  // Hash-at-rest of the opaque high-entropy token (SECURITY.md §1; Restricted).
  // The RAW token (32 random bytes, base64url) lives ONLY in the emailed link; we
  // store HMAC-SHA256(token, TOKEN_HMAC_KEY) and resolve a candidate by re-hashing
  // the presented token (lib/token.ts, resolveToken). Unique + indexed so the
  // lookup is a single indexed read; a DB read can't recover a usable URL token.
  tokenHash String           @unique
  status    InvitationStatus @default(PENDING)

  // Optional expiry (Phase 5 sets it on send); a past expiresAt → expired state.
  expiresAt DateTime?
  // Candidate-facing default language; the candidate can still switch (UI-SPEC C.5).
  locale    String @default("en")

  // Who sent it (user id; Phase 5 populates) + the batch it belonged to (bulk send).
  sentById String?
  batchId  String?

  // Soft deletion (candidate erasure, PDPL §11; recycling-bin registered).
  deletedAt DateTime?
  deletedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One assessment per invitation (created at consent).
  assessment Assessment?

  @@index([orgId, status])
  @@index([deletedAt, createdAt])
  @@map("invitations")
}

// One candidate sitting of an assessment (ARCHITECTURE §8). Created when consent
// is given (CONSENTED), flips to IN_PROGRESS on the first saved answer, SUBMITTED
// on submit. Holds the PDPL consent + lifecycle timestamps. Soft-deletable for
// erasure; responses cascade on permanent delete.
model Assessment {
  id    String       @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  // Exactly one assessment per invitation. Cascade: permanently deleting the
  // invitation (PDPL erasure) removes the sitting and its responses.
  invitationId String     @unique
  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  status AssessmentStatus @default(CONSENTED)
  locale String           @default("en")

  // PDPL: consent timestamp captured BEFORE any item response is accepted
  // (ARCHITECTURE §11, UI-SPEC C.1). startedAt = first answer; submittedAt = submit.
  consentAt   DateTime?
  startedAt   DateTime?
  submittedAt DateTime?

  // Soft deletion (candidate erasure, PDPL §11).
  deletedAt DateTime?
  deletedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  itemResponses ItemResponse[]
  sjtResponses  SjtResponse[]
  // One Result per assessment, computed lazily on first manager view (Phase 6).
  result        Result?

  @@index([orgId])
  @@index([deletedAt, createdAt])
  @@map("assessments")
}

// One IPIP-NEO-120 Likert answer (ARCHITECTURE §8, UI-SPEC C.2). `itemNumber`
// (1..120) joins AssessmentItemBank.itemNumber for scoring; `value` is the 1..5
// Likert response. @@unique([assessmentId, itemNumber]) makes autosave idempotent
// (a re-answer updates the same row). Hard child: cascades with the Assessment
// (not soft-deletable — it's response payload, not an independently recyclable row).
model ItemResponse {
  id           String     @id @default(cuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  itemNumber Int
  value      Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([assessmentId, itemNumber])
  @@index([assessmentId])
  @@map("item_responses")
}

// One SJT scenario answer (ARCHITECTURE §8, UI-SPEC C.3). `chosenOptionId` is the
// option id the candidate picked (from SjtItem.options); the keyed best/worst is
// NEVER sent to the client, so scoring (Phase 6) compares server-side. @@unique
// makes autosave idempotent. Hard child: cascades with the Assessment.
model SjtResponse {
  id           String     @id @default(cuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  sjtItemId String
  sjtItem   SjtItem @relation(fields: [sjtItemId], references: [id], onDelete: Cascade)

  chosenOptionId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([assessmentId, sjtItemId])
  @@index([assessmentId])
  @@map("sjt_responses")
}
