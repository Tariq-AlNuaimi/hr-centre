/// Module configuration — Interview Hub's AppSetting keys, unchanged.
model HiringSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt

  @@map("hiring_settings")
}

/// The requisition (Interview Hub `Position`). Scope key: entityId (+ departmentId).
model HiringRequisition {
  id                     String                  @id @default(cuid())
  title                  String
  entityId               String
  departmentId           String?
  description            String                  @default("")
  competencies           String[]
  hiringManagerId        String
  targetCloseDate        DateTime?
  salaryBandMin          Decimal?                @db.Decimal(12, 3)
  salaryBandMax          Decimal?                @db.Decimal(12, 3)
  salaryCurrency         String                  @default("OMR")
  grade                  String?
  status                 HiringRequisitionStatus @default(DRAFT)
  openings               Int                     @default(1)
  businessNeed           String?
  alternativesConsidered String?
  hmSeesSalary           Boolean                 @default(false)
  ownerId                String?
  departmentNeedId       String?
  departmentNeed         HiringDepartmentNeed?   @relation(fields: [departmentNeedId], references: [id], onDelete: SetNull)
  jdVersion              Int                     @default(1)
  jdStatus               HiringJdStatus          @default(DRAFT)
  jdAuthorId             String?
  jdApprovedAt           DateTime?
  jdTemplateTitle        String?

  candidates    HiringCandidate[]
  interviews    HiringInterview[]
  roundPlans    HiringRoundPlan[]
  offers        HiringOffer[]
  questions     HiringQuestion[]
  statusHistory HiringRequisitionStatusHistory[]
  approvals     HiringRequisitionApproval[]
  postings      HiringPosting[]
  jdSignoffs    HiringJdSignoff[]
  agencyInvites HiringAgencyInvite[]

  deletedAt DateTime?
  deletedBy String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([deletedAt, createdAt])
  @@index([entityId])
  @@index([departmentId])
  @@index([hiringManagerId])
  @@index([ownerId])
  @@index([grade])
  @@index([status, targetCloseDate])
  @@index([status, jdApprovedAt])
  @@index([departmentNeedId])
  @@map("hiring_requisitions")
}

model HiringPosting {
  id             String               @id @default(cuid())
  requisitionId  String
  requisition    HiringRequisition    @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  channel        HiringPostingChannel
  state          HiringPostingState   @default(LIVE)
  detail         String?
  omaniPreferred Boolean              @default(false)
  postedAt       DateTime             @default(now())
  postedById     String?
  withdrawnAt    DateTime?
  withdrawnById  String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([requisitionId, channel])
  @@index([channel, state])
  @@map("hiring_postings")
}

model HiringRequisitionStatusHistory {
  id            String                      @id @default(cuid())
  requisitionId String
  requisition   HiringRequisition           @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  fromStatus    HiringRequisitionStatus
  toStatus      HiringRequisitionStatus
  changedById   String?
  reason        String
  changedAt     DateTime                    @default(now())
  approvals     HiringRequisitionApproval[]

  @@index([requisitionId, changedAt])
  @@map("hiring_requisition_status_history")
}

/// ADR-063 (Interview Hub) — one sign-off of one step of one approval round.
model HiringRequisitionApproval {
  id            String                         @id @default(cuid())
  requisitionId String
  requisition   HiringRequisition              @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  submissionId  String
  submission    HiringRequisitionStatusHistory @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  sequence      Int
  requiredRole  HiringApprovalRole
  approverId    String
  comment       String
  createdAt     DateTime                       @default(now())

  @@unique([submissionId, sequence])
  @@index([requisitionId])
  @@map("hiring_requisition_approvals")
}

model HiringJdSignoff {
  id            String                @id @default(cuid())
  requisitionId String
  requisition   HiringRequisition     @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  version       Int
  action        HiringJdSignoffAction
  signatory     HiringJdSignatory?
  actorId       String
  actorName     String
  comment       String?
  createdAt     DateTime              @default(now())

  @@unique([requisitionId, version, signatory])
  @@index([requisitionId, createdAt])
  @@map("hiring_jd_signoffs")
}

/// The candidate. DEI fields are self-declared, scrubbed from audit, never exported.
model HiringCandidate {
  id                             String                @id @default(cuid())
  requisitionId                  String?
  requisition                    HiringRequisition?    @relation(fields: [requisitionId], references: [id])
  name                           String
  email                          String?
  phone                          String?
  nationality                    String?
  currentEmployer                String?
  linkedinUrl                    String?
  cvBlobPathname                 String?
  cvFileName                     String?
  deiGender                      String?
  deiEthnicity                   String?
  profileData                    Json?
  /// National / civil ID — encrypted under the ID-document key.
  necEnc                         String?
  /// Monthly expectation — sealed (comp-crypto).
  salaryExpectationEnc           String?
  source                         HiringCandidateSource @default(MANUAL_ENTRY)
  sourceAttribution              String?
  referredById                   String?
  packageStatus                  HiringPackageStatus   @default(NOT_REQUESTED)
  packageRequestedAt             DateTime?
  packageDeclinedAt              DateTime?
  packageDeclinedReason          String?
  packageConfirmedAt             DateTime?
  packageConfirmedById           String?
  fitScores                      Json?
  /// 0–100 (Interview Hub ADR-057); 0 = not yet scored.
  overallScore                   Float?                @default(0)
  aiRationale                    String?
  aiWhyNot                       String?
  stage                          HiringStage           @default(NEW_APPLICATION)
  rejectionReason                String?
  rejectionNotes                 String?
  rejectionNoticeSentAt          DateTime?
  rejectionHoldUntil             DateTime?
  stallCause                     HiringStallCause?
  stallNote                      String?
  stallCauseAt                   DateTime?
  stallCauseById                 String?
  stallCauseStage                HiringStage?
  preferredAt                    DateTime?
  preferredById                  String?
  preferredNote                  String?
  preferredOutstandingScorecards Int?
  agencyName                     String?
  agencyInviteId                 String?
  agencyInvite                   HiringAgencyInvite?   @relation(fields: [agencyInviteId], references: [id], onDelete: SetNull)
  agencySubmissionNote           String?
  consentAt                      DateTime?
  noticeVersion                  String?
  /// Set at offer acceptance: the PRE_JOINER core Employee (slice 8).
  employeeId                     String?
  erasedAt                       DateTime?

  documents        HiringCandidateDocument[]
  interviews       HiringInterview[]
  scorecards       HiringScorecard[]
  stageHistory     HiringStageHistory[]
  offers           HiringOffer[]
  assessment       HiringAssessment?
  negotiationNotes HiringNegotiationNote[]
  handover         HiringHandover?

  deletedAt DateTime?
  deletedBy String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([deletedAt, createdAt])
  @@index([requisitionId])
  @@index([source])
  @@index([referredById])
  @@index([email])
  @@index([requisitionId, preferredAt])
  @@index([agencyInviteId])
  @@index([stage, updatedAt])
  @@index([stage, createdAt])
  @@index([rejectionHoldUntil, rejectionNoticeSentAt])
  @@index([overallScore])
  @@index([employeeId])
  @@map("hiring_candidates")
}

model HiringStageHistory {
