generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// -- Enums --

enum Role {
  ADMIN
  EDITOR
  VIEWER
}

// -- Auth.js Models --

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  passwordHash  String?
  image         String?
  role          Role      @default(VIEWER)
  lastLoginAt   DateTime?

  // Stable directory id for SCIM correlation (ADR-045 amendment A3). Nullable +
  // unique: only SCIM-provisioned rows carry one (password/pre-existing rows stay
  // null — Postgres allows multiple NULLs under a unique index). Correlating on
  // this instead of email means a directory email-rename updates the row in place
  // rather than orphaning access with a duplicate row (US-3).
  scimExternalId String? @unique @map("scim_external_id")

  // Stamped whenever the password changes (reset / admin change). The Auth.js
  // `jwt` callback rejects any token issued before this instant, so completing a
  // password reset revokes every pre-existing session on its next request.
  passwordChangedAt DateTime?

  // Soft deletion
  deletedAt DateTime?
  deletedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts  Account[]
  sessions  Session[]
  auditLogs AuditLog[]

  // PMS (ADR-065). Optional on purpose: a User is a login identity, an Employee
  // is an org-data record, and the two populations only overlap. Most Users will
  // have an Employee; Employees without a User are normal (§4.1 Strategy team,
  // §12.1 leavers). Nothing here is required for the platform to function.
  employee      Employee?
  importBatches ImportBatch[]

  // The soft-delete extension filters `deletedAt: null` on every list/count and
  // the default list sorts by createdAt desc -- a composite (deletedAt, createdAt)
  // index serves both the filter prefix and the sort. Scaffolded soft-deletable
  // models get the same (see scripts/scaffold-entity.mjs).
  @@index([deletedAt, createdAt])
  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  // Postgres does NOT auto-index FK columns (unlike MySQL), and the unique index
  // above is keyed (provider, providerAccountId) — it cannot serve a userId-led
  // lookup. The ADR-045 SSO takeover guard runs
  // `account.findFirst({ where: { userId, provider } })` on EVERY Polis sign-in
  // (lib/auth.ts), which without this index is a sequential scan of `accounts`
  // that grows with the org. Composite so it covers both that query and a plain
  // userId lookup. (2026-07-25 review.)
  @@index([userId, provider])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// -- Audit --

model AuditLog {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  action     String // CREATE, UPDATE, DELETE, RESTORE
  before     Json?
  after      Json?
  changes    Json?
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  // Immutable actor label, denormalized at write time. The FK above is
  // `onDelete: SetNull`, so permanently deleting a User silently NULLs `userId`
  // on EVERY audit row that user ever produced — an ADMIN could erase the
  // attribution of their own history simply by deleting their account, and the
  // daily recycling-bin GC does the same thing unattended. Attribution must not
  // depend on the referenced row still existing, so it is captured here as plain
  // text and never updated afterwards. Confidential (SECURITY.md §1): it is an
  // email that deliberately OUTLIVES the user, which is the point of an audit
  // trail — a fork with erasure obligations should scrub this column on request
  // rather than rely on the cascade. (2026-07-25 review.)
  actorEmail String?
  ipAddress  String?
  userAgent  String?
  timestamp  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId])
  @@index([timestamp])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Performance Management System (PMS) — Phase 1: org foundation & import layer
//
// Implements the org-data half of the HR spec v1.0 (§1 structure, §3 org data
// & setup, §4 roles/permissions/visibility). Contract:
// docs/blueprints/performance-management-system.md. Governance: ADR-065.
//
// The later phases (cycles, KPIs, 360, scoring, calibration, bonus, reporting)
// add ~19 further models; they are specified in the blueprint so this schema
// stays forward-compatible. Nothing below assumes a cycle exists.
// ---------------------------------------------------------------------------

// PMS authority, ADDITIVE (§4.3: "a user may hold more than one; permissions
// merge — most access wins. Do not invent hybrid roles"). Held as an array on
// Employee, deliberately SEPARATE from the platform `Role` enum above, which
// keeps its own meaning (application administration) — see ADR-065.
//
// Two roles from §4.1 are intentionally NOT members:
//   * Employee     — everyone is one; membership would carry no information.
//   * Line Manager — DERIVED from Employee.managerId edges, never assigned. That
//                    is what makes §4.2's "editing/sign-off is always reserved
//                    for the direct line manager" and Appendix A's "one owner
//                    per assessment" true by construction rather than by
//                    convention: there is no field an admin could set to hand
//                    someone else's sign-off rights away.
// The Strategy team (§4.1) has NO system access at all, so it has no role here —
// HR keys their scores in on their behalf (Phase 5).
enum PmsRole {
  HR_SUPER_ADMIN // §4.1 everything + overrides; runs calibration; master export
  HRBP // §4.1 runs the cycle org-wide; everything EXCEPT master export
  EXECUTIVE_VIEWER // §4.1 COO / Ops Director: org-wide read-only, incl. salary/bonus
}

// §1.3 — every employee is tagged to exactly one track, which determines their
// scoring formula (§8.3). C_LEVEL is the exception throughout: no department
// (§1.2), no goal-setting/self-assessment/360 (§8.3), final score passed straight
// through from the entity's corporate score.
enum RoleTrack {
  C_LEVEL
  DIRECTOR
  MANAGER
  LEAD
  INDIVIDUAL
}

// §3.3 — Status. A LEAVER keeps their record and history forever (§12.1): this
// is a state, never a deletion.
enum EmployeeStatus {
  ACTIVE
  LEAVER
}

// Lifecycle of one import run. PREVIEWED is the dry-run state: the file has been
// parsed and validated and the diff is recorded, but NOTHING has been written to
// `employees` yet. Only an explicit apply moves it to APPLIED (§3.5 safety —
// see the ImportBatch comment).
enum ImportStatus {
  PREVIEWED
  APPLIED
  DISCARDED
}

// §1.2 — the group: Rihal (parent), TP, CL. Modelled as a table rather than an
// enum because departments and (Phase 5) corporate scores hang off it by FK, and
// because "the group acquires a fourth entity" must not be a schema migration.
model OrgEntity {
  id   String @id @default(cuid())
  code String @unique // RIHAL | TP | CL — stable machine key, used in imports
  name String

  departments Department[]
  employees   Employee[]

  deletedAt DateTime?
  deletedBy String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([deletedAt, createdAt])
  @@map("org_entities")
}

// §1.2 — "Departments are unique to their entity (e.g. 'Rihal Marketing',
// 'TP Sales', 'CL Sales' are distinct departments)." Hence the composite unique
// on (entityId, name): the same name MAY repeat across entities and MUST NOT
// repeat within one. Central/shared-service functions (HR, Finance, Admin, IT)
// exist only under Rihal — that is a seeding fact, not a schema constraint.
model Department {
  id       String    @id @default(cuid())
  name     String
  entityId String
  entity   OrgEntity @relation(fields: [entityId], references: [id])

  employees Employee[]

  deletedAt DateTime?
  deletedBy String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([entityId, name])
  @@index([entityId])
  @@index([deletedAt, createdAt])
  @@map("departments")
}

// The internal employee table the system owns (§3.1). Excel is one loader today
// and Odoo becomes a second in v2, both writing HERE — downstream logic never
// reads an import file. See lib/pms/import/.
model Employee {
  id String @id @default(cuid())

  // §3.2 — the Odoo employee ID is THE permanent unique key, used from day one
  // (including in the Excel). Every downstream record (KPIs, sign-offs, 360
  // assignments, scores, audit entries) attaches to it, and it must never shift
  // on re-import. Imports upsert on this column; `id` above is an internal
  // surrogate that likewise never changes once assigned.
  odooId String @unique @map("odoo_id")

  name  String
  email String @unique // §3.3 for login/notifications

  // §1.2 — an employee belongs to exactly one department, and a department to
  // exactly one entity, so entity is IMPLIED by department. C-Level are the
  // exception: tagged to an entity directly, with no department.
  //
  // `entityId` is therefore denormalized and NOT NULL for everyone: derived from
  // the department for the four non-C-Level tracks, direct for C-Level. That
  // keeps entity-scoped reads (corporate score fan-out in Phase 5, executive
  // dashboards in Phase 6) from joining through departments, and it gives the
  // C-Level case a home instead of a null-department special path everywhere.
  //
  // The XOR invariant (department XOR C-Level-with-entity) and the agreement
  // invariant (department.entityId == employee.entityId) are enforced by CHECK
  // constraint + trigger in the migration, and again in zod at the boundary —
  // a denormalized column that can drift silently is worse than the join.
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  entityId     String
  entity       OrgEntity   @relation(fields: [entityId], references: [id])

  // §3.3 — "Direct reporting line; drives sign-off, escalation, visibility, 360."
  // Self-relation. Null only for C-Level (§3.4: "blank allowed only for C-Level")
  // and transiently for the top of the tree.
  managerId String?
  manager   Employee?  @relation("EmployeeManager", fields: [managerId], references: [id])
  reports   Employee[] @relation("EmployeeManager")

  // --- Phase 2 back-relations (spec §2, §5) --------------------------------
  cyclesOpened      PerformanceCycle[] @relation("CycleOpenedBy")
  cycleParticipants CycleParticipant[] @relation("ParticipantEmployee")
  goalsApproved     CycleParticipant[] @relation("GoalsApprovedBy")
  signOffs          SignOff[]          @relation("SignOffSigner")
  changeRequested   KpiChangeRequest[] @relation("ChangeRequestRequester")
  ratingsGiven    KpiRating[]        @relation("KpiRater")
  changeDecided     KpiChangeRequest[] @relation("ChangeRequestDecider")
  complianceAbout   ComplianceEvent[]  @relation("ComplianceSubject")
  complianceAgainst ComplianceEvent[]  @relation("ComplianceManager")

  roleTrack RoleTrack // §1.3
  pmsRoles  PmsRole[] // §4.3 additive; empty for a plain employee

  // RESTRICTED (SECURITY.md §1; spec §4.5 + §11.6). Visible ONLY to HR
  // (HR_SUPER_ADMIN + HRBP) and the COO/Ops Director (EXECUTIVE_VIEWER). Line
  // managers never see it — not for their own direct reports, not in chain view.
  //
  // Enforcement is at the query layer, not the UI: lib/pms/employee-select.ts
  // builds the Prisma `select` from the actor's capabilities, so this column
  // never enters an unauthorised response payload. It is also in SCRUB_FIELDS
  // (lib/prisma/audit-extension.ts) so it never lands in audit_logs.
  //
  // Decimal, not Float: money. Phase 5 multiplies it by a band coefficient and
  // pro-rates over days (§11.3/§11.4); binary floating point has no business
  // anywhere near a payroll figure.
  /// LEGACY, pending drop — ADR-067 step 3, which is BLOCKED. Do not drop, truncate
  /// or stop populating this column: it is the ONLY recovery path for the encrypted
  /// one, because the production key lives solely in Vercel as a write-only Sensitive
  /// variable that nobody can read back. See ADR-067 "STEP 3 IS BLOCKED" before
  /// touching it. Still here because the encrypt-and-
  /// verify pass runs against the DEPLOYED database between two migrations, and
  /// `prisma migrate deploy` would otherwise drop the plaintext before anything
  /// had encrypted it. No application code reads this any more; `basicSalaryEnc`
  /// is the live column.
  basicSalary Decimal? @map("basic_salary") @db.Decimal(14, 3)

  /// Restricted (SECURITY.md §1), AES-256-GCM, bound to `odooId` — ADR-067.
  /// A `v1.<iv>.<ciphertext>.<tag>` envelope, never a number: JSON has one
  /// numeric type and it is a double, and this one is money.
  basicSalaryEnc String? @map("basic_salary_enc")

  status EmployeeStatus @default(ACTIVE) // §3.3

  // §3.3 — for leavers; used in the day-count. §11.4: a leaver pro-rates from
  // cycle start to their last working day.
  lastWorkingDay DateTime? @map("last_working_day") @db.Date

  // §3.3/§11.5 — unpaid leave reduces BOTH the pro-ration day count and the
  // effective service measured against the 6-month bonus eligibility gate.
  unpaidLeaveDays Int @default(0) @map("unpaid_leave_days")

  // Login link (ADR-065). NULLABLE and unique: the employee population is not
  // the login population — the Strategy team has no system access (§4.1),
  // leavers keep records without accounts (§12.1), and employees exist here
  // before they ever sign in. Set on first login by email match, or by HR.
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Soft delete. Note this is for erroneous records only — a departure is
  // `status = LEAVER`, never a delete (§12.1: "Record and history are preserved").
  deletedAt DateTime?
  deletedBy String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([deletedAt, createdAt])
  @@index([managerId]) // hierarchy walk (lib/pms/org-tree.ts recursive CTE)
  @@index([departmentId])
  @@index([entityId])
  @@index([status])
  @@map("employees")
}

// One import run (§3.5). Deliberately TWO-STEP: uploading parses, validates and
// records the diff as PREVIEWED without writing a single employee row; a separate
// explicit apply commits it. That is what makes §3.5's "missing rows → change
// nothing" and Appendix A's "silence is never destructive" reviewable by a human
// rather than merely asserted by code — HR sees exactly what a truncated or
// filtered export would have done BEFORE it does it.
//
// `previewJson` holds the computed diff so the apply step replays what was
// reviewed rather than re-parsing the file. The uploaded FILE is never retained:
// it carries Restricted salary data, and keeping it would create a second,
// unaudited copy outside the employees table.
model ImportBatch {
  id       String       @id @default(cuid())
  filename String
  status   ImportStatus @default(PREVIEWED)

  // Who uploaded. SetNull, like audit_logs.userId — attribution survives via
  // uploadedByEmail below rather than depending on the row still existing.
  uploadedById    String?
  uploadedBy      User?   @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  uploadedByEmail String? @map("uploaded_by_email")

  rowsTotal    Int @default(0) @map("rows_total")
  rowsCreated  Int @default(0) @map("rows_created")
  rowsUpdated  Int @default(0) @map("rows_updated")
  rowsRejected Int @default(0) @map("rows_rejected")

  // Employees present in the table but absent from the file. Recorded as a COUNT
  // for HR's awareness and explicitly NOT acted on (§3.5): absence from a file is
  // never interpreted as a departure.
  rowsAbsent Int @default(0) @map("rows_absent")

  previewJson Json?     @map("preview_json")
  appliedAt   DateTime? @map("applied_at")

  issues ImportRowIssue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([createdAt])
  @@map("import_batches")
}

// §3.4 — "A row failing any rule is rejected/flagged, never silently accepted."
// One row per (row, rule) violation so HR sees every reason at once rather than
// fixing the sheet one error per upload. `severity` separates REJECT (the row is
// not applied) from WARNING (applied, but HR should look — e.g. the name on a
// stable odooId changed).
model ImportRowIssue {
  id      String      @id @default(cuid())
  batchId String
  batch   ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  rowNumber Int     @map("row_number") // 1-based sheet row, so HR can find it
  odooId    String? @map("odoo_id") // absent when the ID itself was the problem
  field     String?
  rule      String // machine-readable rule key, e.g. "role_track_invalid"
  message   String
  severity  String  @default("REJECT") // REJECT | WARNING

  createdAt DateTime @default(now())

  @@index([batchId, severity])
  @@map("import_row_issues")
}

// ---------------------------------------------------------------------------
// Phase 2 — the performance cycle (spec §2, §5)
// ---------------------------------------------------------------------------

// §2 — "The cycle is annual, with three touchpoints." A cycle is DRAFT while HR
// sets the deadlines, OPEN once it is running, CLOSED when the year is done.
// Nothing is actionable in DRAFT, which is what lets HR set three deadlines as
// one deliberate act rather than having a half-configured cycle go live.
enum CycleStatus {
  DRAFT
  OPEN
  CLOSED
}

// §2's three touchpoints. Scoring happens ONCE, at year-end — mid-year is
// explicitly "a course-correction only", which is why there is no score field
// anywhere in Phase 2.
enum CycleStageKind {
  GOAL_SETTING
  MID_YEAR
  YEAR_END
}

// §5.1 — "both employee and manager sign off (acknowledgment of agreement)".
// Exactly two parties, and neither of them is HR: HR's approval is a different
// act (the lock), recorded on CycleParticipant, not as a third signature.
enum SignOffParty {
  EMPLOYEE
  MANAGER
}

// §5.5's ladder + §5.6's record. One enum for both because the compliance record
// IS the ladder's output — §5.6 asks for "every deadline miss and escalation
// event", so a separate notification log would be the same rows written twice.
enum ComplianceKind {
  REMINDER_SENT // approaching deadline, to the manager
  DEADLINE_MISSED // the moment it passes; logging begins here
  ESCALATED_SKIP_LEVEL // manager's manager — "authority to compel action"
  ESCALATED_HR // HR in PARALLEL with skip-level, not after it
  HR_EXTENDED_DEADLINE // one of §5.5's three formal interventions
  HR_MARKED_NON_COMPLIANT // another; the third (intervene directly) is an edit
}

// §2 — one cycle per performance year.
model PerformanceCycle {
  id     String      @id @default(cuid())
  year   Int         @unique // the performance year, e.g. 2027 (goal-set in Dec 2026)
  status CycleStatus @default(DRAFT)

  // Who opened it. An Employee, not a User: §4 talks about HR people, and the
  // audit question is "which HR person", which outlives their login.
  openedById String?   @map("opened_by_id")
  openedBy   Employee? @relation("CycleOpenedBy", fields: [openedById], references: [id])
  openedAt   DateTime? @map("opened_at")

  stages           CycleStage[]
  participants     CycleParticipant[]
  complianceEvents ComplianceEvent[]

  deletedAt DateTime?
  deletedBy String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([status, year])
  @@index([deletedAt, createdAt])
  @@map("performance_cycles")
}

// §2 "HR sets deadlines for each stage" + §5.4 "All stage deadlines are hard
// locks. After a deadline passes, the relevant party can no longer act on that
// stage."
//
// `graceDays` is NOT an extension of the ability to act — that would contradict
// §5.4. It is §5.5's third rung: how long after a miss before HR intervenes
// formally. Configurable per stage because December's patience and June's are
// not the same (operator decision, recorded in this blueprint's open questions).
model CycleStage {
  id      String           @id @default(cuid())
  cycleId String           @map("cycle_id")
  cycle   PerformanceCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  kind      CycleStageKind
  opensAt   DateTime       @map("opens_at")
  deadline  DateTime
  graceDays Int            @default(3) @map("grace_days")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cycleId, kind])
  @@index([cycleId, deadline])
  @@map("cycle_stages")
}

// One employee's participation in one cycle.
//
// §3.5 — "New rows → create the employee, pull them into the cycle", so
// enrolment is idempotent and re-runs after every import.
//
// There is deliberately NO managerId snapshot here. §12.2 fixes manager-of-record
// as "whoever currently holds the relationship at the time of each action", and
// a snapshot would leave a reassigned manager unable to act on their own report
// while a departed one still could. The signer is recorded on SignOff instead.
model CycleParticipant {
  id      String           @id @default(cuid())
  cycleId String           @map("cycle_id")
  cycle   PerformanceCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  employeeId String   @map("employee_id")
  employee   Employee @relation("ParticipantEmployee", fields: [employeeId], references: [id])

  // §5.1 — "HR approval LOCKS the KPIs as the agreed baseline." This pair IS the
  // lock; there is no separate boolean to drift out of step with it.
  goalsApprovedAt   DateTime? @map("goals_approved_at")
  goalsApprovedById String?   @map("goals_approved_by_id")
  goalsApprovedBy   Employee? @relation("GoalsApprovedBy", fields: [goalsApprovedById], references: [id])

  kpis           Kpi[]
  signOffs       SignOff[]
  changeRequests KpiChangeRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cycleId, employeeId])
  @@index([employeeId])
  @@index([cycleId, goalsApprovedAt])
  @@map("cycle_participants")
}

// §5.6 — "Every deadline miss and escalation event is logged automatically:
// manager name, what was missed, by how long, whether it required skip-level or
// HR intervention." Feeds §11.2's manager-accountability report.
//
// The unique constraint is what makes the daily sweep idempotent: a retry, or a
// manual invocation on the same day, must not inflate a manager's miss count.
/// §6.2 — the status of a mid-year change request.
enum ChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
  /// The manager thought better of it. A status, not a delete: §6.3 wants the
  /// history of what was ASKED, not only of what was approved.
  WITHDRAWN
}

/// §6.2 — one request, several KPI edits, decided as a UNIT.
///
/// The spec says "if a KPI needs adjusting", singular — but changing one
/// weightage necessarily breaks §5.3's exactly-100% rule, so a rebalance is one
/// request or the baseline sits invalid between two of them. Approval is refused
/// unless the resulting set totals exactly 100, which is what keeps §5.3 true at
/// every committed state rather than only at sign-off.
model KpiChangeRequest {
  id            String           @id @default(cuid())
  participantId String           @map("participant_id")
  participant   CycleParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  requestedByEmployeeId String   @map("requested_by_employee_id")
  requestedByEmployee   Employee @relation("ChangeRequestRequester", fields: [requestedByEmployeeId], references: [id])
  requestedAt           DateTime @default(now()) @map("requested_at")

  /// Why the manager wants the change — shown to HR when they decide.
  rationale String

  status ChangeRequestStatus @default(PENDING)

  decidedByEmployeeId String?   @map("decided_by_employee_id")
  decidedByEmployee   Employee? @relation("ChangeRequestDecider", fields: [decidedByEmployeeId], references: [id])
  decidedAt           DateTime? @map("decided_at")

  /// §6.2 — "HR must enter a reason (mandatory field) that the manager can see"
  /// on rejection. Enforced by a CHECK constraint, not only by the form: a form
  /// rule is bypassable by every other writer.
  decisionReason String? @map("decision_reason")

  edits KpiChangeRequestEdit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([participantId, status])
  @@index([status, requestedAt])
  /// NOTE: the migration also creates a PARTIAL unique index that Prisma's
  /// schema language cannot express —
  /// `("participant_id") WHERE status = 'PENDING'` — which makes a second
  /// concurrent pending request for the same participant impossible. Two pending
  /// requests are each validated against the CURRENT set, so both can total 100
  /// alone and still leave the set off 100 once both are approved. The route
  /// checks for it too, for the readable error; the index is what makes it true
  /// under concurrency. Do not `prisma migrate dev --create-only` past this and
  /// accept a generated "fix" that drops it.
  @@map("kpi_change_requests")
}

/// One KPI's proposed new state. A NULL column means "unchanged" — that is how
/// §6.2's PARTIAL change ("descriptors/metrics only") is expressed, as against a
/// full overhaul where every column is set.
model KpiChangeRequestEdit {
  id        String           @id @default(cuid())
  requestId String           @map("request_id")
  request   KpiChangeRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  kpiId String @map("kpi_id")
  kpi   Kpi    @relation(fields: [kpiId], references: [id], onDelete: Cascade)

  description String?
  weightage   Decimal? @db.Decimal(5, 2)

  descriptorOutstanding    String? @map("descriptor_outstanding")
  descriptorExcellent      String? @map("descriptor_excellent")
  descriptorTarget         String? @map("descriptor_target")
  descriptorAlmostAchieved String? @map("descriptor_almost_achieved")
  descriptorUnsatisfactory String? @map("descriptor_unsatisfactory")

  createdAt DateTime @default(now())

  @@unique([requestId, kpiId])
  @@index([kpiId])
  @@map("kpi_change_request_edits")
}

/// §6.3 — the KPI as it stood BEFORE it was superseded. A full snapshot, not a
/// diff: the clause wants "the original version" as a thing you can look at, and
/// replaying diffs to rebuild one is both fragile and slow.
///
/// Written on approval, never updated and never deleted ("archived, never
/// overwritten"). `versionNo` counts from 1 for the state the KPI was created
/// with, so the live row is always version `max(versionNo) + 1`.
model KpiVersion {
  id        String @id @default(cuid())
  kpiId     String @map("kpi_id")
  kpi       Kpi    @relation(fields: [kpiId], references: [id], onDelete: Cascade)
  versionNo Int    @map("version_no")

  description String
  weightage   Decimal @db.Decimal(5, 2)

  descriptorOutstanding    String @map("descriptor_outstanding")
  descriptorExcellent      String @map("descriptor_excellent")
  descriptorTarget         String @map("descriptor_target")
  descriptorAlmostAchieved String @map("descriptor_almost_achieved")
  descriptorUnsatisfactory String @map("descriptor_unsatisfactory")

  orderIndex Int @map("order_index")

  supersededAt          DateTime @default(now()) @map("superseded_at")
  supersededByRequestId String?  @map("superseded_by_request_id")

  createdAt DateTime @default(now())

  @@unique([kpiId, versionNo])
  @@index([kpiId, supersededAt])
  @@map("kpi_versions")
}

/// §7.1 — the year-end assessment: the employee rates themselves against each
/// KPI, then the manager rates the same KPI, then the two discuss offline and
/// both sign (§7.1's ordering, and the reason `SignOff` gained `stageKind`).
///
/// `level` is 1–5, resolving onto §8.1's scale: Outstanding 5, Excellent 4,
/// Target 3, Almost Achieved 2, Unsatisfactory 1. It is stored as the LEVEL, not
/// as a score — §6.1 forbids scoring at mid-year and §8 puts the score in
/// Phase 5. What is captured here is which descriptor was chosen; what that is
/// worth is a later, separate decision.
///
/// The descriptor TEXT is deliberately not copied onto this row. §7.1 says the
/// employee assesses "using the five-level descriptors defined at goal-setting",
/// and those live on the `Kpi` — which, after §6.2, may have been reworded by an
/// approved change request. `KpiVersion` already holds every superseded wording,
/// so the pair (kpiId, ratedAt) reconstructs what was on screen; duplicating the
/// text here would create a second copy that can disagree with both.
model KpiRating {
  id    String @id @default(cuid())
  kpiId String @map("kpi_id")
  kpi   Kpi    @relation(fields: [kpiId], references: [id], onDelete: Cascade)

  party SignOffParty

  /// §8.1's scale. CHECK-constrained to 1–5 in the migration: an out-of-range
  /// level is not a rating, and Phase 5 will map this number onto a band.
  level Int

  /// Required when this is the MANAGER's rating and it differs from the
  /// employee's self-assessment for the same KPI (operator decision, recorded in
  /// the blueprint). A divergence with no stated reason is the thing employees
  /// dispute and §10's calibration cannot interpret months later. Enforced by a
  /// trigger-free CHECK is impossible across rows, so the rule lives at the
  /// boundary and in the domain seam; see `lib/pms/rating.ts`.
  comment String?

  /// WHO rated. §7.2 — the manager of record is whoever holds the relationship
  /// at the moment of the action, so the SIGNER is recorded rather than resolved
  /// later from a relationship that may since have changed.
  ratedByEmployeeId String   @map("rated_by_employee_id")
  ratedByEmployee   Employee @relation("KpiRater", fields: [ratedByEmployeeId], references: [id])
  ratedAt           DateTime @default(now()) @map("rated_at")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One self-assessment and one manager review per KPI. Re-rating before the
  /// deadline UPDATES this row rather than appending — §7.1 describes a single
  /// assessment each, and an append-only trail here would make "the employee's
  /// rating" ambiguous at sign-off.
  @@unique([kpiId, party])
  @@index([ratedByEmployeeId])
  @@map("kpi_ratings")
}

model ComplianceEvent {
  id      String           @id @default(cuid())
  cycleId String           @map("cycle_id")
  cycle   PerformanceCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  stageKind CycleStageKind @map("stage_kind")

  // Whose KPI set was affected — the employee is the one disadvantaged by a
  // missed manager deadline (§5.5's stated principle).
  subjectEmployeeId String   @map("subject_employee_id")
  subjectEmployee   Employee @relation("ComplianceSubject", fields: [subjectEmployeeId], references: [id])

  // Who controlled the missed action. Null when the miss was the employee's own
  // (§5.4 — that is not manager non-compliance and must not pollute their record).
  managerEmployeeId String?   @map("manager_employee_id")
  managerEmployee   Employee? @relation("ComplianceManager", fields: [managerEmployeeId], references: [id])

  kind          ComplianceKind
  missedByHours Int?           @map("missed_by_hours") // §5.6 "by how long"
  detail        String

  /// The deadline this miss was measured against — part of the event's IDENTITY,
  /// not decoration.
  ///
  /// §5.5's third rung offers HR three interventions, one of which is "extend
  /// the deadline". Without this column the unique key below is scoped to the
  /// life of the STAGE, so the sweep after an extension re-derives the same
  /// three events, collides on the index, and swallows them as duplicates: the
  /// second miss is never recorded, `missedByHours` stays frozen at the value
  /// computed against the ORIGINAL deadline, and nobody is notified — because
  /// `notify()` only fires for new events. §5.6 is silently defeated the first
  /// time HR uses the one remedy the spec gives them.
  ///
  /// With it, an extension opens a fresh window for the ladder, while a re-run
  /// against the SAME deadline still collides exactly as before.
  measuredAgainstDeadline DateTime @map("measured_against_deadline")

  occurredAt DateTime @default(now()) @map("occurred_at")

  @@unique([cycleId, stageKind, subjectEmployeeId, kind, measuredAgainstDeadline])
  @@index([cycleId, kind])
  @@index([managerEmployeeId, occurredAt])
  @@map("compliance_events")
}

// §5.1 — "both employee and manager sign off (acknowledgment of agreement)".
//
// §5.3 is explicit that there is no reject: "If the employee does not agree,
// they simply do not sign. There is no 'reject' button — the unsigned state is
// the signal." So this table records only signatures; the absence of a row IS
// the disagreement, and there is deliberately no status column to hold a
// "rejected" value that the process does not have.
//
// The signer is recorded here rather than on CycleParticipant because §12.2
// makes manager-of-record time-dependent: the question worth answering later is
// "who actually signed", not "who would sign today".
model SignOff {
  id            String           @id @default(cuid())
  participantId String           @map("participant_id")
  participant   CycleParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  /// WHICH signature this is. Without it the key `[participantId, party]` says a
  /// participant signs once ever — and §7.1's year-end pair would collide with
  /// §5.1's goal-setting pair and be reported as "already signed", one flow
  /// silently swallowing the other. Backfilled to GOAL_SETTING (Phase 3a).
  stageKind CycleStageKind @default(GOAL_SETTING) @map("stage_kind")

  party SignOffParty

  signedByEmployeeId String   @map("signed_by_employee_id")
  signedByEmployee   Employee @relation("SignOffSigner", fields: [signedByEmployeeId], references: [id])
  signedAt           DateTime @default(now()) @map("signed_at")

  /// A digest of the KPI set as it stood at the moment of signing.
  ///
  /// US-12 is explicit that "neither signature prevents further edits", so a
  /// manager CAN reword a KPI or move a weightage after the employee has signed
  /// — and the set still reported `employeeSigned: true`, with nothing
  /// distinguishing "signed this exact set" from "signed an earlier version of
  /// it". HR could then approve, which is the §5.1 lock, over content the
  /// employee never saw.
  ///
  /// This adds no lock and no reject path — §5.3 is untouched. It only makes
  /// the divergence VISIBLE, which is the part the spec left no way to see.
  ///
  /// Nullable because rows signed before ADR-067's sibling change cannot have
  /// their historical set reconstructed. Null means "not recorded", and the UI
  /// says so rather than implying agreement it cannot evidence.
  kpiSetHash String? @map("kpi_set_hash")

  createdAt DateTime @default(now())

  @@unique([participantId, stageKind, party])
  @@index([signedByEmployeeId])
  @@map("sign_offs")
}

// §5.2 — "For each KPI, the manager authors: KPI description, Weightage (%),
// Five level descriptors."
//
// The five descriptors are five COLUMNS, not a child table. §5.2 fixes exactly
// five levels with fixed names and fixed numeric values (Outstanding=5 …
// Unsatisfactory=1), so columns make "exactly five" true by construction. A
// child table would permit four or six and then need a constraint to forbid what
// the schema should never have been able to express.
//
// §5.3 — weightages must total exactly 100% to sign off or lock. That is a
// SET-level rule, so it lives in lib/pms/kpi.ts and is checked at sign-off, not
// as a per-row constraint: a draft mid-edit is legitimately at 80%.
model Kpi {
  id            String           @id @default(cuid())
  participantId String           @map("participant_id")
  participant   CycleParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  description String
  // Percent, 0.00–100.00. Decimal not Float: these are summed and compared
  // against exactly 100, and binary floating point cannot promise that.
  weightage   Decimal @db.Decimal(5, 2)

  descriptorOutstanding    String @map("descriptor_outstanding") // = 5
  descriptorExcellent      String @map("descriptor_excellent") // = 4
  descriptorTarget         String @map("descriptor_target") // = 3
  descriptorAlmostAchieved String @map("descriptor_almost_achieved") // = 2
  descriptorUnsatisfactory String @map("descriptor_unsatisfactory") // = 1

  orderIndex Int @default(0) @map("order_index")

  versions    KpiVersion[]
  changeEdits KpiChangeRequestEdit[]
  ratings     KpiRating[]

  deletedAt DateTime?
  deletedBy String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([participantId, orderIndex])
  @@index([deletedAt, createdAt])
  @@map("kpis")
}
