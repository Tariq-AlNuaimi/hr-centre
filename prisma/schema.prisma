generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// -- Enums --

enum Role {
  ADMIN
  EDITOR
  VIEWER
}

// -- Auth.js Models --

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  passwordHash  String?
  image         String?
  role          Role      @default(VIEWER)
  lastLoginAt   DateTime?

  // Stable directory id for SCIM correlation (ADR-045 amendment A3). Nullable +
  // unique: only SCIM-provisioned rows carry one (password/pre-existing rows stay
  // null — Postgres allows multiple NULLs under a unique index). Correlating on
  // this instead of email means a directory email-rename updates the row in place
  // rather than orphaning access with a duplicate row (US-3).
  scimExternalId String?  @unique @map("scim_external_id")

  // Stamped whenever the password changes (reset / admin change). The Auth.js
  // `jwt` callback rejects any token issued before this instant, so completing a
  // password reset revokes every pre-existing session on its next request.
  passwordChangedAt DateTime?

  // Soft deletion
  deletedAt     DateTime?
  deletedBy     String?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  auditLogs     AuditLog[]

  // The soft-delete extension filters `deletedAt: null` on every list/count and
  // the default list sorts by createdAt desc -- a composite (deletedAt, createdAt)
  // index serves both the filter prefix and the sort. Scaffolded soft-deletable
  // models get the same (see scripts/scaffold-entity.mjs).
  @@index([deletedAt, createdAt])
  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// -- Audit --

model AuditLog {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  action     String   // CREATE, UPDATE, DELETE, RESTORE
  before     Json?
  after      Json?
  changes    Json?
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  ipAddress  String?
  userAgent  String?
  timestamp  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId])
  @@index([timestamp])
  @@map("audit_logs")
}
