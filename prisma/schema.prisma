generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// Rihal Aptitude Assessment Platform — data model (ARCHITECTURE.md §8)
//
// Multi-tenant from day one: every domain row is scoped by `orgId` even though
// Rihal is the only tenant today — cheap now, painful to retrofit later
// (ARCHITECTURE §8). Phase 1 lays down tenancy + auth + role families; later
// phases add RoleProfile/Competency/Assessment/Result/OutcomeRecord on this base.
// ============================================================================

// -- Enums --

// The two authenticated audiences (ARCHITECTURE §8, UI-SPEC Part B):
//   HR_ADMIN       — superset: role profiles, invites, calibration, settings, audit.
//   HIRING_MANAGER — review results, compare, decide (no admin surfaces).
// Default is least-privilege (HIRING_MANAGER): a misconfigured invite/SSO can't
// silently mint an admin; an HR_ADMIN promotes in-app.
enum Role {
  HR_ADMIN
  HIRING_MANAGER
}

// -- Tenancy --

model Organization {
  id            String  @id @default(cuid())
  name          String
  // URL-safe identifier; one tenant per slug.
  slug          String  @unique
  // Default candidate-facing language; candidates can still switch (UI-SPEC C.5).
  defaultLocale String  @default("en")

  // Soft deletion (org-level off-boarding; recycling-bin registered).
  deletedAt DateTime?
  deletedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users        User[]
  roleFamilies RoleFamily[]
  auditLogs    AuditLog[]

  @@index([deletedAt, createdAt])
  @@map("organizations")
}

// -- Auth.js Models --

model User {
  id            String    @id @default(cuid())
  // Tenant scoping. Optional only so the very first bootstrap admin can be
  // created before its org row exists in edge cases; every app path sets it.
  orgId         String?
  org           Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)

  email         String    @unique
  emailVerified DateTime?
  name          String?
  passwordHash  String?
  image         String?
  role          Role      @default(HIRING_MANAGER)
  lastLoginAt   DateTime?

  // Stamped whenever the password changes (reset / admin change). The Auth.js
  // `jwt` callback rejects any token issued before this instant, so completing a
  // password reset revokes every pre-existing session on its next request.
  passwordChangedAt DateTime?

  // Soft deletion
  deletedAt DateTime?
  deletedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts  Account[]
  sessions  Session[]
  auditLogs AuditLog[]

  // The soft-delete extension filters `deletedAt: null` on every list/count and
  // the default list sorts by createdAt desc -- a composite (deletedAt, createdAt)
  // index serves both the filter prefix and the sort.
  @@index([deletedAt, createdAt])
  @@index([orgId])
  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// -- Role families (ARCHITECTURE §5) --
//
// The top-level taxonomy (Sales/BD, PMO, Support, Legal/GRC, Leadership, …)
// under which versioned RoleProfiles are authored (added in Phase 3). Tenant-
// scoped so each org curates its own families.
model RoleFamily {
  id    String @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  // Stable machine key (e.g. "sales") + human label (e.g. "Sales / BD").
  key         String
  name        String
  description String?

  deletedAt DateTime?
  deletedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, key])
  @@index([deletedAt, createdAt])
  @@map("role_families")
}

// -- Audit (PDPL / ISO audit trail, ARCHITECTURE §8/§11) --

model AuditLog {
  id         String   @id @default(cuid())
  // Tenant scoping for the audit surface (UI-SPEC D.10). Nullable: bootstrap /
  // scheduler writes have no org context.
  orgId      String?
  org        Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)

  entityType String
  entityId   String
  action     String   // CREATE, UPDATE, DELETE, RESTORE
  before     Json?
  after      Json?
  changes    Json?
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  ipAddress  String?
  userAgent  String?
  timestamp  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId])
  @@index([orgId])
  @@index([timestamp])
  @@map("audit_logs")
}
