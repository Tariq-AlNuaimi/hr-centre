generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// -- Enums --

/// Platform administration only — NOT §4.1's HR authority, which lives on
/// `Employee.pmsRoles` and is a separate axis by ADR-065.
///
/// TWO values since ADR-070 (2026-08-27). `EDITOR` was removed: it gated nothing
/// — `withEditorAuth` was defined and never called by any route — while looking
/// like a rung on a ladder that did not exist. ADR-070 first stopped it being
/// grantable (the zod boundary, then the SSO seam); this retires the value
/// itself, so no row can carry a privilege the product does not honour.
///
/// The migration backfills any surviving `EDITOR` row to `VIEWER` BEFORE the type
/// swap. That is not a data loss: the two granted exactly the same nothing.
enum Role {
  ADMIN
  VIEWER
}

// -- Auth.js Models --

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  passwordHash  String?
  image         String?
  role          Role      @default(VIEWER)
  lastLoginAt   DateTime?

  // Stable directory id for SCIM correlation (ADR-045 amendment A3). Nullable +
  // unique: only SCIM-provisioned rows carry one (password/pre-existing rows stay
  // null — Postgres allows multiple NULLs under a unique index). Correlating on
  // this instead of email means a directory email-rename updates the row in place
  // rather than orphaning access with a duplicate row (US-3).
  scimExternalId String? @unique @map("scim_external_id")

  // Stamped whenever the password changes (reset / admin change). The Auth.js
  // `jwt` callback rejects any token issued before this instant, so completing a
  // password reset revokes every pre-existing session on its next request.
  passwordChangedAt DateTime?

  // Soft deletion
  deletedAt DateTime?
  deletedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts  Account[]
  sessions  Session[]
  auditLogs AuditLog[]

  // PMS (ADR-065). Optional on purpose: a User is a login identity, an Employee
  // is an org-data record, and the two populations only overlap. Most Users will
  // have an Employee; Employees without a User are normal (§4.1 Strategy team,
  // §12.1 leavers). Nothing here is required for the platform to function.
  employee      Employee?
  importBatches ImportBatch[]

  // The soft-delete extension filters `deletedAt: null` on every list/count and
  // the default list sorts by createdAt desc -- a composite (deletedAt, createdAt)
  // index serves both the filter prefix and the sort. Scaffolded soft-deletable
  // models get the same (see scripts/scaffold-entity.mjs).
  @@index([deletedAt, createdAt])
  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  // Postgres does NOT auto-index FK columns (unlike MySQL), and the unique index
  // above is keyed (provider, providerAccountId) — it cannot serve a userId-led
  // lookup. The ADR-045 SSO takeover guard runs
  // `account.findFirst({ where: { userId, provider } })` on EVERY Polis sign-in
  // (lib/auth.ts), which without this index is a sequential scan of `accounts`
  // that grows with the org. Composite so it covers both that query and a plain
  // userId lookup. (2026-07-25 review.)
  @@index([userId, provider])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// -- Audit --

model AuditLog {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  action     String // CREATE, UPDATE, DELETE, RESTORE
  before     Json?
  after      Json?
  changes    Json?
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  // Immutable actor label, denormalized at write time. The FK above is
  // `onDelete: SetNull`, so permanently deleting a User silently NULLs `userId`
  // on EVERY audit row that user ever produced — an ADMIN could erase the
  // attribution of their own history simply by deleting their account, and the
  // daily recycling-bin GC does the same thing unattended. Attribution must not
  // depend on the referenced row still existing, so it is captured here as plain
  // text and never updated afterwards. Confidential (SECURITY.md §1): it is an
  // email that deliberately OUTLIVES the user, which is the point of an audit
  // trail — a fork with erasure obligations should scrub this column on request
  // rather than rely on the cascade. (2026-07-25 review.)
  actorEmail String?
  ipAddress  String?
  userAgent  String?
  timestamp  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId])
  @@index([timestamp])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Performance Management System (PMS) — Phase 1: org foundation & import layer
//
// Implements the org-data half of the HR spec v1.0 (§1 structure, §3 org data
// & setup, §4 roles/permissions/visibility). Contract:
// docs/blueprints/performance-management-system.md. Governance: ADR-065.
//
// The later phases (cycles, KPIs, 360, scoring, calibration, bonus, reporting)
// add ~19 further models; they are specified in the blueprint so this schema
// stays forward-compatible. Nothing below assumes a cycle exists.
// ---------------------------------------------------------------------------

// PMS authority, ADDITIVE (§4.3: "a user may hold more than one; permissions
// merge — most access wins. Do not invent hybrid roles"). Held as an array on
// Employee, deliberately SEPARATE from the platform `Role` enum above, which
// keeps its own meaning (application administration) — see ADR-065.
//
// Two roles from §4.1 are intentionally NOT members:
//   * Employee     — everyone is one; membership would carry no information.
//   * Line Manager — DERIVED from Employee.managerId edges, never assigned. That
//                    is what makes §4.2's "editing/sign-off is always reserved
//                    for the direct line manager" and Appendix A's "one owner
//                    per assessment" true by construction rather than by
//                    convention: there is no field an admin could set to hand
//                    someone else's sign-off rights away.
// The Strategy team (§4.1) has NO system access at all, so it has no role here —
// HR keys their scores in on their behalf (Phase 5).
enum PmsRole {
  HR_SUPER_ADMIN // §4.1 everything + overrides; runs calibration; master export
  HRBP // §4.1 runs the cycle org-wide; everything EXCEPT master export
  EXECUTIVE_VIEWER // §4.1 COO / Ops Director: org-wide read-only, incl. salary/bonus
}

// §1.3 — every employee is tagged to exactly one track, which determines their
// scoring formula (§8.3). C_LEVEL is the exception throughout: no department
// (§1.2), no goal-setting/self-assessment/360 (§8.3), final score passed straight
// through from the entity's corporate score.
enum RoleTrack {
  C_LEVEL
  DIRECTOR
  MANAGER
  LEAD
  INDIVIDUAL
}

// §3.3 — Status. A LEAVER keeps their record and history forever (§12.1): this
// is a state, never a deletion.
enum EmployeeStatus {
  ACTIVE
  LEAVER
}

// Lifecycle of one import run. PREVIEWED is the dry-run state: the file has been
// parsed and validated and the diff is recorded, but NOTHING has been written to
// `employees` yet. Only an explicit apply moves it to APPLIED (§3.5 safety —
// see the ImportBatch comment).
enum ImportStatus {
  PREVIEWED
  APPLIED
  DISCARDED
}

// §1.2 — the group: Rihal (parent), TP, CL. Modelled as a table rather than an
// enum because departments and (Phase 5) corporate scores hang off it by FK, and
// because "the group acquires a fourth entity" must not be a schema migration.
model OrgEntity {
  id   String @id @default(cuid())
  code String @unique // RIHAL | TP | CL — stable machine key, used in imports
  name String

  departments       Department[]
  employees         Employee[]
  assignmentPeriods EmployeeAssignmentPeriod[]

  deletedAt       DateTime?
  deletedBy       String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  corporateScores EntityScore[]

  @@index([deletedAt, createdAt])
  @@map("org_entities")
}

// §1.2 — "Departments are unique to their entity (e.g. 'Rihal Marketing',
// 'TP Sales', 'CL Sales' are distinct departments)." Hence the composite unique
// on (entityId, name): the same name MAY repeat across entities and MUST NOT
// repeat within one. Central/shared-service functions (HR, Finance, Admin, IT)
// exist only under Rihal — that is a seeding fact, not a schema constraint.
model Department {
  id       String    @id @default(cuid())
  name     String
  entityId String
  entity   OrgEntity @relation(fields: [entityId], references: [id])

  employees         Employee[]
  assignmentPeriods EmployeeAssignmentPeriod[]

  deletedAt        DateTime?
  deletedBy        String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  departmentScores DepartmentScore[]

  @@unique([entityId, name])
  @@index([entityId])
  @@index([deletedAt, createdAt])
  @@map("departments")
}

// The internal employee table the system owns (§3.1). Excel is one loader today
// and Odoo becomes a second in v2, both writing HERE — downstream logic never
// reads an import file. See lib/pms/import/.
model Employee {
  id String @id @default(cuid())

  // §3.2 — the Odoo employee ID is THE permanent unique key, used from day one
  // (including in the Excel). Every downstream record (KPIs, sign-offs, 360
  // assignments, scores, audit entries) attaches to it, and it must never shift
  // on re-import. Imports upsert on this column; `id` above is an internal
  // surrogate that likewise never changes once assigned.
  odooId String @unique @map("odoo_id")

  name  String
  email String @unique // §3.3 for login/notifications

  // §1.2 — an employee belongs to exactly one department, and a department to
  // exactly one entity, so entity is IMPLIED by department. C-Level are the
  // exception: tagged to an entity directly, with no department.
  //
  // `entityId` is therefore denormalized and NOT NULL for everyone: derived from
  // the department for the four non-C-Level tracks, direct for C-Level. That
  // keeps entity-scoped reads (corporate score fan-out in Phase 5, executive
  // dashboards in Phase 6) from joining through departments, and it gives the
  // C-Level case a home instead of a null-department special path everywhere.
  //
  // The XOR invariant (department XOR C-Level-with-entity) and the agreement
  // invariant (department.entityId == employee.entityId) are enforced by CHECK
  // constraint + trigger in the migration, and again in zod at the boundary —
  // a denormalized column that can drift silently is worse than the join.
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  entityId     String
  entity       OrgEntity   @relation(fields: [entityId], references: [id])

  // §3.3 — "Direct reporting line; drives sign-off, escalation, visibility, 360."
  // Self-relation. Null only for C-Level (§3.4: "blank allowed only for C-Level")
  // and transiently for the top of the tree.
  managerId String?
  manager   Employee?  @relation("EmployeeManager", fields: [managerId], references: [id])
  reports   Employee[] @relation("EmployeeManager")

  // --- Phase 2 back-relations (spec §2, §5) --------------------------------
  cyclesOpened            PerformanceCycle[]      @relation("CycleOpenedBy")
  cycleParticipants       CycleParticipant[]      @relation("ParticipantEmployee")
  goalsApproved           CycleParticipant[]      @relation("GoalsApprovedBy")
  signOffs                SignOff[]               @relation("SignOffSigner")
  changeRequested         KpiChangeRequest[]      @relation("ChangeRequestRequester")
  ratingsGiven            KpiRating[]             @relation("KpiRater")
  ratedBy                 Assignment[]            @relation("AssignmentRatee")
  ratesOthers             Assignment[]            @relation("AssignmentRater")
  projectMembers          ProjectMember[]
  entityScoresEntered     EntityScore[]           @relation("EntityScoreAuthor")
  employeeScores          EmployeeScore[]
  calibrationsMade        CalibrationAdjustment[] @relation("CalibrationAuthor")
  scoreRunsStarted        ScoreRun[]              @relation("ScoreRunAuthor")
  publicationsMade        CyclePublication[]      @relation("PublicationAuthor")
  departmentScoresEntered DepartmentScore[]       @relation("DepartmentScoreAuthor")
  changeDecided           KpiChangeRequest[]      @relation("ChangeRequestDecider")
  changeAcknowledged      KpiChangeRequest[]      @relation("ChangeRequestAcknowledger")
  kpiEvidenceUploaded     KpiEvidence[]           @relation("KpiEvidenceUploader")
  complianceAbout         ComplianceEvent[]       @relation("ComplianceSubject")
  complianceAgainst       ComplianceEvent[]       @relation("ComplianceManager")
  notifications           Notification[]          @relation("NotificationRecipient")

  // §12 back-relations.
  rollUpsAbout      ManagerRollUp[]            @relation("RollUpSubject")
  rollUpsFrom       ManagerRollUp[]            @relation("RollUpFrom")
  rollUpsTo         ManagerRollUp[]            @relation("RollUpTo")
  rollUpsResolved   ManagerRollUp[]            @relation("RollUpResolver")
  assignmentPeriods EmployeeAssignmentPeriod[] @relation("AssignmentPeriodEmployee")
  periodsManaged    EmployeeAssignmentPeriod[] @relation("AssignmentPeriodManager")

  roleTrack RoleTrack // §1.3
  pmsRoles  PmsRole[] // §4.3 additive; empty for a plain employee

  // RESTRICTED (SECURITY.md §1; spec §4.5 + §11.6). Visible ONLY to HR
  // (HR_SUPER_ADMIN + HRBP) and the COO/Ops Director (EXECUTIVE_VIEWER). Line
  // managers never see it — not for their own direct reports, not in chain view.
  //
  // Enforcement is at the query layer, not the UI: lib/pms/employee-select.ts
  // builds the Prisma `select` from the actor's capabilities, so this column
  // never enters an unauthorised response payload. It is also in SCRUB_FIELDS
  // (lib/prisma/audit-extension.ts) so it never lands in audit_logs.
  //
  // Decimal, not Float: money. Phase 5 multiplies it by a band coefficient and
  // pro-rates over days (§11.3/§11.4); binary floating point has no business
  // anywhere near a payroll figure.
  /// LEGACY, pending drop — ADR-067 step 3, which is BLOCKED. Do not drop, truncate
  /// or stop populating this column: it is the ONLY recovery path for the encrypted
  /// one, because the production key lives solely in Vercel as a write-only Sensitive
  /// variable that nobody can read back. See ADR-067 "STEP 3 IS BLOCKED" before
  /// touching it. Still here because the encrypt-and-
  /// verify pass runs against the DEPLOYED database between two migrations, and
  /// `prisma migrate deploy` would otherwise drop the plaintext before anything
  /// had encrypted it. No application code reads this any more; `basicSalaryEnc`
  /// is the live column.
  basicSalary Decimal? @map("basic_salary") @db.Decimal(14, 3)

  /// Restricted (SECURITY.md §1), AES-256-GCM, bound to `odooId` — ADR-067.
  /// A `v1.<iv>.<ciphertext>.<tag>` envelope, never a number: JSON has one
  /// numeric type and it is a double, and this one is money.
  basicSalaryEnc String? @map("basic_salary_enc")

  status EmployeeStatus @default(ACTIVE) // §3.3

  // §3.3 — for leavers; used in the day-count. §11.4: a leaver pro-rates from
  // cycle start to their last working day.
  /// §3.3 — "Date of Joining … Anchor for 6-month eligibility gate, pro-ration
  /// Work Days, and effective service (§11)." §3.4 requires it present and valid
  /// at import.
  ///
  /// Nullable in the COLUMN, required at the BOUNDARY. Employees imported before
  /// this field existed have none, and inventing one (from `createdAt`, say)
  /// would silently decide someone's bonus eligibility from a row-creation
  /// timestamp. Null means "not on file", and §11's computation refuses rather
  /// than guessing — which surfaces it as an import gap for HR to fix.
  dateOfJoining DateTime? @map("date_of_joining") @db.Date

  lastWorkingDay DateTime? @map("last_working_day") @db.Date

  // §3.3/§11.5 — unpaid leave reduces BOTH the pro-ration day count and the
  // effective service measured against the 6-month bonus eligibility gate.
  unpaidLeaveDays Int @default(0) @map("unpaid_leave_days")

  // Login link (ADR-065). NULLABLE and unique: the employee population is not
  // the login population — the Strategy team has no system access (§4.1),
  // leavers keep records without accounts (§12.1), and employees exist here
  // before they ever sign in. Set on first login by email match, or by HR.
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Soft delete. Note this is for erroneous records only — a departure is
  // `status = LEAVER`, never a delete (§12.1: "Record and history are preserved").
  deletedAt DateTime?
  deletedBy String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([deletedAt, createdAt])
  @@index([managerId]) // hierarchy walk (lib/pms/org-tree.ts recursive CTE)
  @@index([departmentId])
  @@index([entityId])
  @@index([status])
  @@map("employees")
}

// One import run (§3.5). Deliberately TWO-STEP: uploading parses, validates and
// records the diff as PREVIEWED without writing a single employee row; a separate
// explicit apply commits it. That is what makes §3.5's "missing rows → change
// nothing" and Appendix A's "silence is never destructive" reviewable by a human
// rather than merely asserted by code — HR sees exactly what a truncated or
// filtered export would have done BEFORE it does it.
//
// `previewJson` holds the computed diff so the apply step replays what was
// reviewed rather than re-parsing the file. The uploaded FILE is never retained:
// it carries Restricted salary data, and keeping it would create a second,
// unaudited copy outside the employees table.
model ImportBatch {
  id       String       @id @default(cuid())
  filename String
  status   ImportStatus @default(PREVIEWED)

  // Who uploaded. SetNull, like audit_logs.userId — attribution survives via
  // uploadedByEmail below rather than depending on the row still existing.
  uploadedById    String?
  uploadedBy      User?   @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  uploadedByEmail String? @map("uploaded_by_email")

  rowsTotal    Int @default(0) @map("rows_total")
  rowsCreated  Int @default(0) @map("rows_created")
  rowsUpdated  Int @default(0) @map("rows_updated")
  rowsRejected Int @default(0) @map("rows_rejected")

  // Employees present in the table but absent from the file. Recorded as a COUNT
  // for HR's awareness and explicitly NOT acted on (§3.5): absence from a file is
  // never interpreted as a departure.
  rowsAbsent Int @default(0) @map("rows_absent")

  previewJson Json?     @map("preview_json")
  appliedAt   DateTime? @map("applied_at")

  issues ImportRowIssue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([createdAt])
  @@map("import_batches")
}

// §3.4 — "A row failing any rule is rejected/flagged, never silently accepted."
// One row per (row, rule) violation so HR sees every reason at once rather than
// fixing the sheet one error per upload. `severity` separates REJECT (the row is
// not applied) from WARNING (applied, but HR should look — e.g. the name on a
// stable odooId changed).
model ImportRowIssue {
  id      String      @id @default(cuid())
  batchId String
  batch   ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  rowNumber Int     @map("row_number") // 1-based sheet row, so HR can find it
  odooId    String? @map("odoo_id") // absent when the ID itself was the problem
  field     String?
  rule      String // machine-readable rule key, e.g. "role_track_invalid"
  message   String
  severity  String  @default("REJECT") // REJECT | WARNING

  createdAt DateTime @default(now())

  @@index([batchId, severity])
  @@map("import_row_issues")
}

// ---------------------------------------------------------------------------
// Phase 2 — the performance cycle (spec §2, §5)
// ---------------------------------------------------------------------------

// §2 — "The cycle is annual, with three touchpoints." A cycle is DRAFT while HR
// sets the deadlines, OPEN once it is running, CLOSED when the year is done.
// Nothing is actionable in DRAFT, which is what lets HR set three deadlines as
// one deliberate act rather than having a half-configured cycle go live.
enum CycleStatus {
  DRAFT
  OPEN
  CLOSED
}

// §2's three touchpoints. Scoring happens ONCE, at year-end — mid-year is
// explicitly "a course-correction only", which is why there is no score field
// anywhere in Phase 2.
enum CycleStageKind {
  GOAL_SETTING
  MID_YEAR
  YEAR_END
}

// §5.1 — "both employee and manager sign off (acknowledgment of agreement)".
// Exactly two parties, and neither of them is HR: HR's approval is a different
// act (the lock), recorded on CycleParticipant, not as a third signature.
enum SignOffParty {
  EMPLOYEE
  MANAGER
}

// §5.5's ladder + §5.6's record. One enum for both because the compliance record
// IS the ladder's output — §5.6 asks for "every deadline miss and escalation
// event", so a separate notification log would be the same rows written twice.
// What a notification is ABOUT. Deliberately coarser than `ComplianceKind`: the
// feed's job is to be read by a human in a popover, so the four ladder rungs
// collapse to the two that mean different things to a recipient — "you are being
// chased" and "this has been escalated past you".
enum NotificationKind {
  CYCLE_REMINDER // §5.5 rung one — approaching deadline
  CYCLE_ESCALATION // §5.5 rungs two and three, including the skip-level
  HR_INTERVENTION // §5.5 rung three's digest, to HR
  THREE_SIXTY_REMINDER // §9.7 — an outstanding 360 assessment
  CHANGE_REQUEST_RAISED // §6.2 — a mid-year change is waiting on the employee's acknowledgment
  CHANGE_REQUEST_ACKNOWLEDGED // §6.2 — the employee acknowledged; HR can now decide
}

enum ComplianceKind {
  REMINDER_SENT // approaching deadline, to the manager
  DEADLINE_MISSED // the moment it passes; logging begins here
  ESCALATED_SKIP_LEVEL // manager's manager — "authority to compel action"
  ESCALATED_HR // HR in PARALLEL with skip-level, not after it
  HR_EXTENDED_DEADLINE // one of §5.5's three formal interventions
  HR_MARKED_NON_COMPLIANT // another; the third (intervene directly) is an edit
}

// §2 — one cycle per performance year.
// §7.1's open question, as three answers rather than a boolean — because
// "prompt but do not block" is a real third position and the spec supports it:
// §7.1 puts the disagreement conversation offline, so the system recording it
// is an addition, and how strongly it insists is Rihal's call.
enum DivergenceReasonPolicy {
  REQUIRED // a divergent manager rating is refused without a written reason
  OPTIONAL // the field is offered and explained, but never blocks a save
  OFF // no reason is asked for; §7.1's offline discussion is the record
}

model PerformanceCycle {
  id     String      @id @default(cuid())
  year   Int         @unique // the performance year, e.g. 2027 (goal-set in Dec 2026)
  status CycleStatus @default(DRAFT)

  // Who opened it. An Employee, not a User: §4 talks about HR people, and the
  // audit question is "which HR person", which outlives their login.
  openedById String?   @map("opened_by_id")
  openedBy   Employee? @relation("CycleOpenedBy", fields: [openedById], references: [id])
  openedAt   DateTime? @map("opened_at")

  // --- §6.2 / §7.1 / §8.7 — the three clauses the spec leaves open ---------
  //
  // Policy, not preference. Each of these is a place the specification admits
  // more than one reading (docs/verification/OPEN-QUESTIONS-FOR-RIHAL.md), so
  // the build had to choose one — and a choice made by the build is a choice
  // Rihal has not made. These columns move the choice to HR.
  //
  // ON THE CYCLE, not in a global settings row, and that is the whole design.
  // §11's reporting reads HISTORICAL cycles, and §11.3 ties a band to a bonus
  // coefficient; a global rule flipped in 2028 would silently re-band every
  // 2027 scorecard, so a report run after the flip would disagree with the
  // payslip that was actually paid. Stored here, a finished year keeps the
  // rules it was judged by.
  //
  // Every default is exactly what the code did before these columns existed,
  // so the migration that adds them changes no behaviour. They are editable
  // only while the cycle is DRAFT — see lib/pms/cycle-policy.ts.

  /// §6.2 — RETIRED by ADR-072, column deliberately kept.
  ///
  /// This asked whether both parties sign again after HR approves a mid-year
  /// change. UAT Scenario C answered the underlying question a third way — the
  /// employee ACKNOWLEDGES before HR decides — so no cycle has a reading left
  /// to choose and nothing reads this column. It survives because a finished
  /// year must keep the record of the rules it was judged under, which is the
  /// whole reason these columns live on the cycle (ADR-057). Do NOT drop it in
  /// a "remove unused column" pass: `vercel.json` migrates on every build and
  /// a deploy is not atomic across instances.
  requireResignAfterChange Boolean @default(false) @map("require_resign_after_change")

  /// §7.1 — must a manager whose rating differs from the employee's say why?
  /// REQUIRED is more than §7.1 asks for (it puts the discussion "offline") and
  /// was the build's own addition; OPTIONAL prompts without blocking, OFF
  /// relies on the offline conversation alone.
  divergenceReason DivergenceReasonPolicy @default(REQUIRED) @map("divergence_reason")

  /// §8.7 — round the final score to 2dp BEFORE banding? False: bands are `>=`
  /// thresholds on the exact score, so 4.495 is Excellent. True makes it 4.50
  /// and Outstanding — the opposite answer from the same number, and at that
  /// boundary the difference between a 2.0x and a 1.5x bonus coefficient
  /// (§11.3).
  roundScoreBeforeBanding Boolean @default(false) @map("round_score_before_banding")

  stages            CycleStage[]
  participants      CycleParticipant[]
  complianceEvents  ComplianceEvent[]
  assignmentPeriods EmployeeAssignmentPeriod[]

  deletedAt         DateTime?
  deletedBy         String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  entityScores      EntityScore[]
  departmentScores  DepartmentScore[]
  threeSixty        ThreeSixtyCycle?
  projects          Project[]
  scoreRuns         ScoreRun[]
  calibrationTarget CalibrationTarget?
  publication       CyclePublication?

  @@index([status, year])
  @@index([deletedAt, createdAt])
  @@map("performance_cycles")
}

// §2 "HR sets deadlines for each stage" + §5.4 "All stage deadlines are hard
// locks. After a deadline passes, the relevant party can no longer act on that
// stage."
//
// `graceDays` is NOT an extension of the ability to act — that would contradict
// §5.4. It is §5.5's third rung: how long after a miss before HR intervenes
// formally. Configurable per stage because December's patience and June's are
// not the same (operator decision, recorded in this blueprint's open questions).
model CycleStage {
  id      String           @id @default(cuid())
  cycleId String           @map("cycle_id")
  cycle   PerformanceCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  kind      CycleStageKind
  opensAt   DateTime       @map("opens_at")
  deadline  DateTime
  graceDays Int            @default(3) @map("grace_days")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cycleId, kind])
  @@index([cycleId, deadline])
  @@map("cycle_stages")
}

// One employee's participation in one cycle.
//
// §3.5 — "New rows → create the employee, pull them into the cycle", so
// enrolment is idempotent and re-runs after every import.
//
// There is deliberately NO managerId snapshot here. §12.2 fixes manager-of-record
// as "whoever currently holds the relationship at the time of each action", and
// a snapshot would leave a reassigned manager unable to act on their own report
// while a departed one still could. The signer is recorded on SignOff instead.
model CycleParticipant {
  id      String           @id @default(cuid())
  cycleId String           @map("cycle_id")
  cycle   PerformanceCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  employeeId String   @map("employee_id")
  employee   Employee @relation("ParticipantEmployee", fields: [employeeId], references: [id])

  // §5.1 — "HR approval LOCKS the KPIs as the agreed baseline." This pair IS the
  // lock; there is no separate boolean to drift out of step with it.
  goalsApprovedAt   DateTime? @map("goals_approved_at")
  goalsApprovedById String?   @map("goals_approved_by_id")
  goalsApprovedBy   Employee? @relation("GoalsApprovedBy", fields: [goalsApprovedById], references: [id])

  kpis           Kpi[]
  signOffs       SignOff[]
  changeRequests KpiChangeRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cycleId, employeeId])
  @@index([employeeId])
  @@index([cycleId, goalsApprovedAt])
  @@map("cycle_participants")
}

// §5.6 — "Every deadline miss and escalation event is logged automatically:
// manager name, what was missed, by how long, whether it required skip-level or
// HR intervention." Feeds §11.2's manager-accountability report.
//
// The unique constraint is what makes the daily sweep idempotent: a retry, or a
// manual invocation on the same day, must not inflate a manager's miss count.
/// §6.2 — the status of a mid-year change request.
enum ChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
  /// The manager thought better of it. A status, not a delete: §6.3 wants the
  /// history of what was ASKED, not only of what was approved.
  WITHDRAWN

  /// §6.2 — the mid-year deadline passed with no acknowledgment from the
  /// employee, so the request is locked and the KPI is unchanged. Materialised
  /// by `cycle-sweep`; `effectiveChangeRequestStatus` derives the same verdict
  /// on read, so the lock does not wait for a cron to notice.
  NOT_ACKNOWLEDGED
}

/// §6.2 — one request, several KPI edits, decided as a UNIT.
///
/// The spec says "if a KPI needs adjusting", singular — but changing one
/// weightage necessarily breaks §5.3's exactly-100% rule, so a rebalance is one
/// request or the baseline sits invalid between two of them. Approval is refused
/// unless the resulting set totals exactly 100, which is what keeps §5.3 true at
/// every committed state rather than only at sign-off.
model KpiChangeRequest {
  id            String           @id @default(cuid())
  participantId String           @map("participant_id")
  participant   CycleParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  requestedByEmployeeId String   @map("requested_by_employee_id")
  requestedByEmployee   Employee @relation("ChangeRequestRequester", fields: [requestedByEmployeeId], references: [id])
  requestedAt           DateTime @default(now()) @map("requested_at")

  /// Why the manager wants the change — shown to HR when they decide.
  rationale String

  status ChangeRequestStatus @default(PENDING)

  decidedByEmployeeId String?   @map("decided_by_employee_id")
  decidedByEmployee   Employee? @relation("ChangeRequestDecider", fields: [decidedByEmployeeId], references: [id])
  decidedAt           DateTime? @map("decided_at")

  /// §6.2 — "HR must enter a reason (mandatory field) that the manager can see"
  /// on rejection. Enforced by a CHECK constraint, not only by the form: a form
  /// rule is bypassable by every other writer.
  decisionReason String? @map("decision_reason")

  /// §6.2 — the employee's acknowledgment, which HR sees before deciding. NOT a
  /// signature and not an approval: there is no reject button, exactly as in
  /// §5.1's goal-setting sign-off, because the disagreement is settled offline.
  /// Null past the deadline is itself the answer — see `NOT_ACKNOWLEDGED`.
  acknowledgedAt           DateTime? @map("acknowledged_at")
  acknowledgedByEmployeeId String?   @map("acknowledged_by_employee_id")
  acknowledgedByEmployee   Employee? @relation("ChangeRequestAcknowledger", fields: [acknowledgedByEmployeeId], references: [id])

  /// §6.2 — HR's exception: approving a change the employee never acknowledged.
  /// Kept apart from `decisionReason`, which the rejection CHECK constraint
  /// already owns; one column serving two mandatory-reason rules makes both
  /// harder to state and impossible to constrain separately. Its own CHECK
  /// makes an unexplained override impossible below the API, not just in it.
  acknowledgmentOverridden Boolean @default(false) @map("acknowledgment_overridden")
  overrideReason           String? @map("override_reason")

  edits KpiChangeRequestEdit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([participantId, status])
  @@index([status, requestedAt])
  /// NOTE: the migration also creates a PARTIAL unique index that Prisma's
  /// schema language cannot express —
  /// `("participant_id") WHERE status = 'PENDING'` — which makes a second
  /// concurrent pending request for the same participant impossible. Two pending
  /// requests are each validated against the CURRENT set, so both can total 100
  /// alone and still leave the set off 100 once both are approved. The route
  /// checks for it too, for the readable error; the index is what makes it true
  /// under concurrency. Do not `prisma migrate dev --create-only` past this and
  /// accept a generated "fix" that drops it.
  @@map("kpi_change_requests")
}

/// One KPI's proposed new state. A NULL column means "unchanged" — that is how
/// §6.2's PARTIAL change ("descriptors/metrics only") is expressed, as against a
/// full overhaul where every column is set.
model KpiChangeRequestEdit {
  id        String           @id @default(cuid())
  requestId String           @map("request_id")
  request   KpiChangeRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  kpiId String @map("kpi_id")
  kpi   Kpi    @relation(fields: [kpiId], references: [id], onDelete: Cascade)

  description String?
  weightage   Decimal? @db.Decimal(5, 2)

  descriptorOutstanding    String? @map("descriptor_outstanding")
  descriptorExcellent      String? @map("descriptor_excellent")
  descriptorTarget         String? @map("descriptor_target")
  descriptorAlmostAchieved String? @map("descriptor_almost_achieved")
  descriptorUnsatisfactory String? @map("descriptor_unsatisfactory")

  createdAt DateTime @default(now())

  @@unique([requestId, kpiId])
  @@index([kpiId])
  @@map("kpi_change_request_edits")
}

/// §6.3 — the KPI as it stood BEFORE it was superseded. A full snapshot, not a
/// diff: the clause wants "the original version" as a thing you can look at, and
/// replaying diffs to rebuild one is both fragile and slow.
///
/// Written on approval, never updated and never deleted ("archived, never
/// overwritten"). `versionNo` counts from 1 for the state the KPI was created
/// with, so the live row is always version `max(versionNo) + 1`.
model KpiVersion {
  id        String @id @default(cuid())
  kpiId     String @map("kpi_id")
  kpi       Kpi    @relation(fields: [kpiId], references: [id], onDelete: Cascade)
  versionNo Int    @map("version_no")

  description String
  weightage   Decimal @db.Decimal(5, 2)

  descriptorOutstanding    String @map("descriptor_outstanding")
  descriptorExcellent      String @map("descriptor_excellent")
  descriptorTarget         String @map("descriptor_target")
  descriptorAlmostAchieved String @map("descriptor_almost_achieved")
  descriptorUnsatisfactory String @map("descriptor_unsatisfactory")

  orderIndex Int @map("order_index")

  supersededAt          DateTime @default(now()) @map("superseded_at")
  supersededByRequestId String?  @map("superseded_by_request_id")

  createdAt DateTime @default(now())

  @@unique([kpiId, versionNo])
  @@index([kpiId, supersededAt])
  @@map("kpi_versions")
}

/// §7.1 — the year-end assessment: the employee rates themselves against each
/// KPI, then the manager rates the same KPI, then the two discuss offline and
/// both sign (§7.1's ordering, and the reason `SignOff` gained `stageKind`).
///
/// `level` is 1–5, resolving onto §8.1's scale: Outstanding 5, Excellent 4,
/// Target 3, Almost Achieved 2, Unsatisfactory 1. It is stored as the LEVEL, not
/// as a score — §6.1 forbids scoring at mid-year and §8 puts the score in
/// Phase 5. What is captured here is which descriptor was chosen; what that is
/// worth is a later, separate decision.
///
/// The descriptor TEXT is deliberately not copied onto this row. §7.1 says the
/// employee assesses "using the five-level descriptors defined at goal-setting",
/// and those live on the `Kpi` — which, after §6.2, may have been reworded by an
/// approved change request. `KpiVersion` already holds every superseded wording,
/// so the pair (kpiId, ratedAt) reconstructs what was on screen; duplicating the
/// text here would create a second copy that can disagree with both.
model KpiRating {
  id    String @id @default(cuid())
  kpiId String @map("kpi_id")
  kpi   Kpi    @relation(fields: [kpiId], references: [id], onDelete: Cascade)

  party SignOffParty

  /// §8.1's scale. CHECK-constrained to 1–5 in the migration: an out-of-range
  /// level is not a rating, and Phase 5 will map this number onto a band.
  level Int

  /// Required when this is the MANAGER's rating and it differs from the
  /// employee's self-assessment for the same KPI (operator decision, recorded in
  /// the blueprint). A divergence with no stated reason is the thing employees
  /// dispute and §10's calibration cannot interpret months later. Enforced by a
  /// trigger-free CHECK is impossible across rows, so the rule lives at the
  /// boundary and in the domain seam; see `lib/pms/rating.ts`.
  comment String?

  /// WHO rated. §7.2 — the manager of record is whoever holds the relationship
  /// at the moment of the action, so the SIGNER is recorded rather than resolved
  /// later from a relationship that may since have changed.
  ratedByEmployeeId String   @map("rated_by_employee_id")
  ratedByEmployee   Employee @relation("KpiRater", fields: [ratedByEmployeeId], references: [id])
  ratedAt           DateTime @default(now()) @map("rated_at")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One self-assessment and one manager review per KPI. Re-rating before the
  /// deadline UPDATES this row rather than appending — §7.1 describes a single
  /// assessment each, and an append-only trail here would make "the employee's
  /// rating" ambiguous at sign-off.
  @@unique([kpiId, party])
  @@index([ratedByEmployeeId])
  @@map("kpi_ratings")
}

/// §7.1 — the evidence behind a self-assessed rating (operator requirement,
/// 2026-10-20). Confidential (SECURITY.md §1): disclosure harms the individual.
///
/// REQUIRED per KPI before the employee may sign — the rule lives in
/// `signBlockedReason` (lib/pms/evidence.ts), not in a form validator, so every
/// writer answers to it.
///
/// Soft-deleted rather than removed: an item withdrawn before signing is part
/// of how the assessment was built, and §6.3's principle — old versions are
/// archived, never overwritten — reads across to it. `Kpi` cascades, so a
/// deleted KPI takes its evidence with it.
/// §7.1 — what an evidence item IS. A file lives in private Blob storage and is
/// reachable only through a route that checks §4.2 first; a link is a URL the
/// employee supplied, stored verbatim and never fetched by us.
enum EvidenceKind {
  FILE
  LINK
}

model KpiEvidence {
  id    String @id @default(cuid())
  kpiId String @map("kpi_id")
  kpi   Kpi    @relation(fields: [kpiId], references: [id], onDelete: Cascade)

  kind  EvidenceKind
  /// What the employee called it. Shown, never parsed.
  label String

  /// FILE only — the private Blob pathname. NOT a URL: there is no public URL
  /// for these, and storing one would be the bug this design exists to avoid.
  /// A reader gets a short-lived signed URL from a route that checked §4.2.
  blobPathname String? @map("blob_pathname")
  contentType  String? @map("content_type")
  sizeBytes    Int?    @map("size_bytes")

  /// LINK only — the http(s) address the employee supplied.
  url String?

  uploadedByEmployeeId String   @map("uploaded_by_employee_id")
  uploadedByEmployee   Employee @relation("KpiEvidenceUploader", fields: [uploadedByEmployeeId], references: [id])
  uploadedAt           DateTime @default(now()) @map("uploaded_at")

  /// §7.1 — the manager may comment on an item while reviewing.
  managerComment   String?   @map("manager_comment")
  managerCommentAt DateTime? @map("manager_comment_at")

  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kpiId, deletedAt])
  @@index([uploadedByEmployeeId])
  @@map("kpi_evidence")
}

model ComplianceEvent {
  id      String           @id @default(cuid())
  cycleId String           @map("cycle_id")
  cycle   PerformanceCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  stageKind CycleStageKind @map("stage_kind")

  // Whose KPI set was affected — the employee is the one disadvantaged by a
  // missed manager deadline (§5.5's stated principle).
  subjectEmployeeId String   @map("subject_employee_id")
  subjectEmployee   Employee @relation("ComplianceSubject", fields: [subjectEmployeeId], references: [id])

  // Who controlled the missed action. Null when the miss was the employee's own
  // (§5.4 — that is not manager non-compliance and must not pollute their record).
  managerEmployeeId String?   @map("manager_employee_id")
  managerEmployee   Employee? @relation("ComplianceManager", fields: [managerEmployeeId], references: [id])

  kind          ComplianceKind
  missedByHours Int?           @map("missed_by_hours") // §5.6 "by how long"
  detail        String

  /// The deadline this miss was measured against — part of the event's IDENTITY,
  /// not decoration.
  ///
  /// §5.5's third rung offers HR three interventions, one of which is "extend
  /// the deadline". Without this column the unique key below is scoped to the
  /// life of the STAGE, so the sweep after an extension re-derives the same
  /// three events, collides on the index, and swallows them as duplicates: the
  /// second miss is never recorded, `missedByHours` stays frozen at the value
  /// computed against the ORIGINAL deadline, and nobody is notified — because
  /// `notify()` only fires for new events. §5.6 is silently defeated the first
  /// time HR uses the one remedy the spec gives them.
  ///
  /// With it, an extension opens a fresh window for the ladder, while a re-run
  /// against the SAME deadline still collides exactly as before.
  measuredAgainstDeadline DateTime @map("measured_against_deadline")

  occurredAt DateTime @default(now()) @map("occurred_at")

  @@unique([cycleId, stageKind, subjectEmployeeId, kind, measuredAgainstDeadline])
  @@index([cycleId, kind])
  @@index([managerEmployeeId, occurredAt])
  @@map("compliance_events")
}

// The in-app half of §5.5's ladder — what a person was TOLD, as opposed to what
// is waiting on them (§4.4's My Tasks, which is derived, not stored).
//
// This model exists because the ladder had exactly one channel and the
// deployment does not have it: `lib/email.ts` no-ops unless `SMTP_HOST` is set,
// so `cycle-notify.ts` computed a perfectly correct recipient map every morning
// and then discarded it. §5.6's record was written and §5.5's escalation reached
// nobody — worst of all the skip-level manager, whom §5.5 names as the one "with
// authority to compel action" and who has no task row to discover it through.
//
// A row here is therefore not a copy of an email. It is the notification, and
// email is the optional second channel over the same recipient map.
model Notification {
  id String @id @default(cuid())

  // The recipient is an Employee, not a User: the ladder works in employee ids
  // (§12.2's manager-of-record), and ADR-065 keeps the login identity separate.
  // A signed-in user with no employee record therefore has no notifications,
  // which is the same answer §4.4's My Tasks gives them.
  recipientEmployeeId String   @map("recipient_employee_id")
  recipientEmployee   Employee @relation("NotificationRecipient", fields: [recipientEmployeeId], references: [id], onDelete: Cascade)

  kind NotificationKind

  /// The specific sentence — WHAT happened, in the machine's own words.
  ///
  /// There is deliberately no `title` column. The heading is derived from
  /// `kind` and translated by the UI (next-intl, both locales, RTL), so the
  /// part of a notification a reader scans is in their language. This column
  /// holds the same English detail string §5.6 already stores on
  /// `ComplianceEvent.detail` and §11.2 already shows HR — one machine-written
  /// sentence, one representation of it, rather than a second copy of the
  /// ladder's prose that could drift from the record.
  body String

  /// Where acting on this starts, WITHOUT a locale prefix — the client adds its
  /// own. A sweep running at 06:00 has no viewer and therefore no locale, so
  /// baking one in here would pin every recipient to whichever the cron guessed.
  /// Null when there is nothing to open: an HR digest names a queue, not a row.
  href String?

  /// Idempotency, and the reason a daily sweep does not produce a daily copy.
  ///
  /// Built from the originating event's OWN identity plus the recipient — for a
  /// ladder event, `ComplianceEvent`'s unique tuple (which includes
  /// `measuredAgainstDeadline`) with the recipient appended. Two consequences,
  /// both wanted: re-running the sweep against an unresolved miss writes
  /// nothing, and HR extending the deadline (§5.5's own remedy) produces a NEW
  /// notification, because it is a new miss measured against a new deadline.
  dedupeKey String @unique @map("dedupe_key")

  /// Null until read. Per-employee rather than per-device on purpose: the
  /// question is "has this person seen it", not "has this browser".
  readAt DateTime? @map("read_at")

  createdAt DateTime @default(now()) @map("created_at")

  // The unread badge counts on the first; the feed pages on the second.
  @@index([recipientEmployeeId, readAt])
  @@index([recipientEmployeeId, createdAt])
  @@map("notifications")
}

// §5.1 — "both employee and manager sign off (acknowledgment of agreement)".
//
// §5.3 is explicit that there is no reject: "If the employee does not agree,
// they simply do not sign. There is no 'reject' button — the unsigned state is
// the signal." So this table records only signatures; the absence of a row IS
// the disagreement, and there is deliberately no status column to hold a
// "rejected" value that the process does not have.
//
// The signer is recorded here rather than on CycleParticipant because §12.2
// makes manager-of-record time-dependent: the question worth answering later is
// "who actually signed", not "who would sign today".
model SignOff {
  id            String           @id @default(cuid())
  participantId String           @map("participant_id")
  participant   CycleParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  /// WHICH signature this is. Without it the key `[participantId, party]` says a
  /// participant signs once ever — and §7.1's year-end pair would collide with
  /// §5.1's goal-setting pair and be reported as "already signed", one flow
  /// silently swallowing the other. Backfilled to GOAL_SETTING (Phase 3a).
  stageKind CycleStageKind @default(GOAL_SETTING) @map("stage_kind")

  party SignOffParty

  signedByEmployeeId String   @map("signed_by_employee_id")
  signedByEmployee   Employee @relation("SignOffSigner", fields: [signedByEmployeeId], references: [id])
  signedAt           DateTime @default(now()) @map("signed_at")

  /// A digest of the KPI set as it stood at the moment of signing.
  ///
  /// US-12 is explicit that "neither signature prevents further edits", so a
  /// manager CAN reword a KPI or move a weightage after the employee has signed
  /// — and the set still reported `employeeSigned: true`, with nothing
  /// distinguishing "signed this exact set" from "signed an earlier version of
  /// it". HR could then approve, which is the §5.1 lock, over content the
  /// employee never saw.
  ///
  /// This adds no lock and no reject path — §5.3 is untouched. It only makes
  /// the divergence VISIBLE, which is the part the spec left no way to see.
  ///
  /// Nullable because rows signed before ADR-067's sibling change cannot have
  /// their historical set reconstructed. Null means "not recorded", and the UI
  /// says so rather than implying agreement it cannot evidence.
  kpiSetHash String? @map("kpi_set_hash")

  createdAt DateTime @default(now())

  @@unique([participantId, stageKind, party])
  @@index([signedByEmployeeId])
  @@map("sign_offs")
}

// §5.2 — "For each KPI, the manager authors: KPI description, Weightage (%),
// Five level descriptors."
//
// The five descriptors are five COLUMNS, not a child table. §5.2 fixes exactly
// five levels with fixed names and fixed numeric values (Outstanding=5 …
// Unsatisfactory=1), so columns make "exactly five" true by construction. A
// child table would permit four or six and then need a constraint to forbid what
// the schema should never have been able to express.
//
// §5.3 — weightages must total exactly 100% to sign off or lock. That is a
// SET-level rule, so it lives in lib/pms/kpi.ts and is checked at sign-off, not
// as a per-row constraint: a draft mid-edit is legitimately at 80%.
model Kpi {
  id            String           @id @default(cuid())
  participantId String           @map("participant_id")
  participant   CycleParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  /// §12.3 — which portion of a split year this KPI belongs to.
  ///
  /// NULL for everyone who did not transfer, which is almost everyone: the
  /// un-split path is the default and needs no row. When it IS set, §5.3's
  /// "exactly 100%" applies PER PERIOD — each department's manager owns a
  /// complete set for their own portion.
  assignmentPeriodId String?                   @map("assignment_period_id")
  assignmentPeriod   EmployeeAssignmentPeriod? @relation(fields: [assignmentPeriodId], references: [id], onDelete: SetNull)

  description String
  // Percent, 0.00–100.00. Decimal not Float: these are summed and compared
  // against exactly 100, and binary floating point cannot promise that.
  weightage   Decimal @db.Decimal(5, 2)

  descriptorOutstanding    String @map("descriptor_outstanding") // = 5
  descriptorExcellent      String @map("descriptor_excellent") // = 4
  descriptorTarget         String @map("descriptor_target") // = 3
  descriptorAlmostAchieved String @map("descriptor_almost_achieved") // = 2
  descriptorUnsatisfactory String @map("descriptor_unsatisfactory") // = 1

  orderIndex Int @default(0) @map("order_index")

  versions    KpiVersion[]
  changeEdits KpiChangeRequestEdit[]
  ratings     KpiRating[]
  evidence    KpiEvidence[]

  deletedAt DateTime?
  deletedBy String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([participantId, orderIndex])
  @@index([deletedAt, createdAt])
  @@map("kpis")
}

/// §8.4 — "Corporate KPI: produced by the Strategy team, provided to HR as one
/// score per entity (Rihal, TP, CL). Each employee receives the Corporate score
/// of their entity."
///
/// A score belongs to a CYCLE, not to the entity: last year's figure must still
/// be readable after this year's is keyed in, which a column on `OrgEntity`
/// could not do. §4.1 gives the Strategy team no system access, so `enteredBy`
/// records the HR person who keyed it — the accountable party for the number.
model EntityScore {
  id       String           @id @default(cuid())
  cycleId  String           @map("cycle_id")
  cycle    PerformanceCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  entityId String           @map("entity_id")
  entity   OrgEntity        @relation(fields: [entityId], references: [id], onDelete: Cascade)

  /// §8.1's scale. CHECK-constrained to 1.00–5.00 in the migration.
  score Decimal @db.Decimal(3, 2)

  enteredByEmployeeId String   @map("entered_by_employee_id")
  enteredByEmployee   Employee @relation("EntityScoreAuthor", fields: [enteredByEmployeeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cycleId, entityId])
  @@map("entity_scores")
}

/// §8.4 — "Departmental KPI: … one score per department. Automatically applied
/// to all Directors, Managers, and Leads tagged to that department.
/// (Individuals have no Departmental component.)"
model DepartmentScore {
  id           String           @id @default(cuid())
  cycleId      String           @map("cycle_id")
  cycle        PerformanceCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  departmentId String           @map("department_id")
  department   Department       @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  score Decimal @db.Decimal(3, 2)

  enteredByEmployeeId String   @map("entered_by_employee_id")
  enteredByEmployee   Employee @relation("DepartmentScoreAuthor", fields: [enteredByEmployeeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cycleId, departmentId])
  @@map("department_scores")
}

// --- §9 The 360 assessment module -------------------------------------------

/// §9.1 — "Create a 360 cycle linked to the KPI assessment year, so 360 and KPI
/// scores tie to the same performance year."
///
/// One per performance cycle (`cycleId @unique`): §9.1 says the two tie
/// together, and a second 360 on the same year would make "the employee's 360
/// ratio" ambiguous at scoring time.
model ThreeSixtyCycle {
  id      String           @id @default(cuid())
  cycleId String           @unique @map("cycle_id")
  cycle   PerformanceCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  /// DRAFT while HR builds and edits assignments (§9.6), ACTIVE once published
  /// (§9.7), CLOSED when results are calculated (§9.8).
  status ThreeSixtyStatus @default(DRAFT)

  opensAt  DateTime
  deadline DateTime

  templates   AssessmentTemplate[]
  assignments Assignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("three_sixty_cycles")
}

enum ThreeSixtyStatus {
  DRAFT
  ACTIVE
  CLOSED
}

/// §9.2's three assessment types. "Employee → Line Manager (a reportee assessing
/// their manager uses this template; employee = reportee)."
enum AssessmentType {
  LINE_MANAGER_TO_EMPLOYEE
  EMPLOYEE_TO_LINE_MANAGER
  PEER_TO_PEER
}

/// §9.2 — "Three assessment types, each with its own question template. Each
/// template contains scored questions plus open-ended feedback questions."
model AssessmentTemplate {
  id                String          @id @default(cuid())
  threeSixtyCycleId String          @map("three_sixty_cycle_id")
  threeSixtyCycle   ThreeSixtyCycle @relation(fields: [threeSixtyCycleId], references: [id], onDelete: Cascade)

  type AssessmentType

  questions   TemplateQuestion[]
  assignments Assignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([threeSixtyCycleId, type])
  @@map("assessment_templates")
}

model TemplateQuestion {
  id         String             @id @default(cuid())
  templateId String             @map("template_id")
  template   AssessmentTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  text       String
  orderIndex Int    @map("order_index")

  /// §9.5 sums "the answered question scores", so an open-ended feedback
  /// question has none. `scored = false` keeps it out of the ratio entirely
  /// rather than counting it as a zero.
  scored Boolean @default(true)

  responses AssignmentResponse[]

  createdAt DateTime @default(now())

  @@unique([templateId, orderIndex])
  @@map("template_questions")
}

/// §9.4 — "Raters — exactly 3 per employee: line manager (mandatory), peer
/// (mandatory), third rater — a direct reportee if available; otherwise a second
/// peer. HR selects and manages all rater assignments."
model Assignment {
  id                String          @id @default(cuid())
  threeSixtyCycleId String          @map("three_sixty_cycle_id")
  threeSixtyCycle   ThreeSixtyCycle @relation(fields: [threeSixtyCycleId], references: [id], onDelete: Cascade)

  /// The employee being assessed.
  rateeId String   @map("ratee_id")
  ratee   Employee @relation("AssignmentRatee", fields: [rateeId], references: [id], onDelete: Cascade)

  /// The person doing the assessing.
  raterId String   @map("rater_id")
  rater   Employee @relation("AssignmentRater", fields: [raterId], references: [id], onDelete: Cascade)

  templateId String             @map("template_id")
  template   AssessmentTemplate @relation(fields: [templateId], references: [id])

  /// §9.7's per-evaluator tracking. OVERDUE is DERIVED from the deadline rather
  /// than stored — a stored one would need a job to stay true, and §12.1 wants
  /// a leaver's assignments to stop reading Overdue the moment they leave.
  status AssignmentStatus @default(NOT_STARTED)

  submittedAt DateTime? @map("submitted_at")

  responses AssignmentResponse[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// §9.7 — "prevent duplicate submissions per assignment". One rater assesses
  /// one ratee once per cycle.
  @@unique([threeSixtyCycleId, rateeId, raterId])
  @@index([raterId, status])
  @@index([threeSixtyCycleId, rateeId])
  @@map("assignments")
}

enum AssignmentStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
}

/// One answer. §9.3's forced 4-point scale for a scored question; free text for
/// an open-ended one. CHECK-constrained so a scored answer carries a score and
/// an open-ended one does not.
model AssignmentResponse {
  id           String     @id @default(cuid())
  assignmentId String     @map("assignment_id")
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  questionId String           @map("question_id")
  question   TemplateQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  /// §9.3 — Strongly Disagree 1 … Strongly Agree 4. No neutral midpoint.
  score Int?

  /// §9.2's open-ended feedback. Consolidated unattributed at §13.1.
  text String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([assignmentId, questionId])
  @@map("assignment_responses")
}

/// §9.6 — "Projects (optional): ability to create projects and link employees,
/// so peers can be drawn from shared project work. Not applicable to everyone."
model Project {
  id      String           @id @default(cuid())
  cycleId String           @map("cycle_id")
  cycle   PerformanceCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  name String

  members ProjectMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cycleId, name])
  @@map("projects")
}

model ProjectMember {
  id        String  @id @default(cuid())
  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  employeeId String   @map("employee_id")
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([projectId, employeeId])
  @@map("project_members")
}

// --- §8 wiring, §10 calibration, §11 bonus -----------------------------------

/// §10.7's sequencing: "Assessments completed & signed → raw scores calculated
/// (all) → HR Super Admin calibration gate → calibrated scores finalized →
/// results published".
///
/// A run is one pass of the raw-score calculation over a whole cycle. Recording
/// it as a row rather than doing the arithmetic on the fly is what makes §10.1's
/// "every employee always retains both a raw calculated score and a calibrated
/// score" true: the raw number is written once, and nothing later can rewrite it.
model ScoreRun {
  id      String           @id @default(cuid())
  cycleId String           @map("cycle_id")
  cycle   PerformanceCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  startedByEmployeeId String   @map("started_by_employee_id")
  startedByEmployee   Employee @relation("ScoreRunAuthor", fields: [startedByEmployeeId], references: [id])

  startedAt  DateTime  @default(now()) @map("started_at")
  /// Null while running. A run that never finished is visible as such rather
  /// than looking like a completed one with fewer rows.
  finishedAt DateTime? @map("finished_at")

  /// How many employees this run scored, and how many it could not (and why).
  scoredCount  Int @default(0) @map("scored_count")
  skippedCount Int @default(0) @map("skipped_count")

  scores EmployeeScore[]

  createdAt DateTime @default(now())

  @@index([cycleId, startedAt])
  @@map("score_runs")
}

/// One employee's scored result for one cycle.
///
/// §10.1 — "Every employee always retains both a raw calculated score and a
/// calibrated score, with full auditability." So the raw components and raw
/// final score are written by the score run and NEVER updated; calibration
/// writes only `calibratedBand`, through an adjustment row that carries its own
/// reason.
model EmployeeScore {
  id         String   @id @default(cuid())
  scoreRunId String   @map("score_run_id")
  scoreRun   ScoreRun @relation(fields: [scoreRunId], references: [id], onDelete: Cascade)

  employeeId String   @map("employee_id")
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  /// The four §8.6 components, stored so §13.5's master export can show the
  /// working rather than re-deriving it from data that has since moved on.
  /// Departmental is null for the Individual track (§8.3).
  corporateScore    Decimal  @map("corporate_score") @db.Decimal(3, 2)
  departmentalScore Decimal? @map("departmental_score") @db.Decimal(3, 2)
  individualScore   Decimal  @map("individual_score") @db.Decimal(3, 2)
  threeSixtyScore   Decimal? @map("three_sixty_score") @db.Decimal(3, 2)

  /// How many raters the §9.5 figure beside it was averaged over (red-team F8).
  ///
  /// §9.5 says "average the **3** ratios". `overallRatio` averages over however
  /// many arrived, which is the right call — dividing by a hard 3 would dock a
  /// ratee for a rater's departure. But it made a score built from one rater
  /// indistinguishable from one built from three, on the employee's scorecard,
  /// in §13.5's master export and in the §11 bonus that follows. In the 36-person
  /// demo fixture, 26 of 33 ratees had fewer than three raters available.
  ///
  /// **This column changes no arithmetic.** It is not an input to `rawScore`, it
  /// gates nothing, and §13.2's publish does not consult it. It exists so a
  /// human reading a score can see how thin its 360 was, which is a calibration
  /// judgement (§10) and not a rule.
  ///
  /// NULLABLE, and the distinction is load-bearing: `null` means "this row
  /// predates the column, so the count is unknown", `0` would mean "nobody
  /// rated them" — and a score run written before this migration must not
  /// claim the second. Rows with a null `threeSixtyScore` (the C-Level track,
  /// §8.3) also carry null here: there was no 360 to count.
  threeSixtyRaterCount Int? @map("three_sixty_rater_count")

  /// §8.6's result and §8.7's band. RAW — never overwritten (§10.1).
  rawScore Decimal @map("raw_score") @db.Decimal(3, 2)
  rawBand  Band    @map("raw_band")

  /// §10 — the calibrated band. Equals `rawBand` until HR moves it, and is what
  /// §11.3 reads for the bonus coefficient.
  calibratedBand Band @map("calibrated_band")

  adjustments CalibrationAdjustment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([scoreRunId, employeeId])
  @@index([employeeId])
  @@map("employee_scores")
}

/// §8.7's five bands.
enum Band {
  OUTSTANDING
  EXCELLENT
  TARGET
  ALMOST_ACHIEVED
  UNSATISFACTORY
}

/// §10.2 — "HR Super Admin defines an editable target distribution across the
/// five bands (what % should land in each band)." §10.3's threshold lives here
/// too, because it is the other editable setting that shapes a calibration.
model CalibrationTarget {
  id      String           @id @default(cuid())
  cycleId String           @unique @map("cycle_id")
  cycle   PerformanceCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  outstandingPct    Decimal @map("outstanding_pct") @db.Decimal(5, 2)
  excellentPct      Decimal @map("excellent_pct") @db.Decimal(5, 2)
  targetPct         Decimal @map("target_pct") @db.Decimal(5, 2)
  almostAchievedPct Decimal @map("almost_achieved_pct") @db.Decimal(5, 2)
  unsatisfactoryPct Decimal @map("unsatisfactory_pct") @db.Decimal(5, 2)

  /// §10.3 — "only to departments with ≥ 5 active employees … The threshold (5)
  /// is an editable setting controlled by HR Super Admin."
  minDepartmentSize Int @default(5) @map("min_department_size")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("calibration_targets")
}

/// §10.5 — "Every override/adjustment is audited: who, from-score, to-score,
/// when, and a mandatory reason."
///
/// An append-only trail, not a mutable field: §10.1 wants full auditability, so
/// moving someone twice leaves two rows and the second does not erase the first.
model CalibrationAdjustment {
  id              String        @id @default(cuid())
  employeeScoreId String        @map("employee_score_id")
  employeeScore   EmployeeScore @relation(fields: [employeeScoreId], references: [id], onDelete: Cascade)

  fromBand Band @map("from_band")
  toBand   Band @map("to_band")

  /// §10.5 — mandatory. CHECK-constrained non-blank in the migration.
  reason String

  adjustedByEmployeeId String   @map("adjusted_by_employee_id")
  adjustedByEmployee   Employee @relation("CalibrationAuthor", fields: [adjustedByEmployeeId], references: [id])
  adjustedAt           DateTime @default(now()) @map("adjusted_at")

  createdAt DateTime @default(now())

  @@index([employeeScoreId, adjustedAt])
  @@map("calibration_adjustments")
}

/// §13.2 — "Employee results are hidden entirely until HR Super Admin explicitly
/// publishes them … Publish is all-at-once, cycle-wide … Publish is reversible
/// (un-publish), and reversal is audited (who, when, why)."
///
/// One row per cycle, holding the CURRENT state; the audit trail carries the
/// history of publishing and un-publishing.
model CyclePublication {
  id      String           @id @default(cuid())
  cycleId String           @unique @map("cycle_id")
  cycle   PerformanceCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  published   Boolean   @default(false)
  publishedAt DateTime? @map("published_at")

  publishedByEmployeeId String?   @map("published_by_employee_id")
  publishedByEmployee   Employee? @relation("PublicationAuthor", fields: [publishedByEmployeeId], references: [id])

  /// §13.2 — reversal is audited with a reason. Held here as the CURRENT
  /// explanation; every transition is also an audit row.
  lastReason String? @map("last_reason")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("cycle_publications")
}

// ---------------------------------------------------------------------------
// §12 — the edge cases the annual cycle actually runs into.
// ---------------------------------------------------------------------------

/// §12.1/§12.2 — why a reporting line moved, and whether it is settled.
enum RollUpReason {
  /// §12.1 — "Direct reports auto-roll-up one level (to the departed manager's
  /// own manager) until HR reassigns a permanent manager."
  LEAVER_ROLLUP
  /// HR moved the line deliberately. Recorded for the same audit reason, but it
  /// is not a prompt — nobody needs to be reminded to finish it.
  HR_REASSIGNMENT
}

/// §12.2 — "HR gets a VISIBLE PROMPT for temporary roll-ups ('reports
/// temporarily rolled up — needs a permanent manager') so they don't silently
/// persist."
///
/// The prompt needs somewhere to live between the departure and HR's decision,
/// and `Employee.managerId` alone cannot carry it: after the roll-up the column
/// looks exactly like a permanent line. This model is the difference between
/// "this person reports to X" and "this person reports to X *for now*".
///
/// The reporting line itself still moves on `Employee.managerId` — §7.2 and
/// §12.2 both define manager-of-record as whoever currently holds the
/// relationship, and a roll-up that left the column pointing at a leaver would
/// give the departed manager the sign-off (and give the new one nothing).
model ManagerRollUp {
  id String @id @default(cuid())

  /// The REPORT whose line moved — not the manager who left.
  employeeId String   @map("employee_id")
  employee   Employee @relation("RollUpSubject", fields: [employeeId], references: [id], onDelete: Cascade)

  /// Null when the employee had no manager before (top of tree).
  fromManagerEmployeeId String?   @map("from_manager_employee_id")
  fromManagerEmployee   Employee? @relation("RollUpFrom", fields: [fromManagerEmployeeId], references: [id])

  /// Null when the roll-up found nobody above the departed manager — the report
  /// is temporarily unmanaged, which is precisely the case HR must see.
  toManagerEmployeeId String?   @map("to_manager_employee_id")
  toManagerEmployee   Employee? @relation("RollUpTo", fields: [toManagerEmployeeId], references: [id])

  reason RollUpReason

  /// Set when HR names a permanent manager. Until then this row IS the prompt.
  resolvedAt           DateTime? @map("resolved_at")
  resolvedByEmployeeId String?   @map("resolved_by_employee_id")
  resolvedByEmployee   Employee? @relation("RollUpResolver", fields: [resolvedByEmployeeId], references: [id])
  /// What HR decided. Optional: confirming the roll-up as permanent needs no
  /// explanation, and demanding one would train people to type "n/a".
  resolutionNote       String?   @map("resolution_note")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One OPEN roll-up per employee, enforced by a partial unique index in the
  /// migration (`WHERE resolved_at IS NULL`). Two managers leaving above the
  /// same person in one week must not produce two competing prompts.
  @@index([resolvedAt, createdAt])
  @@index([employeeId, createdAt])
  @@map("manager_roll_ups")
}

/// §12.3 — a slice of the cycle during which the employee sat in one department.
///
/// "Individual KPIs are split across the two periods: Old department's KPIs
/// cover the pre-transfer period; new department's KPIs cover the post-transfer
/// period. … Proration basis: same calendar-day logic as bonus — each period
/// weighted by days-in-department ÷ 365."
///
/// A transferred employee has TWO of these for the cycle; everyone else has
/// none, and their score runs down the ordinary un-split path. Absence means
/// "no transfer", which keeps the common case free of a row that would need
/// creating and maintaining for the 95% of people who never move.
model EmployeeAssignmentPeriod {
  id String @id @default(cuid())

  employeeId String   @map("employee_id")
  employee   Employee @relation("AssignmentPeriodEmployee", fields: [employeeId], references: [id], onDelete: Cascade)

  cycleId String           @map("cycle_id")
  cycle   PerformanceCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  /// Where they sat during this period. Null department is §1.2's C-Level case,
  /// which is why entity is separate and NOT NULL — §12.3 says the departmental
  /// AND corporate components both follow the periods.
  departmentId String?     @map("department_id")
  department   Department? @relation(fields: [departmentId], references: [id])
  entityId     String      @map("entity_id")
  entity       OrgEntity   @relation(fields: [entityId], references: [id])

  /// Who drafts and assesses THIS portion. §12.3 — "Each department's manager
  /// drafts and assesses their own portion's KPIs; HR signs off / consolidates
  /// (neither manager owns the full year)." Snapshotted rather than resolved
  /// live, because the whole point of the split is that the old manager keeps
  /// authority over the old period after the employee has left their team.
  managerEmployeeId String?   @map("manager_employee_id")
  managerEmployee   Employee? @relation("AssignmentPeriodManager", fields: [managerEmployeeId], references: [id])

  /// Inclusive, both ends — the same calendar-day convention §11.4 uses, so the
  /// two periods' day counts sum to the cycle's own.
  startsOn DateTime @map("starts_on") @db.Date
  endsOn   DateTime @map("ends_on") @db.Date

  orderIndex Int @default(0) @map("order_index")

  kpis Kpi[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, cycleId, orderIndex])
  @@index([cycleId, employeeId])
  @@map("employee_assignment_periods")
}
