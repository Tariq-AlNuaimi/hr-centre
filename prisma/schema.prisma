generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// -- Enums --

enum Role {
  ADMIN
  EDITOR
  VIEWER
}

// -- Vibe Inspector: website E2E testing tool (ADR-016) --

// The testing dimensions a run can cover. Stored on Assessment.dimensions as a
// String[] of these names (Prisma enum arrays are supported on Postgres).
enum TestDimension {
  DESIGN // visual / UX fidelity + accessibility
  FUNCTIONALITY // flows, buttons, broken links, runtime errors, behavior vs BRD
  BRD_COVERAGE // requirement-by-requirement traceability against the scope
  SECURITY // lightweight: TLS, headers, exposed info (NOT a pentest)
  BENCHMARK // comparison vs named peer products (advisory / judgment)
}

enum RunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

// Per-dimension verdict + per-run rollup.
enum ResultStatus {
  PASS
  WARN
  FAIL
}

enum Severity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFO
}

// BRD requirement coverage verdict.
enum CoverageStatus {
  MET
  PARTIAL
  MISSING
}

// The AI backend Vibe Inspector uses for analysis (ADR-016).
enum AiProvider {
  ANTHROPIC // Claude native (Anthropic SDK)
  OPENAI_COMPATIBLE // any /chat/completions endpoint: self-hosted LiteLLM, OpenAI, OpenRouter, Gemini-compat
}

// -- Auth.js Models --

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  passwordHash  String?
  image         String?
  role          Role      @default(VIEWER)
  lastLoginAt   DateTime?

  // Soft deletion
  deletedAt     DateTime?
  deletedBy     String?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  auditLogs     AuditLog[]
  assessments   Assessment[]

  // The soft-delete extension filters `deletedAt: null` on every list/count and
  // the default list sorts by createdAt desc -- a composite (deletedAt, createdAt)
  // index serves both the filter prefix and the sort. Scaffolded soft-deletable
  // models get the same (see scripts/scaffold-entity.mjs).
  @@index([deletedAt, createdAt])
  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// -- Audit --

model AuditLog {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  action     String   // CREATE, UPDATE, DELETE, RESTORE
  before     Json?
  after      Json?
  changes    Json?
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  ipAddress  String?
  userAgent  String?
  timestamp  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId])
  @@index([timestamp])
  @@map("audit_logs")
}

// -- Vibe Inspector models (ADR-016) --

// A configured target: the website under test + the BRD/scope it's judged against.
// User-facing CRUD entity -> soft-delete + audit + RBAC (registered in
// lib/prisma/soft-delete-extension.ts + lib/prisma/recyclable.ts).
model Assessment {
  id         String          @id @default(cuid())
  name       String
  targetUrl  String
  brdText    String          @db.Text
  dimensions TestDimension[]

  ownerId String?
  owner   User?   @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  runs TestRun[]

  // Soft deletion
  deletedAt DateTime?
  deletedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Composite index serves the soft-delete filter prefix + the default createdAt-desc sort.
  @@index([deletedAt, createdAt])
  @@map("assessments")
}

// One execution of an assessment. Run artifacts (results/findings/coverage) are
// machine-generated and cascade-delete with the run.
model TestRun {
  id           String       @id @default(cuid())
  assessmentId String
  assessment   Assessment   @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  status       RunStatus    @default(PENDING)
  overallScore Float? // 0-100, average of dimension scores
  summary      String?      @db.Text
  error        String?      @db.Text // populated on FAILED
  finalUrl     String? // URL after redirects, captured at run time
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime     @default(now())

  dimensionResults DimensionResult[]
  requirements     RequirementCoverage[]

  @@index([assessmentId, createdAt])
  @@map("test_runs")
}

model DimensionResult {
  id        String        @id @default(cuid())
  runId     String
  run       TestRun       @relation(fields: [runId], references: [id], onDelete: Cascade)
  dimension TestDimension
  score     Float? // 0-100
  status    ResultStatus  @default(WARN)
  summary   String        @db.Text
  createdAt DateTime      @default(now())

  findings Finding[]

  @@index([runId])
  @@map("dimension_results")
}

model Finding {
  id                String          @id @default(cuid())
  dimensionResultId String
  dimensionResult   DimensionResult @relation(fields: [dimensionResultId], references: [id], onDelete: Cascade)
  severity          Severity        @default(MEDIUM)
  title             String
  detail            String          @db.Text
  recommendation    String?         @db.Text
  evidence          String?         @db.Text // selector / URL / quote backing the finding
  createdAt         DateTime        @default(now())

  @@index([dimensionResultId])
  @@map("findings")
}

model RequirementCoverage {
  id          String         @id @default(cuid())
  runId       String
  run         TestRun        @relation(fields: [runId], references: [id], onDelete: Cascade)
  requirement String         @db.Text
  status      CoverageStatus @default(MISSING)
  evidence    String?        @db.Text
  createdAt   DateTime       @default(now())

  @@index([runId])
  @@map("requirement_coverage")
}

// Singleton (id = "singleton") app-level AI provider configuration, set via
// Settings. Lets the operator point Vibe Inspector at Claude (native) or any
// OpenAI-compatible endpoint (self-hosted LiteLLM, OpenAI, Gemini-compat) without
// redeploying. `apiKeyEnc` is the API key encrypted at rest (AES-256-GCM via
// lib/secret-box) — Restricted: scrubbed from audit (SCRUB_FIELDS) and never
// returned to the client. When no row exists, the engine falls back to env
// (ANTHROPIC_API_KEY / ANTHROPIC_MODEL). See ADR-016.
model AiProviderConfig {
  id        String     @id @default("singleton")
  provider  AiProvider @default(ANTHROPIC)
  baseUrl   String? // required for OPENAI_COMPATIBLE
  model     String
  apiKeyEnc String?    @db.Text // AES-256-GCM ciphertext; null = use env fallback
  updatedBy String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("ai_provider_config")
}

// Singleton browser-engine (Browserbase) configuration, set via Settings. Lets the
// operator enter the Browserbase API key + project id in-app instead of as env vars.
// apiKeyEnc is AES-256-GCM ciphertext (Restricted: scrubbed from audit via the
// shared "apiKeyEnc" SCRUB_FIELDS entry, never returned to the client). When no row
// exists, capture falls back to env (BROWSERBASE_API_KEY / BROWSERBASE_PROJECT_ID).
// See ADR-016.
model BrowserEngineConfig {
  id        String   @id @default("singleton")
  projectId String? // Browserbase project id (an identifier, not a secret)
  apiKeyEnc String?  @db.Text // AES-256-GCM ciphertext; null = use env fallback
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("browser_engine_config")
}
