// ============================================================================
// JML S2 — the case engine (docs/blueprints/jml.md D6): one case header, one
// task engine, one assignment-rule model, one email queue. Vocabulary is kept
// verbatim from the two source artifacts (Onboarding §7.4 forbids renaming).
// ============================================================================

enum JmlCaseType {
  JOIN // HR Onboarding ONBOARDING
  MOVE // HR Onboarding INTERNAL_CHANGE
  LEAVE // HR Offboarding exit case
}

/// Union of both artifacts' statuses. JOIN/MOVE end COMPLETED (Onboarding);
/// LEAVE ends CLOSED (Offboarding). ARCHIVED never deletes (F1 fixed).
enum JmlCaseStatus {
  DRAFT
  ACTIVE
  AT_RISK
  PENDING_SETTLEMENT
  COMPLETED
  CLOSED
  CANCELLED
  ARCHIVED
}

/// JOIN/MOVE: Onboarding §10.2 (COMPLETED system-only). LEAVE: Offboarding §6.3.
enum JmlStage {
  PREBOARDING
  FIRST_DAY
  FIRST_WEEK
  COMPLETED
  STAGE_1_RESIGNATION
  STAGE_2_IMMEDIATE
  STAGE_3_NOTICE_HANDOVER
  STAGE_4_SETTLEMENT
}

/// Offboarding §9.6's fourteen + Onboarding's WAITING_EXTERNAL. Onboarding's
/// WAITING_EMPLOYEE/IT/PRO carry the same labels ("Waiting for employee"…).
enum JmlTaskStatus {
  NOT_STARTED
  IN_PROGRESS
  WAITING_FOR_EMPLOYEE
  WAITING_FOR_IT
  WAITING_FOR_PRO
  WAITING_FOR_EXTERNAL
  WAITING_FOR_LINE_MANAGER
  WAITING_FOR_FINANCE
  WAITING_FOR_ADMIN
  WAITING_FOR_MOL_COORDINATOR
  WAITING_FOR_APPROVAL
  COMPLETED
  NOT_APPLICABLE
  DELAYED
  CANCELLED
}

enum JmlTaskSource {
  TEMPLATE
  MANUAL
  REVERSAL
}

/// The anchor a task's due date is offset from.
enum JmlDateBasis {
  START_DATE // JOIN: planned start
  EFFECTIVE_DATE // MOVE
  NOTICE_START
  LAST_PHYSICAL_WORKING_DAY
  LAST_DAY_OF_SERVICE
  DEPARTURE_DATE
}

/// Onboarding offsets are calendar days rolled off a day off; Offboarding's are working days.
enum JmlOffsetUnit {
  CALENDAR_DAYS
  WORKING_DAYS
}

enum JmlComplianceCategory {
  ROP_CLEARANCE
  VISA
  MOL
  OTHER
}

enum JmlRuleScope {
  COMPANY
  DIRECTORATE
  DEPARTMENT
}

enum JmlEmailStatus {
  QUEUED
  SENT
  FAILED
  CANCELLED
}

enum JmlRagFlag {
  GREEN
  AMBER
  RED
}

/// Onboarding internal-change types (verbatim HR list).
enum JmlChangeType {
  INTERNSHIP_TO_TRAINING
  INTERNSHIP_TO_EMPLOYMENT
  TRAINING_TO_EMPLOYMENT
  DEPARTMENT_TRANSFER
}

/// Offboarding §6.1.
enum LeaveExitType {
  RESIGNATION
  TERMINATION
  CONTRACT_EXPIRY
  PROBATION_EXIT
  SUMMARY_DISMISSAL
}

/// Offboarding template scope: FULL iff permanent full-time (BR-OFF-006).
enum JmlEmploymentScope {
  FULL
  LIGHT
  ANY
}

/// The nationality BRANCH (not a passport), Offboarding §19.2.
enum JmlNationalityScope {
  OMANI
  EXPATRIATE
  ANY
}

/// One case — a joiner, a mover or a leaver — always about a core Employee.
model JmlCase {
  id       String        @id @default(cuid())
  /// ONB-YYYY-NNNN / CHG-YYYY-NNNN / EXIT-YYYY-NNNN — immutable.
  caseRef  String        @unique @map("case_ref")
  caseType JmlCaseType   @map("case_type")
  status   JmlCaseStatus @default(DRAFT)
  stage    JmlStage

  employeeId String   @map("employee_id")
  employee   Employee @relation("JmlCaseSubject", fields: [employeeId], references: [id], onDelete: Restrict)

  /// Exactly one owner (BR-002 / BR-OFF-002), from the assignment rule.
  hrOwnerUserId  String? @map("hr_owner_user_id")
  hrOwner        User?   @relation("JmlCaseOwner", fields: [hrOwnerUserId], references: [id], onDelete: Restrict)
  /// The paired senior from the rule at activation (escalations, recalculation notices).
  seniorHrUserId String? @map("senior_hr_user_id")
  seniorHr       User?   @relation("JmlCaseSenior", fields: [seniorHrUserId], references: [id], onDelete: SetNull)

  /// Pinned at activation, never updated (BR-016 / BR-OFF-026).
  templateId String?          @map("template_id")
  template   JmlTaskTemplate? @relation(fields: [templateId], references: [id], onDelete: Restrict)

  completionPct Int        @default(0) @map("completion_pct")
  ragFlag       JmlRagFlag @default(GREEN) @map("rag_flag")
  /// Optimistic concurrency (Offboarding AC-6.2).
  version       Int        @default(0)

  activatedAt             DateTime? @map("activated_at")
  completedAt             DateTime? @map("completed_at")
  closedAt                DateTime? @map("closed_at")
  cancelledAt             DateTime? @map("cancelled_at")
  cancelReason            String?   @map("cancel_reason")
  duplicateOverrideReason String?   @map("duplicate_override_reason")

  archivedAt   DateTime? @map("archived_at")
  archivedById String?   @map("archived_by_id")
  archivedBy   User?     @relation("JmlCaseArchivedBy", fields: [archivedById], references: [id], onDelete: SetNull)

  lastUpdatedById String? @map("last_updated_by_id")
  lastUpdatedBy   User?   @relation("JmlCaseLastUpdatedBy", fields: [lastUpdatedById], references: [id], onDelete: SetNull)

  legalHold       Boolean   @default(false) @map("legal_hold")
  legalHoldReason String?   @map("legal_hold_reason")
  legalHoldAt     DateTime? @map("legal_hold_at")
  legalHoldById   String?   @map("legal_hold_by_id")
  legalHoldBy     User?     @relation("JmlCaseLegalHold", fields: [legalHoldById], references: [id], onDelete: SetNull)
  anonymisedAt    DateTime? @map("anonymised_at")

  tasks          JmlTask[]
  emailLogs      JmlEmailLog[]
  /// JML S3 — the joiner details of a JOIN case.
  joinDetail     JmlJoinDetail?
  /// JML S4 — the change of a MOVE case.
  moveDetail     JmlMoveDetail?
  /// JML S5 — the leaver side.
  leaveDetail    LeaveCaseDetail?
  interview      LeaveExitInterview?
  settlement     LeaveSettlement?
  approvals      JmlApproval[]
  assetsIssued   JmlAsset[]                @relation("JmlAssetIssuedOn")
  assetsReturned JmlAsset[]                @relation("JmlAssetReturnedOn")
  accessItems    JmlAccessItem[]
  gateRecords    LeaveGateRecord[]
  incidents      LeaveComplianceIncident[]

  /// Soft delete — a discarded DRAFT only. Archive is a status, never a delete.
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([deletedAt, createdAt])
  @@index([caseType, status])
  @@index([status, stage])
  @@index([hrOwnerUserId, status])
  @@index([employeeId, caseType, status])
  @@index([status, legalHold, anonymisedAt])
  @@map("jml_cases")
}

/// A checklist template (Onboarding ChecklistTemplate ∪ Offboarding TaskTemplate).
/// Editing cuts a new version; cases pin the version they were created from.
model JmlTaskTemplate {
  id               String              @id @default(cuid())
  name             String
  version          Int                 @default(1)
  active           Boolean             @default(true)
  caseType         JmlCaseType         @map("case_type")
  /// MOVE only.
  changeType       JmlChangeType?      @map("change_type")
  /// JOIN/MOVE selection criteria (Onboarding BR-004): strict keys companyId,
  /// employmentType, contractTypeId, nationality, workLocation. Never compensation.
  criteria         Json                @default("{}")
  /// LEAVE selection (Offboarding BR-OFF-006).
  employmentScope  JmlEmploymentScope  @default(ANY) @map("employment_scope")
  nationalityScope JmlNationalityScope @default(ANY) @map("nationality_scope")
  tasks            JmlTemplateTask[]
  cases            JmlCase[]
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  @@unique([name, version])
  @@index([caseType, changeType, active])
  @@map("jml_task_templates")
}

model JmlTemplateTask {
  id                     String                 @id @default(cuid())
  templateId             String                 @map("template_id")
  template               JmlTaskTemplate        @relation(fields: [templateId], references: [id], onDelete: Cascade)
  code                   String
  name                   String
  stage                  JmlStage
  sortOrder              Int                    @default(0) @map("sort_order")
  dateBasis              JmlDateBasis           @map("date_basis")
  offsetDays             Int                    @default(0) @map("offset_days")
  offsetUnit             JmlOffsetUnit          @map("offset_unit")
  mandatory              Boolean                @default(true)
  blocking               Boolean                @default(false)
  confirmationRequired   Boolean                @default(false) @map("confirmation_required")
  defaultConfirmingParty String?                @map("default_confirming_party")
  reversalFlag           Boolean                @default(false) @map("reversal_flag")
  dependsOnCodes         String[]               @default([]) @map("depends_on_codes")
  statutory              Boolean                @default(false)
  complianceCategory     JmlComplianceCategory? @map("compliance_category")
  /// JOIN/MOVE conditions (Onboarding §14): per fact {in?, notIn?}.
  conditions             Json                   @default("{}")
  /// LEAVE applicability (Offboarding §8.4): empty = every exit type.
  appliesToExitTypes     LeaveExitType[]        @default([]) @map("applies_to_exit_types")
  appliesToNationality   JmlNationalityScope    @default(ANY) @map("applies_to_nationality")
  /// null = regardless of whether a settlement applies.
  appliesToSettlement    Boolean?               @map("applies_to_settlement")
  createdAt              DateTime               @default(now()) @map("created_at")
  updatedAt              DateTime               @updatedAt @map("updated_at")

  @@unique([templateId, code])
  @@index([templateId, stage, sortOrder])
  @@map("jml_template_tasks")
}

/// A task on a case — the union of Onboarding ChecklistTask and Offboarding OffboardingTask.
model JmlTask {
  id                    String                 @id @default(cuid())
  caseId                String                 @map("case_id")
  case                  JmlCase                @relation(fields: [caseId], references: [id], onDelete: Cascade)
  /// Immutable: template code, M-NN (manual) or REV-<code> (reversal).
  code                  String
  name                  String
  stage                 JmlStage
  sortOrder             Int                    @default(0) @map("sort_order")
  source                JmlTaskSource          @default(TEMPLATE)
  status                JmlTaskStatus          @default(NOT_STARTED)
  dateBasis             JmlDateBasis?          @map("date_basis")
  offsetDays            Int?                   @map("offset_days")
  offsetUnit            JmlOffsetUnit?         @map("offset_unit")
  dueDate               DateTime?              @map("due_date") @db.Date
  dueDateOverrideReason String?                @map("due_date_override_reason")
  ownerUserId           String?                @map("owner_user_id")
  owner                 User?                  @relation("JmlTaskOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  mandatory             Boolean                @default(true)
  blocking              Boolean                @default(false)
  confirmationRequired  Boolean                @default(false) @map("confirmation_required")
  confirmingParty       String?                @map("confirming_party")
  confirmationDate      DateTime?              @map("confirmation_date") @db.Date
  externalReference     String?                @map("external_reference")
  reversalFlag          Boolean                @default(false) @map("reversal_flag")
  isReversal            Boolean                @default(false) @map("is_reversal")
  reversalOfId          String?                @unique @map("reversal_of_id")
  reversalOf            JmlTask?               @relation("JmlTaskReversal", fields: [reversalOfId], references: [id], onDelete: SetNull)
  reversedBy            JmlTask?               @relation("JmlTaskReversal")
  dependsOnCodes        String[]               @default([]) @map("depends_on_codes")
  notApplicableReason   String?                @map("not_applicable_reason")
  delayReason           String?                @map("delay_reason")
  statutory             Boolean                @default(false)
  complianceCategory    JmlComplianceCategory? @map("compliance_category")
  complianceDeadline    DateTime?              @map("compliance_deadline") @db.Date
  /// The conditions that admitted this task (Onboarding §14), null if unconditional.
  conditionSource       Json?                  @map("condition_source")
  lastReminderAt        DateTime?              @map("last_reminder_at")
  completedAt           DateTime?              @map("completed_at")
  completedById         String?                @map("completed_by_id")
  completedBy           User?                  @relation("JmlTaskCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)
  /// Optimistic concurrency for task completion (Offboarding AC-6.2).
  version               Int                    @default(0)
  comments              JmlTaskComment[]
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")

  @@unique([caseId, code])
  @@index([caseId, stage, sortOrder])
  @@index([status, dueDate])
  @@index([ownerUserId, status, dueDate])
  @@index([statutory, complianceDeadline])
  @@map("jml_tasks")
}

/// Insert-only (Onboarding §10.3, Offboarding §9.6: not editable after submission).
model JmlTaskComment {
  id        String   @id @default(cuid())
  taskId    String   @map("task_id")
  task      JmlTask  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  body      String
  authorId  String?  @map("author_id")
  author    User?    @relation("JmlTaskCommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([taskId, createdAt])
  @@map("jml_task_comments")
}

/// Who owns a case (Onboarding §14 / BR-002): scoped with priority; most specific
/// level wins (department > directorate > company), then priority, then oldest.
model JmlHrAssignmentRule {
  id             String        @id @default(cuid())
  scope          JmlRuleScope
  /// The company / directorate / department id the rule covers.
  scopeId        String        @map("scope_id")
  priority       Int           @default(0)
  active         Boolean       @default(true)
  /// Empty = every case type.
  caseTypes      JmlCaseType[] @default([]) @map("case_types")
  juniorHrUserId String        @map("junior_hr_user_id")
  juniorHr       User          @relation("JmlRuleOwner", fields: [juniorHrUserId], references: [id], onDelete: Restrict)
  seniorHrUserId String        @map("senior_hr_user_id")
  seniorHr       User          @relation("JmlRuleSenior", fields: [seniorHrUserId], references: [id], onDelete: Restrict)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  @@index([active, scope, priority])
  @@index([scopeId])
  @@map("jml_hr_assignment_rules")
}

/// HR's approved legal contract kinds (Onboarding ContractType; seeded EMPTY —
/// activation is refused until HR enters at least one, §7.4).
model JmlContractType {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String   @unique
  sortOrder Int      @default(0) @map("sort_order")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  joiners JmlJoinDetail[]

  @@index([active, sortOrder])
  @@map("jml_contract_types")
}

/// Per employment type: offered on new hires, suggested template, payroll default
/// (Onboarding EmploymentTypeConfig — and now actually read by the joiner form, 8.4.10).
model JmlEmploymentTypeConfig {
  id                       String       @id @default(cuid())
  employmentType           ContractType @unique @map("employment_type")
  active                   Boolean      @default(true)
  defaultTemplateId        String?      @map("default_template_id")
  payrollApplicableDefault Boolean      @default(true) @map("payroll_applicable_default")
  notes                    String?
  sortOrder                Int          @default(0) @map("sort_order")
  createdAt                DateTime     @default(now()) @map("created_at")
  updatedAt                DateTime     @updatedAt @map("updated_at")

  @@map("jml_employment_type_configs")
}

/// Queued email (Onboarding §11). NO body column, ever (§11.3) — rendered at send.
model JmlEmailLog {
  id            String         @id @default(cuid())
  type          String
  recipient     String
  cc            String?
  subject       String
  status        JmlEmailStatus @default(QUEUED)
  scheduledFor  DateTime       @map("scheduled_for")
  sentAt        DateTime?      @map("sent_at")
  failureReason String?        @map("failure_reason")
  caseId        String?        @map("case_id")
  case          JmlCase?       @relation(fields: [caseId], references: [id], onDelete: Cascade)
  sentById      String?        @map("sent_by_id")
  sentBy        User?          @relation("JmlEmailSentBy", fields: [sentById], references: [id], onDelete: SetNull)
  resendOfId    String?        @map("resend_of_id")
  resendOf      JmlEmailLog?   @relation("JmlEmailResend", fields: [resendOfId], references: [id], onDelete: SetNull)
  resends       JmlEmailLog[]  @relation("JmlEmailResend")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  @@index([status, scheduledFor])
  @@index([caseId, createdAt])
  @@map("jml_email_logs")
}

/// Admin edits shadowing the approved email copy (Onboarding §11 override layer).
model JmlEmailTemplateOverride {
  id           String   @id @default(cuid())
  type         String   @unique
  subject      String?
  body         String?
  ccRecipients String[] @default([]) @map("cc_recipients")
  updatedById  String?  @map("updated_by_id")
  updatedBy    User?    @relation("JmlEmailTemplateEditor", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("jml_email_template_overrides")
}

/// JML S3 — what a JOIN case knows that the core employee record does not
/// (HR Onboarding `NewHire`, minus everything the core record already holds:
/// name, emails, phone, nationality, placement, job title, employment type,
/// work location, line manager and salary live on the PRE_JOINER `Employee`).
/// No ID numbers or bank details, ever (ADR-078).
model JmlJoinDetail {
  caseId String  @id @map("case_id")
  case   JmlCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  contractTypeId String?          @map("contract_type_id")
  contractType   JmlContractType? @relation(fields: [contractTypeId], references: [id], onDelete: Restrict)

  plannedStartDate  DateTime? @map("planned_start_date") @db.Date
  /// Set once by "Confirm actual start" (AC-7.2/7.3).
  actualStartDate   DateTime? @map("actual_start_date") @db.Date
  contractStartDate DateTime? @map("contract_start_date") @db.Date
  contractEndDate   DateTime? @map("contract_end_date") @db.Date
  probationMonths   Int?      @map("probation_months")

  payrollApplicable  Boolean  @default(true) @map("payroll_applicable")
  clientAssignedRole Boolean? @map("client_assigned_role")
  introSentence      String?  @map("intro_sentence")
  hobbies            String?

  /// NULL = not answered; activation refuses NULL; `false` is an answer.
  msAccountRequired  Boolean? @map("ms_account_required")
  laptopRequired     Boolean? @map("laptop_required")
  accessCardRequired Boolean? @map("access_card_required")

  /// Onboarding 8.4.5 fixed: written by "Confirm IT readiness".
  itReadinessConfirmed Boolean   @default(false) @map("it_readiness_confirmed")
  itReadinessAt        DateTime? @map("it_readiness_at")
  itReadinessById      String?   @map("it_readiness_by_id")
  itReadinessBy        User?     @relation("JmlItReadinessBy", fields: [itReadinessById], references: [id], onDelete: SetNull)

  /// IT intake (Onboarding §11.2 row 2) — off unless configured and approved.
  itIntakeSubmittedAt DateTime? @map("it_intake_submitted_at")
  itIntakeReference   String?   @map("it_intake_reference")
  itIntakeError       String?   @map("it_intake_error")

  /// Idempotency key of the module that opened the case (Hiring: `hiring:<candidateId>`).
  sourceRef String? @unique @map("source_ref")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([plannedStartDate])
  @@map("jml_join_details")
}

/// JML S4 — what a MOVE case changes (HR Onboarding INTERNAL_CHANGE, R1–R10).
/// The new details are APPLIED to the employee when the case completes (D9),
/// not when it opens — so cancelling needs no revert. Salary is never part of a
/// change (R10).
model JmlMoveDetail {
  caseId String  @id @map("case_id")
  case   JmlCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  changeType    JmlChangeType @map("change_type")
  effectiveDate DateTime      @map("effective_date") @db.Date

  /// `{field: {value, label}}` of the changed fields only, labels resolved at creation.
  previousDetails Json @map("previous_details")
  newDetails      Json @map("new_details")

  /// When the change reached the employee record, and how (e.g. the performance-year split).
  appliedAt DateTime? @map("applied_at")
  applyNote String?   @map("apply_note")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([effectiveDate])
  @@map("jml_move_details")
}

enum LeaveExitSubtype {
  PERFORMANCE
  CONDUCT
  BUSINESS
  OTHER
}

/// The nationality BRANCH of an exit (Offboarding `Nationality`), derived from the
/// employee's nationality and snapshotted on the case — not the passport.
enum LeaveNationality {
  OMANI
  EXPATRIATE
}

enum LeaveBackfillDecision {
  BACKFILL
  RELEASE
  DEFERRED
  PENDING
}

enum LeaveRehireEligibility {
  YES
  CONDITIONAL
  NO
}

enum JmlApprovalType {
  EXIT_CONFIRMATION
  TERMINATION_AUTHORISATION
  EARLY_RELEASE_VIA_LEAVE
  BACKFILL_DECISION
  FINAL_SETTLEMENT_APPROVAL
}

enum JmlApprovalStatus {
  PENDING
  GRANTED
  REJECTED
}

/// Offboarding §9.8.2 — the nine access domains.
enum JmlAccessDomain {
  IDENTITY
  COMMUNICATION
  NETWORK
  CODE_AND_INFRASTRUCTURE
  DATA
  THIRD_PARTY_AND_SAAS
  SHARED_CREDENTIALS
  PHYSICAL
  EXTERNAL_FACING
}

/// One register: access GRANTED at a join, REVOKED at a leave.
enum JmlAccessDirection {
  GRANT
  REVOKE
}

/// JML S5 — the leaver-only facts of a LEAVE case (HR Offboarding `ExitCase`
/// minus the shared header). Employee facts are read from the core record and
/// SNAPSHOTTED here, because reports attribute an exit to the person and org as
/// they were at exit.
model LeaveCaseDetail {
  caseId String  @id @map("case_id")
  case   JmlCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  exitType                   LeaveExitType     @map("exit_type")
  exitSubtype                LeaveExitSubtype? @map("exit_subtype")
  employmentTypeAtExit       ContractType?     @map("employment_type_at_exit")
  nationality                LeaveNationality
  noticeStartDate            DateTime          @map("notice_start_date") @db.Date
  noticePeriodDays           Int               @map("notice_period_days")
  /// Persisted (Offboarding validated it and threw it away).
  noticePeriodOverrideReason String?           @map("notice_period_override_reason")
  lastPhysicalWorkingDay     DateTime?         @map("last_physical_working_day") @db.Date
  /// = the core `Employee.lastWorkingDay` once the departure is applied (D7).
  lastDayOfService           DateTime?         @map("last_day_of_service") @db.Date
  departureDate              DateTime?         @map("departure_date") @db.Date
  earlyReleaseApproved       Boolean           @default(false) @map("early_release_approved")
  settlementApplicable       Boolean           @default(true) @map("settlement_applicable")
  visaSupportApplicable      Boolean           @default(false) @map("visa_support_applicable")

  docRefPerformanceHistory String? @map("doc_ref_performance_history")
  docRefWrittenGrounds     String? @map("doc_ref_written_grounds")
  docRefLegalReview        String? @map("doc_ref_legal_review")

  backfillDecision    LeaveBackfillDecision   @default(PENDING) @map("backfill_decision")
  backfillApprovalRef String?                 @map("backfill_approval_ref")
  rehireEligible      LeaveRehireEligibility? @map("rehire_eligible")

  /// Historical import (§26.2): history only — never departs the employee.
  migrated        Boolean @default(false)
  /// No JOIN case existed for the employee when this case was created.
  manuallyCreated Boolean @default(true) @map("manually_created")

  /// Snapshots at creation / activation.
  employeeNameAtExit         String  @map("employee_name_at_exit")
  jobTitleAtExit             String? @map("job_title_at_exit")
  gradeAtExit                String? @map("grade_at_exit")
  positionClassificationName String? @map("position_classification_name")
  entityIdAtExit             String  @map("entity_id_at_exit")
  directorateIdAtExit        String? @map("directorate_id_at_exit")
  departmentIdAtExit         String? @map("department_id_at_exit")
  teamIdAtExit               String? @map("team_id_at_exit")

  /// D13 — the line manager is an employee (approval holder for EXIT_CONFIRMATION / EARLY_RELEASE).
  lineManagerEmployeeId String?   @map("line_manager_employee_id")
  lineManager           Employee? @relation("LeaveLineManager", fields: [lineManagerEmployeeId], references: [id], onDelete: SetNull)

  /// Re-key (§26.1): an exit already in flight at go-live.
  rekeyedAt   DateTime? @map("rekeyed_at")
  rekeyReason String?   @map("rekey_reason")

  /// D7 — the departure milestones (written by the sweep / closure, slice S6).
  loginRevokedAt     DateTime? @map("login_revoked_at")
  departureAppliedAt DateTime? @map("departure_applied_at")
  departureNote      String?   @map("departure_note")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([lastDayOfService])
  @@index([exitType])
  @@map("leave_case_details")
}

/// §4.3 approvals — all five types, holders referenced by ROLE (AC-11.4).
model JmlApproval {
  id               String            @id @default(cuid())
  caseId           String            @map("case_id")
  case             JmlCase           @relation(fields: [caseId], references: [id], onDelete: Cascade)
  approvalType     JmlApprovalType   @map("approval_type")
  /// "HR Manager" / "Operations Director" / "Line Manager".
  holderRoleKey    String            @map("holder_role_key")
  status           JmlApprovalStatus @default(PENDING)
  requestedAt      DateTime          @default(now()) @map("requested_at")
  decisionDate     DateTime?         @map("decision_date") @db.Date
  reference        String?
  comments         String?
  /// The holder, when the holder is a known employee (the line manager).
  holderEmployeeId String?           @map("holder_employee_id")
  holderEmployee   Employee?         @relation("JmlApprovalHolder", fields: [holderEmployeeId], references: [id], onDelete: SetNull)
  /// The HR user who recorded the decision (the holder may have no login).
  decidedById      String?           @map("decided_by_id")
  decidedBy        User?             @relation("JmlApprovalDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  delegateUsed     Boolean           @default(false) @map("delegate_used")
  secondLevelUsed  Boolean           @default(false) @map("second_level_used")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  @@unique([caseId, approvalType, holderRoleKey])
  @@index([status, requestedAt])
  @@map("jml_approvals")
}

/// Who may stand in for an approval holder (Offboarding ApprovalConfig, with real
/// employee FKs): BR-OFF-021 delegate always, BR-OFF-032 second level for two types.
model JmlApprovalAuthority {
  id                            String          @id @default(cuid())
  approvalType                  JmlApprovalType @unique @map("approval_type")
  holderLabel                   String          @map("holder_label")
  delegateEmployeeId            String?         @map("delegate_employee_id")
  delegate                      Employee?       @relation("JmlAuthorityDelegate", fields: [delegateEmployeeId], references: [id], onDelete: SetNull)
  secondLevelDelegateEmployeeId String?         @map("second_level_delegate_employee_id")
  secondLevelDelegate           Employee?       @relation("JmlAuthoritySecondDelegate", fields: [secondLevelDelegateEmployeeId], references: [id], onDelete: SetNull)
  active                        Boolean         @default(true)
  createdAt                     DateTime        @default(now()) @map("created_at")
  updatedAt                     DateTime        @updatedAt @map("updated_at")

  @@map("jml_approval_authorities")
}

model JmlAssetType {
  id        String     @id @default(cuid())
  label     String     @unique
  active    Boolean    @default(true)
  sortOrder Int        @default(0) @map("sort_order")
  assets    JmlAsset[]
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  @@map("jml_asset_types")
}

/// One register (D6): a physical item issued to an employee (often on a JOIN case)
/// and returned on a LEAVE case.
model JmlAsset {
  id                  String                @id @default(cuid())
  employeeId          String                @map("employee_id")
  employee            Employee              @relation("JmlAssetHolder", fields: [employeeId], references: [id], onDelete: Restrict)
  issuedOnCaseId      String?               @map("issued_on_case_id")
  issuedOnCase        JmlCase?              @relation("JmlAssetIssuedOn", fields: [issuedOnCaseId], references: [id], onDelete: SetNull)
  returnedOnCaseId    String?               @map("returned_on_case_id")
  returnedOnCase      JmlCase?              @relation("JmlAssetReturnedOn", fields: [returnedOnCaseId], references: [id], onDelete: SetNull)
  assetTypeId         String                @map("asset_type_id")
  assetType           JmlAssetType          @relation(fields: [assetTypeId], references: [id], onDelete: Restrict)
  description         String?
  identifier          String?
  issuedDate          DateTime?             @map("issued_date") @db.Date
  conditionAtIssue    String?               @map("condition_at_issue")
  returnDueDate       DateTime?             @map("return_due_date") @db.Date
  returnedDate        DateTime?             @map("returned_date") @db.Date
  conditionAtReturn   String?               @map("condition_at_return")
  deductionApplicable Boolean               @default(false) @map("deduction_applicable")
  /// RESTRICTED money (D14): AES-GCM envelope, bound to the asset id.
  deductionAmountEnc  String?               @map("deduction_amount_enc")
  writtenOff          Boolean               @default(false) @map("written_off")
  writtenOffReason    String?               @map("written_off_reason")
  verifiedById        String?               @map("verified_by_id")
  verifiedBy          User?                 @relation("JmlAssetVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  settlementLines     LeaveSettlementLine[]
  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime              @updatedAt @map("updated_at")

  @@index([employeeId, returnedDate])
  @@index([returnedOnCaseId])
  @@map("jml_assets")
}

/// The access checklist (Offboarding V1, 26 items) — rotation/shared flags are
/// COLUMNS here (the source matched them by label against a constant).
model JmlAccessChecklistItem {
  id               String          @id @default(cuid())
  domain           JmlAccessDomain
  label            String
  rotationRequired Boolean         @default(false) @map("rotation_required")
  sharedCredential Boolean         @default(false) @map("shared_credential")
  active           Boolean         @default(true)
  sortOrder        Int             @default(0) @map("sort_order")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  @@unique([domain, label])
  @@map("jml_access_checklist_items")
}

model JmlAccessItem {
  id               String             @id @default(cuid())
  caseId           String             @map("case_id")
  case             JmlCase            @relation(fields: [caseId], references: [id], onDelete: Cascade)
  employeeId       String             @map("employee_id")
  employee         Employee           @relation("JmlAccessHolder", fields: [employeeId], references: [id], onDelete: Restrict)
  direction        JmlAccessDirection
  domain           JmlAccessDomain
  systemName       String             @map("system_name")
  accessLevel      String?            @map("access_level")
  sharedCredential Boolean            @default(false) @map("shared_credential")
  rotationRequired Boolean            @default(false) @map("rotation_required")
  dueDate          DateTime           @map("due_date") @db.Date
  confirmedDate    DateTime?          @map("confirmed_date") @db.Date
  confirmingParty  String?            @map("confirming_party")
  reference        String?
  confirmedById    String?            @map("confirmed_by_id")
  confirmedBy      User?              @relation("JmlAccessConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  @@index([caseId, domain])
  @@index([dueDate, confirmedDate])
  @@map("jml_access_items")
}

/// §17.3 compliance gates C1–C11 per case (absent record = unsatisfied).
model LeaveGateRecord {
  id             String    @id @default(cuid())
  caseId         String    @map("case_id")
  case           JmlCase   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  gateId         String    @map("gate_id")
  satisfied      Boolean   @default(false)
  satisfiedAt    DateTime? @map("satisfied_at")
  satisfiedById  String?   @map("satisfied_by_id")
  satisfiedBy    User?     @relation("LeaveGateSatisfiedBy", fields: [satisfiedById], references: [id], onDelete: SetNull)
  reference      String?
  overriddenById String?   @map("overridden_by_id")
  overriddenBy   User?     @relation("LeaveGateOverriddenBy", fields: [overriddenById], references: [id], onDelete: SetNull)
  overrideReason String?   @map("override_reason")
  overriddenAt   DateTime? @map("overridden_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@unique([caseId, gateId])
  @@index([overriddenById, overriddenAt])
  @@map("leave_gate_records")
}

/// AC-12.2 — a statutory deadline missed, logged independently of case status.
model LeaveComplianceIncident {
  id         String    @id @default(cuid())
  caseId     String    @map("case_id")
  case       JmlCase   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  kind       String
  gateId     String    @map("gate_id")
  detectedAt DateTime  @map("detected_at")
  deadlineAt DateTime  @map("deadline_at") @db.Date
  daysLate   Int       @map("days_late")
  resolvedAt DateTime? @map("resolved_at")
  note       String?
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@unique([caseId, kind, deadlineAt])
  @@index([kind, resolvedAt])
  @@map("leave_compliance_incidents")
}

// ====================================================================
// JML S6 — leavers part 2: exit interview, final settlement (HR Offboarding
// §12.3–12.4, §16.1). Every money figure and the interview narrative are
// RESTRICTED (D14): sealed AES-GCM envelopes (`*Enc`), scrubbed from audit,
// never exported, redacted by neon-sql.
// ====================================================================

enum LeaveInterviewConducted {
  CONDUCTED
  DECLINED
}

enum LeaveDestinationType {
  COMPETITOR
  SAME_SECTOR
  OTHER_SECTOR
  PUBLIC_SECTOR
  OVERSEAS
  STUDY
  NOT_DISCLOSED
}

enum LeaveRegrettable {
  REGRETTABLE
  NON_REGRETTABLE
  NEUTRAL
}

enum LeavePreventable {
  PREVENTABLE
  NOT_PREVENTABLE
  UNCLEAR
}

/// §12.4 prevention factor (Offboarding derived these from the dissatisfaction codes).
enum LeavePreventionFactor {
  COMPENSATION
  CAREER_PROGRESSION
  MANAGER_RELATIONSHIP
  WORKLOAD_OR_BURNOUT
  RECOGNITION
  ROLE_CONTENT
  LEARNING_AND_DEVELOPMENT
  WORK_LIFE_BALANCE
  ORGANISATIONAL_DIRECTION
  OTHER
}

enum LeaveSettlementLineType {
  ADDITION
  DEDUCTION
}

/// §16.1 deduction types (closed list; each needs a documentary reference).
enum LeaveDeductionType {
  VISA_COST_RECOVERY
  MEDICAL_INSURANCE
  NEGATIVE_LEAVE_BALANCE
  NOTICE_SHORTFALL
  UNRETURNED_OR_DAMAGED_ASSET
  OUTSTANDING_ADVANCE_OR_LOAN
}

/// One exit interview per case (§12.3–12.4). Reason codes are FKs to the
/// configured taxonomy (F9: the database is the truth).
model LeaveExitInterview {
  caseId             String                  @id @map("case_id")
  case               JmlCase                 @relation(fields: [caseId], references: [id], onDelete: Cascade)
  conducted          LeaveInterviewConducted
  primaryL1          LeaveReasonLevel1       @map("primary_l1")
  primaryL2Code      String                  @map("primary_l2_code")
  primaryCode        LeaveReasonCode         @relation("LeavePrimaryReason", fields: [primaryL2Code], references: [code], onDelete: Restrict)
  secondaryL2Code    String?                 @map("secondary_l2_code")
  secondaryCode      LeaveReasonCode?        @relation("LeaveSecondaryReason", fields: [secondaryL2Code], references: [code], onDelete: Restrict)
  /// RESTRICTED (AC-9.3): sealed, never reported or exported.
  narrativeEnc       String?                 @map("narrative_enc")
  destinationType    LeaveDestinationType?   @map("destination_type")
  retentionAttempted Boolean?                @map("retention_attempted")
  counterOfferMade   Boolean?                @map("counter_offer_made")
  recommendScore     Int                     @map("recommend_score")
  returnScore        Int                     @map("return_score")
  interviewedAt      DateTime?               @map("interviewed_at") @db.Date
  interviewerId      String?                 @map("interviewer_id")
  interviewer        User?                   @relation("LeaveInterviewer", fields: [interviewerId], references: [id], onDelete: SetNull)
  regrettable        LeaveRegrettable?
  preventable        LeavePreventable?
  preventionFactor   LeavePreventionFactor?  @map("prevention_factor")
  assessorId         String?                 @map("assessor_id")
  assessor           User?                   @relation("LeaveAssessor", fields: [assessorId], references: [id], onDelete: SetNull)
  assessedAt         DateTime?               @map("assessed_at")
  createdAt          DateTime                @default(now()) @map("created_at")
  updatedAt          DateTime                @updatedAt @map("updated_at")

  @@index([primaryL1, primaryL2Code])
  @@index([regrettable, preventable])
  @@map("leave_exit_interviews")
}

/// The final settlement (§16.1). Figures live in ONE sealed JSON envelope
/// (gratuity pre/post split, leave encashment, outstanding salary, gross,
/// net, basic wage, leave balance) bound to the case id.
model LeaveSettlement {
  caseId                String                @id @map("case_id")
  case                  JmlCase               @relation(fields: [caseId], references: [id], onDelete: Cascade)
  /// RESTRICTED money (D14).
  figuresEnc            String?               @map("figures_enc")
  provisional           Boolean               @default(true)
  unverifiedKeys        String[]              @default([]) @map("unverified_keys")
  hireDate              DateTime?             @map("hire_date") @db.Date
  calculatedAt          DateTime?             @map("calculated_at")
  calculatedById        String?               @map("calculated_by_id")
  calculatedBy          User?                 @relation("LeaveSettlementCalculatedBy", fields: [calculatedById], references: [id], onDelete: SetNull)
  /// Set by a line edit; cleared by a recalculation (the net is stale until then).
  recalculationRequired Boolean               @default(false) @map("recalculation_required")
  signatureReference    String?               @map("signature_reference")
  approvedAt            DateTime?             @map("approved_at")
  approvedById          String?               @map("approved_by_id")
  approvedBy            User?                 @relation("LeaveSettlementApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  paymentDate           DateTime?             @map("payment_date") @db.Date
  paymentReference      String?               @map("payment_reference")
  paymentConfirmedAt    DateTime?             @map("payment_confirmed_at")
  paymentConfirmedById  String?               @map("payment_confirmed_by_id")
  paymentConfirmedBy    User?                 @relation("LeaveSettlementPaymentBy", fields: [paymentConfirmedById], references: [id], onDelete: SetNull)
  lines                 LeaveSettlementLine[]
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")

  @@index([provisional, approvedAt])
  @@map("leave_settlements")
}

model LeaveSettlementLine {
  id                   String                  @id @default(cuid())
  caseId               String                  @map("case_id")
  settlement           LeaveSettlement         @relation(fields: [caseId], references: [caseId], onDelete: Cascade)
  lineType             LeaveSettlementLineType @map("line_type")
  deductionType        LeaveDeductionType?     @map("deduction_type")
  description          String
  /// RESTRICTED money (D14).
  lineAmountEnc        String                  @map("line_amount_enc")
  reasonCode           String                  @map("reason_code")
  documentaryReference String                  @map("documentary_reference")
  authorisedById       String?                 @map("authorised_by_id")
  authorisedBy         User?                   @relation("LeaveLineAuthorisedBy", fields: [authorisedById], references: [id], onDelete: SetNull)
  assetId              String?                 @map("asset_id")
  asset                JmlAsset?               @relation(fields: [assetId], references: [id], onDelete: SetNull)
  createdAt            DateTime                @default(now()) @map("created_at")
  updatedAt            DateTime                @updatedAt @map("updated_at")

  @@index([caseId, lineType])
  @@map("leave_settlement_lines")
}
