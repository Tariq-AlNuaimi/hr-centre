# Caddy reverse proxy + automatic HTTPS (ADR-035 — Docker-first self-host rail).
#
# Site address comes from the APP_DOMAIN env var (Caddy expands {$APP_DOMAIN}):
#   - Set APP_DOMAIN to a real hostname (e.g. app.tenant.example.com) and Caddy
#     obtains + renews a Let's Encrypt certificate automatically over :443.
#   - Leave it at the default `:80` for local production testing (plain HTTP,
#     no cert) — e.g. `APP_DOMAIN=:80` or unset. `localhost` also works for a
#     locally-trusted cert.
#
# All traffic is reverse-proxied to the `app` service on the compose network.

{$APP_DOMAIN::80} {
	encode gzip zstd

	# Security headers (belt-and-suspenders with the app's own headers).
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Don't advertise the server software.
		-Server
	}

	# Client-IP trust boundary (red-team R1). Caddy sets the X-Forwarded-* family
	# but NOT X-Real-IP, and forwards a client-supplied one untouched. The app
	# throttles and audits on this header, so a spoofed value would defeat every
	# rate limit and forge `audit_logs.ipAddress`. Strip whatever the client sent,
	# then set it from the real peer address. Pair with
	# RATE_LIMIT_TRUSTED_IP_HEADER=x-real-ip (lib/client-ip.ts ignores the header
	# entirely unless that env var names it).
	reverse_proxy app:3000 {
		header_up -X-Real-IP
		header_up X-Real-IP {http.request.remote.host}
	}
}

# Enterprise SSO ingress (ADR-045, WS-6) — ONLY meaningful under the `sso` compose
# profile. Ory Polis's OIDC endpoints (/.well-known, /oauth/authorize, /oauth/token)
# and SAML ACS callback must be reachable by the user's browser AND the tenant's
# IdP, so Polis needs PUBLIC ingress. It gets its OWN hostname rather than a path on
# the app domain: Polis serves its own /.well-known and /api/* paths, which would
# collide with the app's.
#   - Set POLIS_DOMAIN to a real hostname (e.g. sso.tenant.example.com); Caddy
#     obtains a Let's Encrypt cert and reverse-proxies to the polis sidecar on :5225.
#   - POLIS_EXTERNAL_URL (compose.prod.yaml) MUST equal https://<POLIS_DOMAIN> so
#     Polis emits issuer/callback URLs that match this served host.
#   - Left at the default `:5226` (an UNPUBLISHED port — the caddy service maps only
#     80/443), this block is inert: correct when the `sso` profile is not running.
{$POLIS_DOMAIN::5226} {
	encode gzip zstd

	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	reverse_proxy polis:5225
}
