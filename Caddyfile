# Caddy reverse proxy + automatic HTTPS (ADR-035 — Docker-first self-host rail).
#
# Site address comes from the APP_DOMAIN env var (Caddy expands {$APP_DOMAIN}):
#   - Set APP_DOMAIN to a real hostname (e.g. app.tenant.example.com) and Caddy
#     obtains + renews a Let's Encrypt certificate automatically over :443.
#   - Leave it at the default `:80` for local production testing (plain HTTP,
#     no cert) — e.g. `APP_DOMAIN=:80` or unset. `localhost` also works for a
#     locally-trusted cert.
#
# All traffic is reverse-proxied to the `app` service on the compose network.

# Global options. `trusted_proxies` is what makes `{http.request.client_ip}`
# meaningful: without it Caddy has no basis to believe any X-Forwarded-For entry,
# and client_ip degrades to the direct peer. `private_ranges` trusts only RFC1918 /
# loopback / link-local peers -- i.e. another proxy on the compose network or a
# same-host LB, never the public internet -- so a client cannot talk its way into
# being believed. Set this to your CDN's published ranges instead if Caddy sits
# behind Cloudflare/Fastly rather than at the edge.
{
	servers {
		trusted_proxies static private_ranges
	}
}

{$APP_DOMAIN::80} {
	encode gzip zstd

	# Security headers (belt-and-suspenders with the app's own headers).
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Don't advertise the server software.
		-Server
	}

	# Client-IP trust boundary (red-team R1). Caddy sets the X-Forwarded-* family
	# but NOT X-Real-IP, and forwards a client-supplied one untouched. The app
	# throttles and audits on this header, so a spoofed value would defeat every
	# rate limit and forge `audit_logs.ipAddress`. Strip whatever the client sent,
	# then set it ourselves. Pair with RATE_LIMIT_TRUSTED_IP_HEADER=x-real-ip
	# (lib/client-ip.ts ignores the header entirely unless that env var names it).
	#
	# `{http.request.client_ip}`, not `{http.request.remote.host}`: remote.host is
	# the DIRECT PEER, which is correct only while Caddy is the outermost hop. Put
	# a CDN or a load balancer in front and every request's peer becomes that hop,
	# so every user collapses onto one IP -- one shared rate-limit bucket and an
	# audit log that records the proxy instead of the client. client_ip resolves
	# through the trusted_proxies chain above and falls back to the peer when the
	# peer is not trusted, so it is correct in BOTH topologies.
	reverse_proxy app:3000 {
		header_up -X-Real-IP
		header_up X-Real-IP {http.request.client_ip}
	}
}
