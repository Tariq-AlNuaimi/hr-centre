{
  "name": "fullstack-next-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --experimental-test-module-mocks --import tsx --test tests/contracts/*.test.ts tests/property/*.test.ts && npm run test:lint-rules",
    "test:property": "node --import tsx --test tests/property/*.test.ts",
    "tokens:build": "node scripts/build-tokens.mjs",
    "tokens": "npx -y ccusage@latest session",
    "test:watch": "node --experimental-test-module-mocks --import tsx --test --watch tests/contracts/*.test.ts",
    "test:lint-rules": "node --import tsx --test tests/eslint-rules/*.test.mjs",
    "test:integration": "node --import tsx --test tests/integration/*.test.ts",
    "test:hooks": "node --test tests/harness/*.test.mjs",
    "context-tax": "node scripts/context-tax.mjs",
    "memory-digest": "node scripts/memory-digest.mjs --write",
    "hook-latency": "node scripts/hook-latency.mjs",
    "fan-out": "node scripts/fan-out.mjs",
    "bdd-coverage": "node scripts/bdd-coverage.mjs",
    "capture": "node scripts/capture-screens.mjs",
    "bdd:gen": "bddgen --config playwright-bdd.config.ts",
    "test:bdd": "bddgen --config playwright-bdd.config.ts && playwright test --config playwright-bdd.config.ts",
    "test:components": "node --import tsx --import global-jsdom/register --import ./tests/components/setup.ts --test tests/components/*.test.tsx",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "prisma:seed": "prisma db seed",
    "prisma:studio": "prisma studio",
    "scaffold": "node scripts/scaffold-entity.mjs",
    "scaffold-ai-endpoint": "node scripts/scaffold-ai-endpoint.mjs",
    "enable:api-reference": "node scripts/enable-api-reference.mjs",
    "enable:docs-site": "node scripts/enable-docs-site.mjs",
    "rebrand": "node scripts/rebrand.mjs",
    "migrate-from": "node scripts/migrate-from.mjs",
    "new-project": "node scripts/new-project.mjs",
    "sync-template": "node scripts/sync-from-template.mjs",
    "repo-map": "node scripts/repo-map.mjs",
    "uat": "UAT_MODE=lean playwright test",
    "uat:full": "UAT_MODE=full playwright test",
    "uat:headed": "UAT_MODE=lean playwright test --headed",
    "uat:report": "playwright show-report uat-report",
    "uat:pdf": "node scripts/uat-pdf.mjs",
    "uat:recommend": "node scripts/uat-recommend.mjs",
    "uat:benchmark": "node scripts/uat-benchmark.mjs",
    "uat:install": "playwright install chromium",
    "manual-uat:matrix": "node scripts/rbac-matrix.mjs",
    "manual-uat:users": "tsx scripts/manual-uat-users.mjs",
    "deploy": "node scripts/deploy.mjs",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "analyze": "ANALYZE=true next build",
    "scan": "npx react-scan@latest http://localhost:3000",
    "lhci": "npx @lhci/cli@latest autorun",
    "ai-eval": "node scripts/ai-eval.mjs",
    "agent-eval": "node scripts/agent-eval.mjs",
    "routing-report": "node scripts/routing-report.mjs",
    "ship": "node scripts/ship.mjs",
    "sbom": "cyclonedx-npm --omit dev --output-format JSON --output-file sbom.json",
    "audit:warn": "npm audit --audit-level=moderate || true",
    "test:coverage": "node --experimental-test-coverage --import tsx --test tests/contracts/*.test.ts",
    "prepare": "husky"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "nodemailer": "^9.0.1",
    "tmp": "^0.2.7",
    "uuid": "^11",
    "postcss": "^8.5.10",
    "@hono/node-server": "^1.19.13",
    "read-yaml-file": "^2.1.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.111.0",
    "@auth/prisma-adapter": "^2.11.1",
    "@dnd-kit/core": "^6.3.1",
    "@hookform/resolvers": "^5.4.0",
    "@node-rs/argon2": "^2.0.2",
    "@opentelemetry/api": "^1.9.1",
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "@radix-ui/react-avatar": "^1.2.2",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-direction": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-switch": "^1.3.3",
    "@sentry/nextjs": "10.65.0",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-table": "^8.21.3",
    "@vercel/otel": "^2.1.3",
    "@vercel/speed-insights": "^2.0.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "ioredis": "^5.11.1",
    "lucide-react": "^1.24.0",
    "next": "16.2.10",
    "next-auth": "5.0.0-beta.31",
    "next-intl": "^4.13.2",
    "nodemailer": "^9.0.1",
    "pg": "^8.22.0",
    "pg-boss": "^12.26.0",
    "prisma": "^7.7.0",
    "rate-limiter-flexible": "^7.4.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-hook-form": "^7.81.0",
    "recharts": "^2.15.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3",
    "zod-openapi": "^6.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@changesets/cli": "^2.27.0",
    "@cyclonedx/cyclonedx-npm": "^6.0.0",
    "@neondatabase/serverless": "^1.1.0",
    "@next/bundle-analyzer": "^16.2.9",
    "@playwright/test": "^1.61.1",
    "@size-limit/file": "^12.1.0",
    "@tailwindcss/postcss": "^4.3.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.20.1",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9",
    "eslint-config-next": "^16.2.9",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "fast-check": "^4.9.0",
    "global-jsdom": "^25.0.0",
    "husky": "^9.1.7",
    "jscpd": "^5.0.12",
    "jsdom": "^25.0.1",
    "knip": "^6.26.0",
    "playwright-bdd": "^9.2.0",
    "prettier": "3.9.5",
    "size-limit": "^12.1.0",
    "style-dictionary": "^5.5.0",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.23.0",
    "typescript": "^5"
  }
}
