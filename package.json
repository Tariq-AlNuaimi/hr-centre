{
  "name": "hr-centre",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --experimental-test-module-mocks --import tsx --test tests/contracts/*.test.ts tests/property/*.test.ts && npm run test:lint-rules",
    "test:property": "node --import tsx --test tests/property/*.test.ts",
    "tokens:build": "node scripts/build-tokens.mjs",
    "tokens": "npx -y ccusage@20.0.18 session",
    "test:watch": "node --experimental-test-module-mocks --import tsx --test --watch tests/contracts/*.test.ts",
    "test:lint-rules": "node --import tsx --test tests/eslint-rules/*.test.mjs",
    "test:integration": "node scripts/test-integration.mjs",
    "test:hooks": "node --test tests/harness/*.test.mjs",
    "context-tax": "node scripts/context-tax.mjs",
    "memory-digest": "node scripts/memory-digest.mjs --write",
    "fan-out": "node scripts/fan-out.mjs",
    "copy-check": "node scripts/copy-check.mjs",
    "capture": "node scripts/capture-screens.mjs",
    "test:components": "node --experimental-test-module-mocks --import tsx --import global-jsdom/register --import ./tests/components/setup.ts --test tests/components/*.test.tsx",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "prisma:seed": "prisma db seed",
    "db:demo-cycle": "tsx prisma/demo-cycle.ts",
    "prisma:studio": "prisma studio",
    "scaffold": "node scripts/scaffold-entity.mjs",
    "rebrand": "node scripts/rebrand.mjs",
    "migrate-from": "node scripts/migrate-from.mjs",
    "new-project": "node scripts/new-project.mjs",
    "sync-template": "node scripts/sync-from-template.mjs",
    "repo-map": "node scripts/repo-map.mjs",
    "uat": "UAT_MODE=lean playwright test",
    "uat:headed": "UAT_MODE=lean playwright test --headed",
    "uat:report": "playwright show-report uat-report",
    "uat:pdf": "node scripts/uat-pdf.mjs",
    "uat:install": "playwright install chromium",
    "deploy": "node scripts/deploy.mjs",
    "analyze": "ANALYZE=true next build",
    "scan": "npx react-scan@0.5.7 http://localhost:3000",
    "lhci": "npx @lhci/cli@0.15.1 autorun",
    "ship": "node scripts/ship.mjs",
    "ship:full": "SHIP_FULL=1 node scripts/ship.mjs",
    "skill-check": "node scripts/skill-standard-check.mjs",
    "evals": "node scripts/run-evals.mjs",
    "audit:warn": "npm audit --audit-level=moderate || true",
    "test:coverage": "node --experimental-test-coverage --import tsx --test tests/contracts/*.test.ts",
    "prepare": "husky",
    "uat:full": "UAT_MODE=full playwright test",
    "uat:recommend": "node scripts/uat-recommend.mjs",
    "uat:benchmark": "node scripts/uat-benchmark.mjs",
    "provision-logins": "tsx scripts/provision-logins.mjs",
    "demo-cast": "tsx scripts/provision-logins.mjs --demo-cast",
    "hive:providers": "node --conditions=react-server --import tsx scripts/hive-import-providers.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "nodemailer": "^10.0.6",
    "tmp": "^0.2.7",
    "uuid": "^11",
    "postcss": "^8.5.23",
    "@hono/node-server": "^1.19.13",
    "read-yaml-file": "^2.1.0",
    "brace-expansion": "^2.1.7",
    "find-my-way": "^9.7.0",
    "@auth/core": "0.41.3",
    "sharp": "^0.35.4",
    "deepmerge-ts": "^8.0.1",
    "fast-uri": "^3.1.7",
    "mysql2": "^3.24.3",
    "qs": "^6.16.0",
    "@vercel/cli-config": {
      "zod": "^4.6.7"
    }
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@hookform/resolvers": "^5.4.0",
    "@node-rs/argon2": "^2.0.2",
    "@opentelemetry/api": "^1.9.1",
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "@radix-ui/react-avatar": "^1.2.2",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-direction": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-select": "^2.3.3",
    "@sentry/nextjs": "10.76.2",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-table": "^8.21.3",
    "@vercel/blob": "^2.8.2",
    "@vercel/otel": "^2.1.3",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "ioredis": "^5.11.1",
    "lucide-react": "^1.24.0",
    "next": "16.4.2",
    "next-auth": "5.0.0-beta.32",
    "next-intl": "^4.13.2",
    "nodemailer": "^10.0.6",
    "pg": "^8.22.0",
    "prisma": "^7.7.0",
    "rate-limiter-flexible": "^7.4.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-hook-form": "^7.81.0",
    "read-excel-file": "^9.3.10",
    "recharts": "^2.15.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "write-excel-file": "^4.1.1",
    "zod": "^4.4.3",
    "zod-openapi": "^6.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@neondatabase/serverless": "^1.1.0",
    "@next/bundle-analyzer": "^16.3.7",
    "@playwright/test": "^1.61.1",
    "@size-limit/file": "^12.1.0",
    "@tailwindcss/postcss": "^4.3.2",
    "@testcontainers/postgresql": "^12.0.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.20.1",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9",
    "eslint-config-next": "^16.4.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-sonarjs": "^4.2.0",
    "fast-check": "^4.9.0",
    "global-jsdom": "^25.0.0",
    "husky": "^9.1.7",
    "jscpd": "^5.0.16",
    "jsdom": "^25.0.1",
    "knip": "^6.26.0",
    "prettier": "3.9.10",
    "size-limit": "^12.1.0",
    "style-dictionary": "^5.5.0",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.23.0",
    "typescript": "^5"
  }
}
