{
  "name": "fullstack-next-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --experimental-test-module-mocks --import tsx --test tests/contracts/*.test.ts && npm run test:lint-rules",
    "test:watch": "node --experimental-test-module-mocks --import tsx --test --watch tests/contracts/*.test.ts",
    "test:lint-rules": "node --import tsx --test tests/eslint-rules/*.test.mjs",
    "test:integration": "node --import tsx --test tests/integration/*.test.ts",
    "test:components": "node --import tsx --import global-jsdom/register --import ./tests/components/setup.ts --test tests/components/*.test.tsx",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "prisma:seed": "prisma db seed",
    "prisma:studio": "prisma studio",
    "scaffold": "node scripts/scaffold-entity.mjs",
    "rebrand": "node scripts/rebrand.mjs",
    "migrate-from": "node scripts/migrate-from.mjs",
    "new-project": "node scripts/new-project.mjs",
    "uat": "UAT_MODE=lean playwright test",
    "uat:full": "UAT_MODE=full playwright test",
    "uat:headed": "UAT_MODE=lean playwright test --headed",
    "uat:report": "playwright show-report uat-report",
    "uat:pdf": "node scripts/uat-pdf.mjs",
    "uat:recommend": "node scripts/uat-recommend.mjs",
    "uat:benchmark": "node scripts/uat-benchmark.mjs",
    "uat:install": "playwright install chromium",
    "deploy": "node scripts/deploy.mjs",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "analyze": "ANALYZE=true next build"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.1",
    "@ant-design/nextjs-registry": "^1.3.0",
    "@auth/prisma-adapter": "^2.11.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "@sentry/nextjs": "10.53.1",
    "antd": "^6.3.5",
    "bcryptjs": "^3.0.3",
    "exceljs": "^4.4.0",
    "next": "16.2.6",
    "next-auth": "^5.0.0-beta.31",
    "next-intl": "^4.9.0",
    "nodemailer": "^7.0.7",
    "pg": "^8.20.0",
    "prisma": "^7.7.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "recharts": "^2.15.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@next/bundle-analyzer": "^15.5.19",
    "@playwright/test": "^1.60.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.19.19",
    "@types/nodemailer": "^7.0.2",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.3",
    "global-jsdom": "^25.0.0",
    "jsdom": "^25.0.1",
    "tsx": "^4.21.0",
    "typescript": "^5"
  },
  "overrides": {
    "nodemailer": "^7.0.7",
    "tmp": "^0.2.7"
  }
}
