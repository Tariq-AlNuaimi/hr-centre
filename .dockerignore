# Keeps the Docker build context small + secret-free (ADR-023). The builder runs
# `npm ci` and `prisma generate` fresh, so local installs/artifacts are excluded
# and never shadow the clean build.
node_modules
.next
.git
*.md
.env*
!.env.example
docker-compose*.yml
generated
.vercel
uat-results
coverage
.claude/.template-check-stamp
npm-debug.log*
