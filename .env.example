# -- Database --
# Local dev: Postgres via `make db-up`. Production: Neon (see CLAUDE.md).
# For Neon, use the POOLED connection string (ends in -pooler.<region>...).
DATABASE_URL="postgresql://app:app_secret@localhost:5432/app_db?schema=public"
# Optional: a disposable, EMPTY Postgres DB for /ship's migrations-in-sync check
# (ADR-031; `prisma migrate diff` replays migrations into it). When unset, /ship
# degrades that check to a WARN — never point this at a database with data.
# SHADOW_DATABASE_URL="postgresql://app:app_secret@localhost:5432/app_shadow?schema=public"
# Optional: a dedicated READ-ONLY Neon role for `make db-sql` / scripts/neon-sql.mjs
# diagnostics (least-privilege). Falls back to DATABASE_URL with a warning when unset.
# NEON_READONLY_URL="postgresql://readonly:...@...-pooler.<region>.../app_db"

# -- Auth.js --
AUTH_SECRET="generate-with: openssl rand -base64 32"
# AUTH_URL is set automatically by Vercel (NEXTAUTH_URL/AUTH_URL). For local dev:
AUTH_URL="http://localhost:3000"
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""

# -- App --
NODE_ENV="development"
NEXT_PUBLIC_APP_NAME="Rihal Performance Management"

# -- Seeding --
# Used by `prisma db seed` to create the first admin user.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="changeme"

# -- Recycling Bin --
RECYCLE_BIN_RETENTION_DAYS="90"

# -- Audit retention (ADR-018) --
# A daily Vercel Cron (vercel.json) GETs /api/internal/audit-purge. Until
# CRON_SECRET is set in the Vercel project env the cron is a silent no-op
# (200 {skipped:true}); once set, Vercel auto-sends `Authorization: Bearer
# $CRON_SECRET` with each cron request and old rows are purged in batches.
# /deploy provisions CRON_SECRET automatically; manual forks set it here.
# AUDIT_PURGE_TOKEN gates manual / GitHub Actions POSTs to the same endpoint.
# Both are zod-enforced >=32 chars. Generate: openssl rand -base64 48
# CRON_SECRET=
# AUDIT_PURGE_TOKEN=
AUDIT_RETENTION_DAYS="365"

# -- Salary encryption at rest (ADR-067) --
# employees.basic_salary_enc holds AES-256-GCM ciphertext, bound to the row's
# odooId. Without this key the app cannot read OR write compensation — that is
# deliberate: it fails closed rather than silently storing plaintext.
# Restricted (SECURITY.md §1). Never log it, never commit it, never paste it
# into an issue. Exactly 32 bytes, base64:  openssl rand -base64 32
# SALARY_ENCRYPTION_KEY=
# Set only DURING a rotation: the outgoing key, so rows written under it still
# decrypt while the re-encryption pass runs. Clear it once the pass completes.
# SALARY_ENCRYPTION_KEY_PREVIOUS=


# -- SMTP (optional) --
# Email sends go through lib/email.ts (nodemailer). Gated by SMTP_HOST: when
# unset, sendEmail() logs a warning and returns { sent: false } -- the app
# still runs.
# SMTP_HOST=
SMTP_PORT="587"
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM="noreply@yourdomain.com"

# -- Sentry (optional; observability stack per ADR-002) --
# Public-by-design DSN; not classified as Restricted. One Sentry project per env.
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_ENVIRONMENT="development"
# CI-only token for source-map upload. Set as a Vercel "Production" env var.
# SENTRY_AUTH_TOKEN=

# -- OpenTelemetry (optional; self-host observability backbone per ADR-040) --
# Instrument-once / swap-backend: the app exports OTLP and never knows which
# backend consumes it. Set OTEL_EXPORTER_OTLP_ENDPOINT to turn the backbone on
# (instrumentation.ts registers @vercel/otel); UNSET -> silent no-op, zero
# overhead. Point it at the bundled OTel Collector (the swappable-backend seam,
# `--profile observability` in compose.prod.yaml) or directly at a SigNoz/OTLP
# sink. Protocol defaults to http/protobuf; service name identifies this app.
# OTEL_EXPORTER_OTLP_ENDPOINT="http://otel-collector:4318"
# OTEL_EXPORTER_OTLP_PROTOCOL="http/protobuf"
# OTEL_SERVICE_NAME="app"

# -- AI runtime (optional; Claude-native AI layer per ADR-036, WS-5) --
# The lib/ai/* seam is a silent no-op until AI_API_KEY is set: unset -> the layer
# reports not-configured and the client factory throws an actionable error rather
# than 401-ing at call time. Endpoint-agnostic -- the same build targets Anthropic
# or a self-hosted LLM by config alone: leave AI_BASE_URL unset for Anthropic's
# hosted API, or set it to a self-hosted / Anthropic-compat gateway endpoint
# (validated as an absolute http(s) URL). AI_AUTH_STYLE picks how the key is sent:
# "x-api-key" (Anthropic default) or "bearer" (Authorization: Bearer, for a proxy).
# AI_MODEL is the default tier (ADR-022 routing); a per-call override passes through.
# AI_API_KEY=            # Restricted -- never commit a real value
# AI_BASE_URL="https://gateway.internal/anthropic"
# AI_AUTH_STYLE="x-api-key"    # or "bearer"
# AI_MODEL="claude-opus-4-8"
# AI_EVAL_BASE_URL is where `npm run ai-eval` / the /ship AI-eval gate POST each
# tests/ai-evals/*.eval.ts case (-> /api/ai/<kebab>). Default http://localhost:3000;
# set it to a deployed URL to eval prod. Auth-wrapped endpoints: pass a session via
# AI_EVAL_AUTH="Bearer <token>" or AI_EVAL_COOKIE="<name>=<value>" (never logged).
# AI_EVAL_BASE_URL="http://localhost:3000"

# -- AI tracing (optional; ADR-044) -------------------------------------------
# LLM tracing reuses the OTel backbone (ADR-040): set OTEL_EXPORTER_OTLP_ENDPOINT
# (above) to Langfuse's OTLP endpoint + OTEL_EXPORTER_OTLP_HEADERS for its auth,
# and lib/ai spans render as generations -- no Langfuse SDK, no code change.
# Capture prompt/completion TEXT in traces? Restricted/PII -- leave unset in
# production; set to 1 ONLY for a trusted debug session on a private sink.
# AI_TRACE_CONTENT=1

# -- Embeddings / RAG (optional; ADR-043, WS-5) -------------------------------
# Unset => RAG is a silent no-op. EMBEDDINGS_PROVIDER selects the backend;
# EMBEDDINGS_API_KEY turns it on. EMBEDDINGS_DIMENSIONS must match the pgvector
# column (vector(1536)); voyage-3 / embed-english-v3.0 emit 1024 -- ALTER the
# column + set this in lockstep if so.
# EMBEDDINGS_PROVIDER=voyage        # voyage | cohere | none
# EMBEDDINGS_API_KEY=
# EMBEDDINGS_MODEL=                 # default: voyage-3 (voyage) / embed-english-v3.0 (cohere)
# EMBEDDINGS_DIMENSIONS=1536        # must equal the document_embedding vector(N) column
# EMBEDDINGS_BASE_URL=              # override the vendor REST endpoint (self-host / compat gateway)

# -- Background jobs (optional; pg-boss seam, see docs/blueprints/enterprise-queue-seam.md) --
# Durable background jobs on the EXISTING Postgres (pg-boss) -- no Redis, no SaaS
# scheduler. Dormant by design until QUEUE_ENABLED="true" (exactly that string;
# zod rejects other values loud at boot): a DB URL is always present, so the seam
# never starts polling the app database unless the operator explicitly opts in.
# QUEUE_DATABASE_URL points the job tables at a dedicated DB/role (least
# privilege); unset -> falls back to DATABASE_URL. Confidential -- embeds a DB
# credential; never commit a real value. Workers need a long-lived process (the
# Docker self-host rail), not serverless route handlers.
# QUEUE_ENABLED="true"
# QUEUE_DATABASE_URL="postgresql://app:app_secret@localhost:5432/app_db?schema=public"

# -- CSP violation reporting (optional) --
# When set, middleware.ts appends `report-uri <url>` to the Content-Security-Policy
# so blocked resources / XSS attempts are reported. Point it at a Sentry CSP
# endpoint or any collector. Dormant (no report-uri emitted) when unset.
# CSP_REPORT_URI=

# -- Rate limiting: client-IP trust boundary (IMPORTANT) --
# The per-IP limiter AND the audit log's ipAddress both key on the client IP, and
# EVERY forwarding header is client-spoofable unless your proxy overwrites it.
# Name the header your proxy GUARANTEES:
#   "x-real-ip"        -- Vercel, nginx, or the bundled Caddy (the Caddyfile
#                         strips a client-supplied X-Real-IP and re-sets it from
#                         the trusted-proxy-resolved client address)
#   "cf-connecting-ip" -- Cloudflare
# Do NOT name a header your proxy does not overwrite -- that reopens red-team R1
# (rate-limit bypass by header rotation + forged audit attribution).
#
# Leaving it UNSET degrades the two consumers DIFFERENTLY, because their failure
# asymmetries are opposite:
#   - audit_logs.ipAddress records NOTHING. Absent beats forged.
#   - the rate limiter still buckets per claimed value, marked untrusted so it can
#     never collide with a trusted key. Someone rotating the header escapes their
#     own limit -- exactly where they'd be with no limit at all -- but cannot drag
#     other users into their bucket.
# That second line used to read "every request shares one bucket, throttling
# harder". It did throttle harder, and that was the bug: the auth buckets are
# small and process-wide, so eleven login attempts from any stranger locked every
# user out of signing in. GET /api/health reports `warnings: ["ip-trust-
# unconfigured"]` while this is unset, so the weaker throttle is visible.
# RATE_LIMIT_TRUSTED_IP_HEADER="x-real-ip"
#
# Shared-state backend (ADR-035). REQUIRED when running >1 app replica: without
# it the in-memory bucket is per-instance and the real limit becomes N x configured
# (round-robin bypass; SECURITY.md T-01). Set to your Valkey/Redis URL and the
# limiter uses shared state across replicas; unset -> in-memory (single-container).
# VALKEY_URL="redis://valkey:6379"    # or REDIS_URL=
#
# -- Per-account lockout (OWASP A07; SECURITY.md §16 row 4) --
# Brute-force throttle keyed on the EMAIL, not the IP -- the IP bucket above cannot
# stop an attacker rotating IPs against one account. ON BY DEFAULT with the values
# below; it shares the VALKEY_URL backend above when set (so the lock holds across
# replicas) and falls back to in-memory otherwise. Tune only if the defaults are wrong
# for your threat model -- raising MAX_FAILS or lowering LOCK_SEC weakens the control.
# ACCOUNT_LOCKOUT_MAX_FAILS="5"      # bad passwords tolerated inside the window
# ACCOUNT_LOCKOUT_WINDOW_SEC="900"   # rolling window the failures are counted in (15m)
# ACCOUNT_LOCKOUT_LOCK_SEC="900"     # how long the account stays locked once tripped (15m)

# -- Provisioning & test-harness variables (NOT read by the app at runtime) --
# These are consumed by scripts/ (deploy, new-project) and the UAT harness. Set
# them in the Claude Code web environment configuration or your shell -- never
# commit real values. Documented here for discoverability only.
# NEON_API_KEY=            # /deploy + /new-project -- Neon account API key
# VERCEL_TOKEN=            # /deploy + /new-project -- Vercel account token
# NEON_ORG_ID=             # only if the Neon key sees >1 org
# VERCEL_TEAM_ID=          # only for Team-scoped Vercel projects
# CLOUDFLARE_API_TOKEN=    # only for custom domains (--apex), scope Zone.DNS:Edit
# GH_AUTOMATION_TOKEN=     # only for /new-project (creates the repo), scopes repo+workflow
# UAT_BASE_URL=            # npm run uat against a deployed URL (default: local dev)
# UAT_MODE=                # uat harness mode override (lean|full)
