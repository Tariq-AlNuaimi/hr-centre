# -- Database --
DATABASE_URL="postgresql://app:app_secret@localhost:5432/app_db?schema=public"

# -- MinIO (S3-compatible storage) --
MINIO_ENDPOINT="http://localhost:9000"
MINIO_ACCESS_KEY="app_minio"
MINIO_SECRET_KEY="app_minio_secret"
MINIO_BUCKET="uploads"

# -- Auth.js --
AUTH_SECRET="generate-with: openssl rand -base64 32"
AUTH_URL="http://localhost:3000"
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""

# -- App --
NODE_ENV="development"
NEXT_PUBLIC_APP_NAME="My App"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# -- Seeding --
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="changeme"

# -- Recycling Bin --
RECYCLE_BIN_RETENTION_DAYS="90"

# -- Audit retention --
# Set AUDIT_PURGE_TOKEN to a 32+ char random value to enable the
# /api/internal/audit-purge endpoint. The scheduled GHA workflow uses it.
# Generate: openssl rand -base64 48
# AUDIT_PURGE_TOKEN=
AUDIT_RETENTION_DAYS="365"

# -- SMTP (optional) --
# Email sends go through lib/email.ts (nodemailer). Gated by SMTP_HOST: when
# unset, sendEmail() logs a warning and returns { sent: false } -- the app
# still runs. Configure during /first-fork step 9 to enable transactional mail
# (password reset, invites, notifications, etc.).
# SMTP_HOST=
SMTP_PORT="587"
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM="noreply@yourdomain.com"

# -- Sentry (optional; observability stack per ADR-002) --
# SENTRY_DSN: server-side DSN. Sentry calls it public-by-design so it's
# documented in SECURITY.md §6 but NOT classified as Restricted. Operator
# creates one Sentry project per environment (staging/prod) and pastes the
# DSN here / into the Portainer stack env. When unset, Sentry init is a no-op.
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN: client-side DSN. Same value as SENTRY_DSN typically.
# Ships in the JS bundle by design (public).
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_ENVIRONMENT: free-form environment tag (staging | production | ...).
# Defaults to "development" locally. Set by docker-compose.prod.yml in deploy.
# SENTRY_ENVIRONMENT="development"
# SENTRY_AUTH_TOKEN: CI-only. Used by docker-build.yml to upload source-maps
# to Sentry on each main-branch build. Restricted (see SECURITY.md §6). Local
# builds work without it -- the upload step is skipped.
# SENTRY_AUTH_TOKEN=

# -- Better Uptime / Better Stack (optional; deploy-time uptime monitoring) --
# BETTER_UPTIME_API_KEY: Operator-side. When set, /deploy registers an uptime
# monitor against the new environment's /api/health after the first health
# check passes; --destroy removes it. Restricted (see SECURITY.md §6).
# Read by scripts/deploy.mjs, NOT by the app at runtime -- not in lib/env.ts.
# BETTER_UPTIME_API_KEY=
